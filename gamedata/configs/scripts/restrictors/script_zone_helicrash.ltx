[logic]
active = sr_particle@1

[sr_particle@1]
name = explosions\effects\expl_car_smoke_big_smoke
path = helicrash_smoke_point
mode = 2
looped = false
on_info = {+stranger_talk2} sr_idle@0
on_info2 = {+mg_zone_helicrash =is_render_r1or2} sr_idle@mg1 %=add_self_spot(mg_deathzone_mark9a:mg_deathzone_mark1_text) =mg_zone_helicrash_think%
on_info3 = {+mg_zone_helicrash =is_render_r3or4} sr_idle@mg1 %=add_self_spot(mg_deathzone_mark9b:mg_deathzone_mark1_text) =mg_zone_helicrash_think%



[sr_idle@0]
on_info = {+random_event_helicrash} sr_idle@1
on_info2 = {+mg_zone_helicrash} sr_idle@mg1 %=add_self_spot(mg_deathzone_mark9:mg_deathzone_mark1_text) =mg_zone_graveyard_think%

[sr_idle@1]
on_game_timer = 19|{~25} sr_idle@1_1 %=give_task(rnd_task_helicrash_maroders) =helicrash_maroders_spawn =helicrash_random_items_in_box_spawn =mark_helicrash_maroders_box1%, {~45} sr_idle@1_2 %=give_task(rnd_task_helicrash_mutants) =spawn_helicrash_mobs%, {~60} sr_idle@1_3 %=give_task(rnd_task_helicrash_artefact) =helicrash_artefact_spawn =helicrash_maroders_spawn%, {~80} sr_idle@1_4 %=give_task(rnd_task_helicrash_robbery) =helicrash_maroders_spawn =spawn_object_in(rnd_task_helicrash_item:helicrash_box) =helicrash_weapon_parts_in_box_spawn =mark_helicrash_maroders_box1%


; Уничтожить мародёров:
[sr_idle@1_1]
on_info = {=counter_greater(mr_hl:7)} sr_idle@1_1_1 %=start_rnd_task_default_reward%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_helicrash_maroders =clear_box(helicrash_box) =unmark_helicrash_maroders_box1 =set_counter(mr_hl:0)%

[sr_idle@1_1_1]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_helicrash_maroders =clear_box(helicrash_box) -random_event_helicrash =unmark_helicrash_maroders_box1 -helicrash_marod_hit%


; Уничтожить мутантов:
[sr_idle@1_2]
on_info = {=counter_greater(mb_hl:6)} sr_idle@1_1_2 %=start_rnd_task_default_reward%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_helicrash_mobs =set_counter(mb_hl:0)%

[sr_idle@1_1_2]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_helicrash_mobs -random_event_helicrash%


; Найти артефакт:
[sr_idle@1_3]
on_info = {=actor_has_item(helicrash_rnd_artefact)} sr_idle@1_1_3 %+helicrash_rnd_artefact_gathered%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_helicrash_artefact =delete_helicrash_anomalys =delete_helicrash_maroders =set_counter(mr_hl:0)%

[sr_idle@1_1_3]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_helicrash_anomalys =delete_helicrash_maroders -helicrash_marod_hit%


; Выкрасть ценный груз:
[sr_idle@1_4]
on_info = {=actor_has_item(rnd_task_helicrash_item)} sr_idle@1_1_4 %+helicrash_rnd_item_gathered%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_helicrash_maroders =clear_box(helicrash_box) =unmark_helicrash_maroders_box1 =set_counter(mr_hl:0)%

[sr_idle@1_1_4]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_helicrash_maroders =unmark_helicrash_maroders_box1 -helicrash_marod_hit%



; Вспомогательная секция ожидания:
[sr_idle@wait]
on_info = {-random_event_helicrash} sr_idle@0 %=set_counter(mr_hl:0) =set_counter(mb_hl:0)%




; Для режима Мастер:
[sr_idle@mg1]
on_info = {-mg_zone_helicrash =is_render_r1or2} sr_particle@1 %=remowe_self_spot(mg_deathzone_mark9a:mg_deathzone_mark1_text)%
on_info2 = {-mg_zone_helicrash =is_render_r3or4} sr_particle@1 %=remowe_self_spot(mg_deathzone_mark9b:mg_deathzone_mark1_text)%
