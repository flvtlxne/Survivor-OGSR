[logic]
active = sr_idle@0

[sr_idle@0]
on_info = {+random_event_island} sr_idle@1
on_info2 = {+mg_zone_island =is_render_r1or2} sr_idle@mg1 %=add_self_spot(mg_deathzone_mark9a:mg_deathzone_mark1_text) =mg_zone_island_think%
on_info3 = {+mg_zone_island =is_render_r3or4} sr_idle@mg1 %=add_self_spot(mg_deathzone_mark9b:mg_deathzone_mark1_text) =mg_zone_island_think%

[sr_idle@1]
on_game_timer = 13|{~25} sr_idle@1_1 %=give_task(rnd_task_island_maroders) =island_maroders_spawn_on_base =island_random_items_in_box_spawn =mark_island_maroders_box1 =mark_island_maroders_box2%, {~45} sr_idle@1_2 %=give_task(rnd_task_island_mutants) =island_mutants_spawn_on_base%, {~60} sr_idle@1_3 %=give_task(rnd_task_island_artefact) =island_artefact_spawn =island_maroders_spawn%, {~80} sr_idle@1_4 %=give_task(rnd_task_island_robbery) =island_maroders_spawn_on_base =spawn_object_in(rnd_task_island_item:island_invbox_1) =island_weapon_parts_in_box_spawn =mark_island_maroders_box1 =mark_island_maroders_box2%



; Уничтожить мародёров:
[sr_idle@1_1]
;on_info = {=is_dead(island_marouder_guard1) =story_object_exist(island_marouder_guard1) =is_dead(island_marouder_guard2) =story_object_exist(island_marouder_guard2) =is_dead(island_marouder_guard3) =story_object_exist(island_marouder_guard3) =is_dead(island_marouder_guard4) =story_object_exist(island_marouder_guard4) =is_dead(island_marouder_guard5) =story_object_exist(island_marouder_guard5) =is_dead(island_marouder_guard6) =story_object_exist(island_marouder_guard6) =is_dead(island_marouder_guard7) =story_object_exist(island_marouder_guard7) =is_dead(island_marouder_comandr) =story_object_exist(island_marouder_comandr) =is_dead(island_marouder_scav) =story_object_exist(island_marouder_scav)} sr_idle@1_1_1 %=start_rnd_task_default_reward%
on_info = {=counter_greater(mr_is:8)} sr_idle@1_1_1 %=start_rnd_task_default_reward%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_island_maroders =clear_box(island_invbox_1) =clear_box(island_invbox_2) =unmark_island_maroders_box1 =unmark_island_maroders_box2 =set_counter(mr_is:0)%

[sr_idle@1_1_1]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_island_maroders =clear_box(island_invbox_1) =clear_box(island_invbox_2) -random_event_island =unmark_island_maroders_box1 =unmark_island_maroders_box2 -island_marod_hit%


; Уничтожить мутантов:
[sr_idle@1_2]
;on_info = {=is_dead(island_mob_1) =story_object_exist(island_mob_1) =is_dead(island_mob_2) =story_object_exist(island_mob_2) =is_dead(island_mob_3) =story_object_exist(island_mob_3) =is_dead(island_mob_4) =story_object_exist(island_mob_4) =is_dead(island_mob_5) =story_object_exist(island_mob_5) =is_dead(island_mob_6) =story_object_exist(island_mob_6) =is_dead(island_mob_7) =story_object_exist(island_mob_7)} sr_idle@1_1_2 %=start_rnd_task_default_reward%
on_info = {=counter_greater(mb_is:6)} sr_idle@1_1_2 %=start_rnd_task_default_reward%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_island_mobs =set_counter(mb_is:0)%

[sr_idle@1_1_2]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_island_mobs -random_event_island%


; Найти артефакт:
[sr_idle@1_3]
on_info = {=actor_has_item(island_rnd_artefact)} sr_idle@1_1_3 %+island_rnd_artefact_gathered%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_island_artefact =delete_island_anomalys =delete_island_maroders =set_counter(mr_is:0)%

[sr_idle@1_1_3]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_island_anomalys =delete_island_maroders -island_marod_hit%


; Выкрасть ценный груз:
[sr_idle@1_4]
on_info = {=actor_has_item(rnd_task_island_item)} sr_idle@1_1_4 %+island_rnd_item_gathered%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_island_maroders =clear_box(island_invbox_1) =clear_box(island_invbox_2) =unmark_island_maroders_box1 =unmark_island_maroders_box2 =set_counter(mr_is:0)%

[sr_idle@1_1_4]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_island_maroders =unmark_island_maroders_box1 =unmark_island_maroders_box2 -island_marod_hit%



; Вспомогательная секция ожидания:
[sr_idle@wait]
on_info = {-random_event_island} sr_idle@0 %=set_counter(mr_is:0) =set_counter(mb_is:0)%



; Для режима Мастер:
[sr_idle@mg1]
on_info = {-mg_zone_island =is_render_r1or2} sr_idle@0 %=remowe_self_spot(mg_deathzone_mark9a:mg_deathzone_mark1_text)%
on_info2 = {-mg_zone_island =is_render_r3or4} sr_idle@0 %=remowe_self_spot(mg_deathzone_mark9b:mg_deathzone_mark1_text)%



