[logic]
active = sr_idle@0

[sr_idle@0]
on_info = {+random_event_razlom} sr_idle@1
on_info2 = {+mg_zone_razlom =is_render_r1or2} sr_idle@mg1 %=add_self_spot(mg_deathzone_mark9a:mg_deathzone_mark1_text) =mg_zone_razlom_think%
on_info3 = {+mg_zone_razlom =is_render_r3or4} sr_idle@mg1 %=add_self_spot(mg_deathzone_mark9b:mg_deathzone_mark1_text) =mg_zone_razlom_think%

[sr_idle@1]
on_game_timer = 11|{~25} sr_idle@1_1 %=give_task(rnd_task_razlom_maroders) =razlom_maroders_spawn_on_base =razlom_random_items_in_box_spawn =mark_razlom_maroders_box1%, {~45} sr_idle@1_2 %=give_task(rnd_task_razlom_mutants) =razlom_mutants_spawn_on_base%, {~60} sr_idle@1_3 %=give_task(rnd_task_razlom_artefact) =razlom_artefact_spawn =razlom_maroders_spawn%, {~80} sr_idle@1_4 %=give_task(rnd_task_razlom_robbery) =razlom_maroders_spawn_on_base =spawn_object_in(rnd_task_razlom_item:razlom_invbox_1) =razlom_weapon_parts_in_box_spawn =mark_razlom_maroders_box1%



; Уничтожить мародёров:
[sr_idle@1_1]
;on_info = {=is_dead(razlom_marouder_guard1) =story_object_exist(razlom_marouder_guard1) =is_dead(razlom_marouder_guard2) =story_object_exist(razlom_marouder_guard2) =is_dead(razlom_marouder_guard3) =story_object_exist(razlom_marouder_guard3) =is_dead(razlom_marouder_guard4) =story_object_exist(razlom_marouder_guard4) =is_dead(razlom_marouder_guard5) =story_object_exist(razlom_marouder_guard5) =is_dead(razlom_marouder_comandr) =story_object_exist(razlom_marouder_comandr) =is_dead(razlom_marouder_scav) =story_object_exist(razlom_marouder_scav)} sr_idle@1_1_1 %=start_rnd_task_default_reward%
on_info = {=counter_greater(mr_rz:6)} sr_idle@1_1_1 %=start_rnd_task_default_reward%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_razlom_maroders =clear_box(razlom_invbox_1) =unmark_razlom_maroders_box1 =set_counter(mr_rz:0)%

[sr_idle@1_1_1]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_razlom_maroders =clear_box(razlom_invbox_1) -random_event_razlom =unmark_razlom_maroders_box1 -razlom_marod_hit%


; Уничтожить мутантов:
[sr_idle@1_2]
;on_info = {=is_dead(razlom_mob_1) =story_object_exist(razlom_mob_1) =is_dead(razlom_mob_2) =story_object_exist(razlom_mob_2) =is_dead(razlom_mob_3) =story_object_exist(razlom_mob_3) =is_dead(razlom_mob_4) =story_object_exist(razlom_mob_4)} sr_idle@1_1_2 %=start_rnd_task_default_reward%
on_info = {=counter_greater(mb_rz:3)} sr_idle@1_1_2 %=start_rnd_task_default_reward%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_razlom_mobs =set_counter(mb_rz:0)%

[sr_idle@1_1_2]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_razlom_mobs -random_event_razlom%


; Найти артефакт:
[sr_idle@1_3]
on_info = {=actor_has_item(razlom_rnd_artefact)} sr_idle@1_1_3 %+razlom_rnd_artefact_gathered%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_razlom_artefact =delete_razlom_maroders =set_counter(mr_rz:0)%

[sr_idle@1_1_3]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_razlom_maroders -razlom_marod_hit%


; Выкрасть ценный груз:
[sr_idle@1_4]
on_info = {=actor_has_item(rnd_task_razlom_item)} sr_idle@1_1_4 %+razlom_rnd_item_gathered%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_razlom_maroders =clear_box(razlom_invbox_1) =unmark_razlom_maroders_box1 =set_counter(mr_rz:0)%

[sr_idle@1_1_4]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_razlom_maroders =unmark_razlom_maroders_box1 -razlom_marod_hit%



; Вспомогательная секция ожидания:
[sr_idle@wait]
on_info = {-random_event_razlom} sr_idle@0 %=set_counter(mr_rz:0) =set_counter(mb_rz:0)%



; Для режима Мастер:
[sr_idle@mg1]
on_info = {-mg_zone_razlom =is_render_r1or2} sr_idle@0 %=remowe_self_spot(mg_deathzone_mark9a:mg_deathzone_mark1_text)%
on_info2 = {-mg_zone_razlom =is_render_r3or4} sr_idle@0 %=remowe_self_spot(mg_deathzone_mark9b:mg_deathzone_mark1_text)%


