[logic]
active = sr_idle@1

[sr_idle@1]
on_info = {=master_difficulty} sr_idle@nil
on_actor_inside = {+kill_himera_task} sr_idle@2 %=spawn_maroder_chimera%

[sr_idle@2]
on_info = {+maroder_chimera_dead} sr_idle@3

[sr_idle@3]
on_info = {=maroder_chimera_near} sr_idle@4 %=disable_ui =run_postprocess(fade_in_out)%

[sr_idle@4]
on_timer = 1000 | sr_idle@nil %=delete_maroder_chimera =spawn_corpse(maroder_chimera2:maroder_chimera_pnt3) =maroder_chimera_think +maroder_chimera_search =enable_ui%

[sr_idle@nil]