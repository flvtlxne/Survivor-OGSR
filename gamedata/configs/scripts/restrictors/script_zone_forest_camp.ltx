[logic]
active = sr_idle@0

[sr_idle@0]
on_info = {+random_event_forest_camp +stranger_talk3} sr_idle@1
on_info2 = {+mg_zone_forest_camp =is_render_r1or2} sr_idle@mg1 %=add_self_spot(mg_deathzone_mark9a:mg_deathzone_mark1_text) =mg_zone_forest_camp_think%
on_info3 = {+mg_zone_forest_camp =is_render_r3or4} sr_idle@mg1 %=add_self_spot(mg_deathzone_mark9b:mg_deathzone_mark1_text) =mg_zone_forest_camp_think%

[sr_idle@1]
on_game_timer = 7|{~25} sr_idle@1_1 %=give_task(rnd_task_forest_camp_maroders) =forest_camp_maroders_spawn_on_base =forest_camp_random_items_in_box_spawn =mark_forest_camp_maroders_box1%, {~45} sr_idle@1_2 %=give_task(rnd_task_forest_camp_mutants) =spawn_forest_camp_mutants_on_base%, {~60} sr_idle@1_3 %=give_task(rnd_task_forest_camp_artefact) =forest_camp_artefact_spawn =forest_camp_maroders_spawn%, {~80} sr_idle@1_4 %=give_task(rnd_task_forest_camp_robbery) =forest_camp_maroders_spawn_on_base =spawn_object_in(rnd_task_forest_camp_item:forest_camp_invbox2) =forest_camp_weapon_parts_in_box_spawn =mark_forest_camp_maroders_box1%



; Уничтожить мародёров:
[sr_idle@1_1]
;on_info = {=is_dead(forest_camp_marouder_guard1) =story_object_exist(forest_camp_marouder_guard1) =is_dead(forest_camp_marouder_guard2) =story_object_exist(forest_camp_marouder_guard2) =is_dead(forest_camp_marouder_guard3) =story_object_exist(forest_camp_marouder_guard3) =is_dead(forest_camp_marouder_guard4) =story_object_exist(forest_camp_marouder_guard4) =story_object_exist(forest_camp_marouder_guard5) =is_dead(forest_camp_marouder_guard5) =is_dead(forest_camp_marouder_comandr) =story_object_exist(forest_camp_marouder_comandr) =is_dead(forest_camp_marouder_scav) =story_object_exist(forest_camp_marouder_scav)} sr_idle@1_1_1 %=start_rnd_task_default_reward%
on_info = {=counter_greater(mr_fc:6)} sr_idle@1_1_1 %=start_rnd_task_default_reward%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_forest_camp_maroders =clear_box(forest_camp_invbox1) =clear_box(forest_camp_invbox2) =unmark_forest_camp_maroders_box1 =unmark_forest_camp_maroders_box2 =set_counter(mr_fc:0)%

[sr_idle@1_1_1]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_forest_camp_maroders =clear_box(forest_camp_invbox1) =clear_box(forest_camp_invbox2) -random_event_forest_camp =unmark_forest_camp_maroders_box1 =unmark_forest_camp_maroders_box2 -forest_camp_marod_hit%


; Уничтожить мутантов:
[sr_idle@1_2]
;on_info = {=is_dead(forest_camp_mob1) =story_object_exist(forest_camp_mob1) =is_dead(forest_camp_mob2) =story_object_exist(forest_camp_mob2) =is_dead(forest_camp_mob3) =story_object_exist(forest_camp_mob3) =is_dead(forest_camp_mob4) =story_object_exist(forest_camp_mob4) =is_dead(forest_camp_mob5) =story_object_exist(forest_camp_mob5) =is_dead(forest_camp_mob6) =story_object_exist(forest_camp_mob6)} sr_idle@1_1_2 %=start_rnd_task_default_reward%
on_info = {=counter_greater(mb_fc:5)} sr_idle@1_1_2 %=start_rnd_task_default_reward%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_forest_camp_mobs =set_counter(mb_fc:0)%

[sr_idle@1_1_2]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_forest_camp_mobs -random_event_forest_camp%


; Найти артефакт:
[sr_idle@1_3]
on_info = {=actor_has_item(forest_camp_rnd_artefact)} sr_idle@1_1_3 %+forest_camp_rnd_artefact_gathered%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_forest_camp_artefact =delete_forest_camp_anomalys =delete_forest_camp_maroders =set_counter(mr_fc:0)%

[sr_idle@1_1_3]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_forest_camp_anomalys =delete_forest_camp_maroders -forest_camp_marod_hit%


; Выкрасть ценный груз:
[sr_idle@1_4]
on_info = {=actor_has_item(rnd_task_forest_camp_item)} sr_idle@1_1_4 %+forest_camp_rnd_item_gathered%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_forest_camp_maroders =clear_box(forest_camp_invbox1) =clear_box(forest_camp_invbox2) =unmark_forest_camp_maroders_box1 =unmark_forest_camp_maroders_box2 =set_counter(mr_fc:0)%

[sr_idle@1_1_4]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_forest_camp_maroders =unmark_forest_camp_maroders_box1 =unmark_forest_camp_maroders_box2 -forest_camp_marod_hit%



; Вспомогательная секция ожидания:
[sr_idle@wait]
on_info = {-random_event_forest_camp} sr_idle@0 %=set_counter(mr_fc:0) =set_counter(mb_fc:0)%



; Для режима Мастер:
[sr_idle@mg1]
on_info = {-mg_zone_forest_camp =is_render_r1or2} sr_idle@0 %=remowe_self_spot(mg_deathzone_mark9a:mg_deathzone_mark1_text)%
on_info2 = {-mg_zone_forest_camp =is_render_r3or4} sr_idle@0 %=remowe_self_spot(mg_deathzone_mark9b:mg_deathzone_mark1_text)%


