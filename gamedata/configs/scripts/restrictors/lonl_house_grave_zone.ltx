[logic]
active = sr_idle@1


; Обрабатываем квест на поиск убийцы:

[sr_idle@1]
on_info = {=master_difficulty} sr_idle@nil
on_info2 = {+stranger_secret_task1_info} sr_idle@2 %=give_task(addtask_murder)%

[sr_idle@2]
on_actor_inside = {=actor_has_item(showel)} sr_idle@3 %=disable_ui =run_postprocess(fade_in_out)%

[sr_idle@3]
on_timer = 1000 | sr_idle@4 %=spawn_lonl_house_grave_cross =delete_lonl_house_scelet1 +lonl_house_grave_dig =lonl_house_grave_think =actor_grave_replic =enable_ui%

[sr_idle@4]
on_info = {+deadman_diary_info2} sr_idle@5 %=spawn_village_house_polter%

[sr_idle@5]
on_info = {+deadman_diary_info3} sr_idle@6

[sr_idle@6]
on_info = {+lonl_house_pogreb_scelet_off} sr_idle@7 %=disable_ui =run_postprocess(fade_in_out)%

[sr_idle@7]
on_timer = 1000 | sr_idle@nil %=spawn_lonl_house_grave_cross2 =delete_lonl_house_scelet2 +lonl_house_grave2_dig =actor_grave_replic =enable_ui%

[sr_idle@nil]
