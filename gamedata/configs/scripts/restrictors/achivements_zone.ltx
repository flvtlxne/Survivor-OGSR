on_info7 = {=counter_greater(low_health:9) -achivement_6_info} sr_idle@7
on_info8 = {=counter_greater(alco:4) -achivement_7_info} sr_idle@8
on_info9 = {=counter_greater(knife:0) -achivement_8_info} sr_idle@9


[sr_idle@2]
on_timer = 1|sr_idle@1 %=give_achivement1 +achivement_1_info%

[sr_idle@3]
on_timer = 1|sr_idle@1 %=give_achivement2 +achivement_2_info%

[sr_idle@4]
on_timer = 1|sr_idle@1 %=give_achivement3 +achivement_3_info%

[sr_idle@5]
on_timer = 1|sr_idle@1 %=give_achivement4 +achivement_4_info%

[sr_idle@6]
on_timer = 1|sr_idle@1 %=give_achivement5 +achivement_5_info%

[sr_idle@7]
on_timer = 1|sr_idle@1 %=give_achivement6 +achivement_6_info%

[sr_idle@8]
on_timer = 15|sr_idle@1 %=give_achivement7 +achivement_7_info%

[sr_idle@9]
on_timer = 15|sr_idle@1 %=give_achivement8 +achivement_8_info%



[sr_idle@nil]








