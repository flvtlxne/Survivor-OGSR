[logic]
active = sr_idle@1

[sr_idle@1]
on_info = {=master_difficulty} sr_idle@nil
on_info2 = {=counter_greater(treasure:19) -achivement_1_info} sr_idle@2
on_info3 = {=counter_greater(kill_maroder:49) -achivement_2_info} sr_idle@3
on_info4 = {=counter_greater(kill_mutant:49) -achivement_3_info} sr_idle@4
on_info5 = {+actor_has_aksu +actor_has_ak74 +actor_has_toz +actor_has_lr300 +actor_has_vss +actor_has_usp +actor_has_hpsa +actor_has_bizon +actor_has_sayga +actor_has_mosin -achivement_4_info} sr_idle@5
