[logic]
active = sr_idle@1

[sr_idle@1]
;on_info = {=master_difficulty} sr_idle@nil
on_info = {=master_difficulty} sr_idle@3
on_info2 = {+stranger_talk1} sr_idle@3 %=restore_weapon +bolt_finded%
on_info3 = {-stranger_talk1} %=hide_weapon%

[sr_idle@2]
on_info = {+bolt_finded} %=restore_weapon%
on_game_timer = 10|sr_idle@3

[sr_idle@nil]


