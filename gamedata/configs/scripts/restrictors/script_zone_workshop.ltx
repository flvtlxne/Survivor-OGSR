[logic]
active = sr_idle@0

[sr_idle@0]
on_info = {+random_event_workshop} sr_idle@1
on_info2 = {+mg_zone_workshop =is_render_r1or2} sr_idle@mg1 %=add_self_spot(mg_deathzone_mark9a:mg_deathzone_mark1_text) =mg_zone_workshop_think%
on_info3 = {+mg_zone_workshop =is_render_r3or4} sr_idle@mg1 %=add_self_spot(mg_deathzone_mark9b:mg_deathzone_mark1_text) =mg_zone_workshop_think%

[sr_idle@1]
on_game_timer = 1|{~25} sr_idle@1_1 %=give_task(rnd_task_workshop_maroders) =workshop_maroders_spawn_on_base =workshop_random_items_in_box_spawn =mark_workshop_maroders_box1 =mark_workshop_maroders_box2%, {~45} sr_idle@1_2 %=give_task(rnd_task_workshop_mutants) =workshop_mutants_spawn_on_base%, {~60} sr_idle@1_3 %=give_task(rnd_task_workshop_artefact) =workshop_artefact_spawn =workshop_maroders_spawn%, {~80} sr_idle@1_4 %=give_task(rnd_task_workshop_robbery) =workshop_maroders_spawn_on_base =spawn_object_in(rnd_task_workshop_item:kolhoz_invbox_1) =workshop_weapon_parts_in_box_spawn =mark_workshop_maroders_box1 =mark_workshop_maroders_box2%



; Уничтожить мародёров:
[sr_idle@1_1]
;on_info = {=is_dead(workshop_marouder_guard1) =story_object_exist(workshop_marouder_guard1) =is_dead(workshop_marouder_guard2) =story_object_exist(workshop_marouder_guard2) =is_dead(workshop_marouder_guard3) =story_object_exist(workshop_marouder_guard3) =is_dead(workshop_marouder_guard4) =story_object_exist(workshop_marouder_guard4) =is_dead(workshop_marouder_guard5) =story_object_exist(workshop_marouder_guard5) =is_dead(workshop_marouder_guard6) =story_object_exist(workshop_marouder_guard6) =is_dead(workshop_marouder_guard7) =story_object_exist(workshop_marouder_guard7) =is_dead(workshop_marouder_guard8) =story_object_exist(workshop_marouder_guard8) =is_dead(workshop_marouder_comandr) =story_object_exist(workshop_marouder_comandr) =is_dead(workshop_marouder_scav) =story_object_exist(workshop_marouder_scav)} sr_idle@1_1_1 %=start_rnd_task_default_reward%
on_info = {=counter_greater(mr_wr:9)} sr_idle@1_1_1 %=start_rnd_task_default_reward%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_workshop_maroders =clear_box(kolhoz_invbox_1) =clear_box(kolhoz_invbox_2) =unmark_workshop_maroders_box1 =unmark_workshop_maroders_box2 =set_counter(mr_wr:0)%

[sr_idle@1_1_1]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_workshop_maroders =clear_box(kolhoz_invbox_1) =clear_box(kolhoz_invbox_2) -random_event_workshop =unmark_workshop_maroders_box1 =unmark_workshop_maroders_box2 -kolhoz_marod_hit%


; Уничтожить мутантов:
[sr_idle@1_2]
;on_info = {=is_dead(workshop_mob_1) =story_object_exist(workshop_mob_1) =is_dead(workshop_mob_2) =story_object_exist(workshop_mob_2) =is_dead(workshop_mob_3) =story_object_exist(workshop_mob_3) =is_dead(workshop_mob_4) =story_object_exist(workshop_mob_4) =is_dead(workshop_mob_5) =story_object_exist(workshop_mob_5) =is_dead(workshop_mob_6) =story_object_exist(workshop_mob_6) =is_dead(workshop_mob_7) =story_object_exist(workshop_mob_7) =is_dead(workshop_mob_8) =story_object_exist(workshop_mob_8) =is_dead(workshop_mob_9) =story_object_exist(workshop_mob_9) +workshop_mob_10_dead} sr_idle@1_1_2 %=start_rnd_task_default_reward%
on_info = {=counter_greater(mb_wr:9)} sr_idle@1_1_2 %=start_rnd_task_default_reward%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_workshop_mutants =set_counter(mb_wr:0)%

[sr_idle@1_1_2]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_workshop_mutants -random_event_workshop%


; Найти артефакт:
[sr_idle@1_3]
on_info = {=actor_has_item(workshop_rnd_artefact)} sr_idle@1_1_3 %+workshop_rnd_artefact_gathered%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_workshop_artefact =delete_workshop_anomalys =delete_workshop_maroders =set_counter(mr_wr:0)%

[sr_idle@1_1_3]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_workshop_anomalys =delete_workshop_maroders -kolhoz_marod_hit%


; Выкрасть ценный груз:
[sr_idle@1_4]
on_info = {=actor_has_item(rnd_task_workshop_item)} sr_idle@1_1_4 %+workshop_rnd_item_gathered%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_workshop_maroders =clear_box(kolhoz_invbox_1) =clear_box(kolhoz_invbox_2) =unmark_workshop_maroders_box1 =unmark_workshop_maroders_box2 =set_counter(mr_wr:0)%

[sr_idle@1_1_4]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_workshop_maroders =unmark_workshop_maroders_box1 =unmark_workshop_maroders_box2 -kolhoz_marod_hit%



; Вспомогательная секция ожидания:
[sr_idle@wait]
on_info = {-random_event_workshop} sr_idle@0 %=set_counter(mr_wr:0) =set_counter(mb_wr:0)%



; Для режима Мастер:
[sr_idle@mg1]
on_info = {-mg_zone_workshop =is_render_r1or2} sr_idle@0 %=remowe_self_spot(mg_deathzone_mark9a:mg_deathzone_mark1_text)%
on_info2 = {-mg_zone_workshop =is_render_r3or4} sr_idle@0 %=remowe_self_spot(mg_deathzone_mark9b:mg_deathzone_mark1_text)%


