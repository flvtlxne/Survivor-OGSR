[logic]
active = sr_idle@0

[sr_idle@0]
on_info = {+random_event_forest} sr_idle@1
on_info2 = {+mg_zone_forest =is_render_r1or2} sr_idle@mg1 %=add_self_spot(mg_deathzone_mark9a:mg_deathzone_mark1_text) =mg_zone_forest_think%
on_info3 = {+mg_zone_forest =is_render_r3or4} sr_idle@mg1 %=add_self_spot(mg_deathzone_mark9b:mg_deathzone_mark1_text) =mg_zone_forest_think%

[sr_idle@1]
on_game_timer = 5|{~25} sr_idle@1_1 %=give_task(rnd_task_forest_maroders) =forest_maroders_spawn_on_base =forest_random_items_in_box_spawn =mark_forest_maroders_box1%, {~45} sr_idle@1_2 %=give_task(rnd_task_forest_mutants) =forest_mutants_spawn_on_base%, {~60} sr_idle@1_3 %=give_task(rnd_task_forest_artefact) =forest_artefact_spawn =forest_maroders_spawn%, {~80} sr_idle@1_4 %=give_task(rnd_task_forest_robbery) =forest_maroders_spawn_on_base =spawn_object_in(rnd_task_forest_item:forest_invbox_1) =forest_weapon_parts_in_box_spawn =mark_forest_maroders_box1%



; Уничтожить мародёров:
[sr_idle@1_1]
;on_info = {=is_dead(forest_marouder_guard1) =story_object_exist(forest_marouder_guard1) =is_dead(forest_marouder_guard2) =story_object_exist(forest_marouder_guard2) =is_dead(forest_marouder_guard3) =story_object_exist(forest_marouder_guard3) =is_dead(forest_marouder_guard4) =story_object_exist(forest_marouder_guard4) =is_dead(forest_marouder_guard5) =story_object_exist(forest_marouder_guard5) =is_dead(forest_marouder_guard6) =story_object_exist(forest_marouder_guard6) =is_dead(forest_marouder_comandr) =story_object_exist(forest_marouder_comandr) =is_dead(forest_marouder_scav) =story_object_exist(forest_marouder_scav)} sr_idle@1_1_1 %=start_rnd_task_default_reward%
on_info = {=counter_greater(mr_fr:7)} sr_idle@1_1_1 %=start_rnd_task_default_reward%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_forest_maroders =clear_box(forest_invbox_1) =unmark_forest_maroders_box1 =set_counter(mr_fr:0)%

[sr_idle@1_1_1]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_forest_maroders =clear_box(forest_invbox_1) -random_event_forest =unmark_forest_maroders_box1 -forest_marod_hit%


; Уничтожить мутантов:
[sr_idle@1_2]
;on_info = {=is_dead(forest_mob_1) =story_object_exist(forest_mob_1) =is_dead(forest_mob_2) =story_object_exist(forest_mob_2) =is_dead(forest_mob_3) =story_object_exist(forest_mob_3)} sr_idle@1_1_2 %=start_rnd_task_default_reward%
on_info = {=counter_greater(mb_fr:2)} sr_idle@1_1_2 %=start_rnd_task_default_reward%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_forest_mobs =set_counter(mb_fr:0)%

[sr_idle@1_1_2]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_forest_mobs -random_event_forest%


; Найти артефакт:
[sr_idle@1_3]
on_info = {=actor_has_item(forest_rnd_artefact)} sr_idle@1_1_3 %+forest_rnd_artefact_gathered%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_forest_artefact =delete_forest_maroders =set_counter(mr_fr:0)%

[sr_idle@1_1_3]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_forest_maroders -forest_marod_hit%


; Выкрасть ценный груз:
[sr_idle@1_4]
on_info = {=actor_has_item(rnd_task_forest_item)} sr_idle@1_1_4 %+forest_rnd_item_gathered%
; если нас ранили:
on_info2 = {+critical_health} sr_idle@wait %=delete_forest_maroders =clear_box(forest_invbox_1) =unmark_forest_maroders_box1 =set_counter(mr_fr:0)%

[sr_idle@1_1_4]
on_actor_dist_ge_nvis = 100|sr_idle@wait %=delete_forest_maroders =unmark_forest_maroders_box1 -forest_marod_hit%



; Вспомогательная секция ожидания:
[sr_idle@wait]
on_info = {-random_event_forest} sr_idle@0 %=set_counter(mr_fr:0) =set_counter(mb_fr:0)%



; Для режима Мастер:
[sr_idle@mg1]
on_info = {-mg_zone_forest =is_render_r1or2} sr_idle@0 %=remowe_self_spot(mg_deathzone_mark9a:mg_deathzone_mark1_text)%
on_info2 = {-mg_zone_forest =is_render_r3or4} sr_idle@0 %=remowe_self_spot(mg_deathzone_mark9b:mg_deathzone_mark1_text)%



