[logic]
active = sr_idle@1

[sr_idle@1]
on_info = {=master_difficulty} sr_idle@nil
on_actor_inside = sr_idle@2 %=run_postprocess(fade_in) =disable_ui =spawn_lonl_house_store_npc%

[sr_idle@2]
on_game_timer = 30|sr_cutscene@1 %=lonl_house_store_think%

[sr_cutscene@1]
point = mechanical_npc1_look
look = lonl_house_pnt5_1_look
cam_effector = scenario_cam\lonl_house_script_cam1
on_signal = cameff_end | sr_idle@3 %+knife_finded =give_item(wpn_knife:actor) =activate_weapon_slot(0) =send_tip(knife_finded_tip:default)%
global_cameffect = true
outdoor = true
enable_ui_on_end = true


; Объединяем наборы деталей в ремкомплекты:
[sr_idle@3]
on_info = {+stranger_talk1 =weapon_details_collected} %=weapon_details_communicate%



[sr_idle@nil]