[smart_terrains]
none = true

[dont_spawn_loot]

[logic]
active = walker@start
on_death = death


[walker@start]
path_walk = mg_art_robber_npc_walk1
path_look = mg_art_robber_npc_look1
;invulnerable = true
can_use_knife = false
meet = no_meet
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
combat_ignore_cond = true
on_info = {+actor_has_lr300} walker@1 %=give_items(wpn_lr300)%
on_info2 = {+actor_has_ak74} walker@1 %=give_items(wpn_ak74_mg)%
on_info3 = {+actor_has_aksu} walker@1 %=give_items(wpn_ak74u)%
on_info4 = {+actor_has_toz} walker@1 %=give_items(wpn_toz34)%
on_info5 = {+actor_has_bizon} walker@1 %=give_items(wpn_bizon)%
on_info6 = {+actor_has_mosin} walker@1 %=give_items(wpn_m1891)%
on_info7 = {+actor_has_sayga} walker@1 %=give_items(wpn_sayga)%
on_info8 = {+actor_has_fort500} walker@1 %=give_items(wpn_fort500)%
on_info9 = {+actor_has_vityaz} walker@1 %=give_items(wpn_vityaz)%
on_info10 = {+actor_has_vss} walker@1 %=give_items(wpn_vintorez)%
on_info11 = {+actor_has_groza} walker@1 %=give_items(wpn_groza)%
on_info12 = {-actor_has_toz -actor_has_lr300 -actor_has_ak74 -actor_has_aksu -actor_has_bizon -actor_has_sayga -actor_has_mosin -actor_has_vss -actor_has_groza -actor_has_vityaz -actor_has_fort500} walker@1


[walker@1]
path_walk = mg_art_robber_npc_walk1
path_look = mg_art_robber_npc_look1
;invulnerable = true
can_use_knife = false
meet = no_meet
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
def_state_moving1 = sprint
def_state_moving2 = sprint
def_state_moving3 = sprint
on_signal       = arriwed|walker@2

