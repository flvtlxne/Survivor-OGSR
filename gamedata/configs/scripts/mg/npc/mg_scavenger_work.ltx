; Пиздим лут из ящика:
[remark@gather_airdrop]
anim = dynamite
target = story | mg_airdrop
combat_ignore_cond = true
meet = no_meet
can_use_knife = false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_info = {+mg_heli_evac_sucess} %=destroy_object%
on_info2 = {+mg_airdrop_gathered} companion@1
on_game_timer = 57|%=destroy_object =spawn_mg_scav2 =send_tip(mg_airdrop_lost:default) =del_mg_airdrop +mg_airdrop_lost%



; Начинаем преследовать ГГ:
[companion@1]
meet = no_meet
invulnerable = false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
;combat_ignore_cond = true
can_use_knife = false
on_info = {+mg_heli_evac_sucess} %=destroy_object%
on_info2 = {=heavy_wounded} %=health_slow_up%
on_actor_dist_le_nvis = 30|companion@2

[companion@2]
meet = no_meet
invulnerable = false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
can_use_knife = false
on_info = {+mg_heli_evac_sucess} %=destroy_object%
on_info2 = {=heavy_wounded} %=health_slow_up%


[companion@3]
meet = no_meet
invulnerable = false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
;combat_ignore_cond = true
can_use_knife = false
on_actor_dist_le_nvis = 50|%=mg_npc_scav_indicator%
on_actor_dist_ge_nvis = 51|%=mg_npc_scav_indicator_off%
on_info = {+mg_heli_evac_sucess} %=destroy_object%
on_info2 = {=heavy_wounded} %=health_slow_up%
on_actor_dist_le_nvis = 30|companion@4

