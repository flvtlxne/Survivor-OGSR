path_look = mg_start_heli_airdrop_pnt1
;invulnerable = true
can_use_knife = false
meet = no_meet
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
combat_ignore_cond = true
def_state_moving1 = sprint
def_state_moving2 = sprint
def_state_moving3 = sprint
on_info = {+mg_heli_evac_sucess} %=destroy_object%
on_info2 = {+mg_airdrop_gathered} companion@1
on_signal       = arriwed|remark@gather_airdrop %=spawn_smoke_grenade_at_pos =start_npc_smoke_bomb_timer%

