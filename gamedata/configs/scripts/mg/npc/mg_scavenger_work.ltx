[smart_terrains]
none = true

[dont_spawn_loot]

[logic]
active = {+mg_airdrop_lost} companion@3, {-mg_airdrop_lost} remark@searching1
;on_hit = hit
on_death = death


; Подготовка:
[remark@searching1]
anim = binocular
target = story | actor
combat_ignore_cond = true
meet = no_meet
can_use_knife = false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_info = {+mg_heli_evac_sucess} %=destroy_object%
on_info2 = {+airdrop_pnt1} walker@1
on_info3 = {+airdrop_pnt2} walker@2
on_info4 = {+airdrop_pnt3} walker@3
on_info5 = {+airdrop_pnt4} walker@4
on_info6 = {+airdrop_pnt5} walker@5
on_info7 = {+airdrop_pnt6} walker@6
on_info8 = {+airdrop_pnt7} walker@7
on_info9 = {+airdrop_pnt8} walker@8
on_info10 = {+airdrop_pnt9} walker@9


; Бежим к ящику:

