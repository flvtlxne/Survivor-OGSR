[hit]
on_info = companion@2

[death]
on_info = {+mg_airdrop_lost} %=remowe_self_spot(mg_npc_scav_mark:mg_npc_actor_scav_mark_text) =remowe_self_spot(mg_npc_scav_mark:mg_npc_actor_scav_mark_text) =give_rnd_item_ammo2 =give_rnd_item_ammo2 =give_items(neutral_assault_outfit)%, {-mg_airdrop_lost} %=remowe_self_spot(mg_npc_scav_mark:mg_npc_actor_scav_mark_text) =remowe_self_spot(mg_npc_scav_mark:mg_npc_actor_scav_mark_text) =give_rnd_item_ammo2%






