[smart_terrains]
none = true

[dont_spawn_loot]

[logic]
active = remark@1

; Ждём, пока ГГ приблизится:
[remark@1]
anim = binocular
target = story | script_zone_island
combat_ignore_cond = true
meet = no_meet
invulnerable = true
can_use_knife = false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_actor_dist_le_nvis = 70|walker@1 %=clear_smart_terrain(lw_mobs_smart10)%

; Идём к нычке:
[walker@1]
path_walk = mg_kpp_lider_assistant_walk1
path_look = mg_kpp_lider_assistant_look1
invulnerable = true
can_use_knife = false
meet = no_meet
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
def_state_moving1 = run
def_state_moving2 = run
def_state_moving3 = run
combat_ignore_cond = true
on_info = {+mg_heli_evac_sucess} %=destroy_object -kpp_lider_assistant_away%
on_actor_dist_le = 30|walker@away %=kpp_lider_assistant_away%
on_signal       = arriwed|walker@2

; Дошли, сели:
[walker@2]
path_walk = mg_kpp_lider_assistant_walk1
path_look = mg_kpp_lider_assistant_look1
invulnerable = true
can_use_knife = false
meet = no_meet
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
def_state_moving1 = run
def_state_moving2 = run
def_state_moving3 = run
combat_ignore_cond = true
on_info = {+mg_heli_evac_sucess} %=destroy_object%
on_actor_dist_le = 30|walker@away %=kpp_lider_assistant_away -kpp_lider_assistant_away%
on_game_timer = 101|walker@3 %=spawn_kpp_lider_shron%

; Идём обратно:
[walker@3]
path_walk = mg_kpp_lider_assistant_walk2
path_look = mg_kpp_lider_assistant_look2
invulnerable = true
can_use_knife = false
meet = no_meet
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
def_state_moving1 = run
def_state_moving2 = run
def_state_moving3 = run
combat_ignore_cond = true
on_info = {+mg_heli_evac_sucess} %=destroy_object -kpp_lider_assistant_away%
on_actor_dist_le = 30|walker@away
on_signal       = arriwed|%=destroy_object%


; Если спугнули:
[walker@away]
path_walk = mg_kpp_lider_assistant_walk2
path_look = mg_kpp_lider_assistant_look2
invulnerable = true
can_use_knife = false
meet = no_meet
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
def_state_moving1 = sprint
def_state_moving2 = sprint
def_state_moving3 = sprint
combat_ignore_cond = true
on_info = {+mg_heli_evac_sucess} %=destroy_object%
on_signal       = arriwed|%=destroy_object -kpp_lider_assistant_away%






