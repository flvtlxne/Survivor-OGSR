[smart_terrains]
none = true

[dont_spawn_loot]

[logic]
active = remark@searching1
on_hit = hit
on_death = death


; Смотрим в бинокль:
[remark@searching1]
anim = binocular
target = story | actor
combat_ignore_cond = true
meet = no_meet
can_use_knife = false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_info = {+mg_heli_evac_sucess} %=destroy_object%
on_info2 = {=heavy_wounded} %=health_slow_down%
;on_game_timer = 11|companion@1 %=add_self_spot(mg_npc_killer_mark:mg_npc_actor_killer_mark_text)%
on_info3 = {=actor_has_item(af_eye_mg)} companion@1 %=add_self_spot(mg_npc_killer_mark:mg_npc_actor_killer_mark_text)%, {!actor_has_item(af_eye_mg)} companion@1

; Бежим к ГГ:
[companion@1]
meet = no_meet
invulnerable = false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
combat_ignore_cond = true
can_use_knife = false
on_info = {+mg_heli_evac_sucess} %=destroy_object%
on_info2 = {=heavy_wounded} %=health_slow_down%
on_actor_dist_le = 2|companion@2

[companion@2]
meet = no_meet
invulnerable = false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
can_use_knife = true
on_info = {+mg_heli_evac_sucess} %=destroy_object%
on_info2 = {=heavy_wounded} %=health_slow_down%



; Путешествуем по локе:
[walker@1_1]
path_walk = forest_pnt1_look
path_look = forest_pnt1_walk
def_state_moving1 = run
invulnerable = false
can_use_knife = false
meet = no_meet
gather_items_enabled = false
help_wounded_enabled = true
corpse_detection_enabled = false
on_info = {=heavy_wounded} %=health_slow_down%


[hit]
on_info = companion@2

[death]
on_info = {!actor_has_item(af_fire_mg)} %=remowe_self_spot(mg_npc_killer_mark:mg_npc_actor_killer_mark_text) =mg_actor_killer_respawn =give_rnd_item_medicine%, {=actor_has_item(af_fire_mg)} %=remowe_self_spot(mg_npc_killer_mark:mg_npc_actor_killer_mark_text) =mg_actor_killer_respawn =give_rnd_item_medicine =give_rnd_item_medicine%






