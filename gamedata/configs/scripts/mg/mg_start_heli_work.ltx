[logic]
active = heli_move@start


; Стартовая секция:
[heli_move@start]
path_move = mg_start_heli_point1_walk
path_look = mg_start_heli_point1_look
engine_sound = true
combat_ignore = true
combat_enemy = nil
invulnerable = true
immortal = true
max_velocity = 90
on_info = {!master_difficulty} %=destroy_object%
on_info2 = {=master_difficulty +actor_start_move} heli_move@fly0 %=add_self_spot(mg_heli_mark:mg_heli_mark_text)%



[heli_move@fly0]
path_move = mg_start_heli_point2_walk
path_look = mg_start_heli_point2_look
engine_sound = true
;enemy = mercs
combat_use_rocket = false
invulnerable = true
immortal = true
max_velocity = 50
;on_game_timer = 21|{~5} heli_move@fly2 %=send_mg_start_heli_tip1%, {~10} heli_move@fly3 %=send_mg_start_heli_tip1%, {~20} heli_move@fly4 %=send_mg_start_heli_tip1%, {~30} heli_move@fly5 %=send_mg_start_heli_tip1%, {~40} heli_move@fly6 %=send_mg_start_heli_tip1%, {~50} heli_move@fly7 %=send_mg_start_heli_tip1%, {~60} heli_move@fly8 %=send_mg_start_heli_tip1%, {~70} heli_move@fly9 %=send_mg_start_heli_tip1%, {~80} heli_move@fly10, heli_move@fly11 %=send_mg_start_heli_tip1%
on_game_timer = 21|heli_move@fly1 %=send_mg_start_heli_tip1 =give_task(mg_task_evacuation)%



