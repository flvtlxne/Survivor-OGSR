[logic]
active = ph_idle@0

[ph_idle@0]
on_info = {+deadman_diary_info1} ph_idle@1
on_info2 = {=master_difficulty} %=destroy_object%

[ph_idle@1]
tips      = village_secr_place_obj_use
on_use = {=actor_has_item(car_item_domkrat)} ph_idle@2 %=disable_ui =run_postprocess(fade_in)%

; Сдвигаем ящик:
[ph_idle@2]
on_game_timer = 20|ph_idle@3 %=run_postprocess(fade_in) =village_secr_place_actor_replace =play_sound(actor_axeplace_use)%

[ph_idle@3]
on_game_timer = 15|ph_idle@1 %=destroy_object =spawn_village_secr_place_box =enable_ui%




 