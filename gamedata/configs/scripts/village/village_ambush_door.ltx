[logic]
active = ph_door@open

[ph_door@close]
locked = true
closed = true
snd_open_start = wood_large_open
snd_close_start = wood_large_close_start
snd_close_stop = wood_large_close_stop
show_tips = true
tip_open = locked_door_need_key_tip
on_use = {=actor_has_item(village_ambush_door_key)} ph_door@open2 %=remove_item(village_ambush_door_key)%
on_info = {=master_difficulty} %=destroy_object%


[ph_door@open]
locked = false
closed = false
snd_open_start = wood_large_open
snd_close_start = wood_large_close_start
snd_close_stop = wood_large_close_stop
on_info = {+maroders_ambush_end} ph_door@close

[ph_door@open2]
locked = false
closed = false
snd_open_start = wood_large_open
snd_close_start = wood_large_close_start
snd_close_stop = wood_large_close_stop


[ph_door@free]
locked = false
closed = true
no_force = true
on_use = ph_door@open