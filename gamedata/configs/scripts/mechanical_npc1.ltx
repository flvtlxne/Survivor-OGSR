[smart_terrains]
none = true

[logic]
active = walker@1
combat_ignore = combat_ignore


[walker@1]
path_walk = mechanical_npc1_walk
path_look = mechanical_npc1_look
meet = meet@1
invulnerable = true
combat_ignore_keep_when_attacked = true
danger = danger_condition
combat_ignore_cond = true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
can_use_knife = false
on_game_timer = 10|walker@2

[walker@2]
path_walk = mechanical_npc1_walk
path_look = mechanical_npc1_look
meet = meet@1
invulnerable = true
combat_ignore_keep_when_attacked = true
danger = danger_condition
combat_ignore_cond = true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
can_use_knife = false
