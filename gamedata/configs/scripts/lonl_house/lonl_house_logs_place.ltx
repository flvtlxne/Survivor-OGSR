[logic]
active = ph_idle@1

[ph_idle@1]
tips      = lonl_house_logs_place_use
on_use = {!actor_has_item(wood_log)} ph_idle@2 %=play_sound(actor_finds_something2) =give_item(wood_log:actor)%
on_info = {=master_difficulty} %=destroy_object%

; Берём бревно сразу, без затемнения. Полсекунды паузы, чтобы двойное нажатие не дало два бревна:
[ph_idle@2]
on_timer = 500 | ph_idle@1
