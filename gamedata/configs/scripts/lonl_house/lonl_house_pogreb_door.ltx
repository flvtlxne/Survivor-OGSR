[logic]
active = ph_door@close

[ph_door@close]
locked = false
closed = true
snd_open_start = wood_large_open
snd_close_start = wood_large_close_start
snd_close_stop = wood_large_close_stop
on_use = {=actor_has_item(lonl_house_pogreb_door_key)} ph_door@open %=remove_item(lonl_house_pogreb_door_key)%
show_tips = true
tip_open = locked_door_need_key_tip
;hit_on_bone = 1|ph_door@free|2|ph_door@free
on_info = {=master_difficulty} %=destroy_object%

[ph_door@open]
locked = false
closed = false
snd_open_start = wood_large_open
snd_close_start = wood_large_close_start
snd_close_stop = wood_large_close_stop
on_use = ph_door@close
hit_on_bone = 1|ph_door@free|2|ph_door@free

[ph_door@free]
locked = false
closed = true
no_force = true
on_use = ph_door@open