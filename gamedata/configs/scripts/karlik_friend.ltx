[smart_terrains]
none = true

[logic]
active = mob_move@1
on_death = mob_death


[mob_move@1]
captured_actor = true
combat_ignore_cond = {=captured_monster_ignore_precond} true
on_game_timer = 1|mob_move@2 %=add_self_spot(karlik_friend_mark:karlik_friend_mark_text) =play_sound(karlik_hello_snd)%

[mob_move@2]
captured_actor = true
combat_ignore_cond = {=captured_monster_ignore_precond} true
;invulnerable = true
on_info = {=health_le(0.25)} mob_home@away1 %=set_visual_memory_enabled(0)%
on_info2 = {+karlik_talk} mob_remark@stay1 %=set_visual_memory_enabled(0)%
on_info3 = {=npc_in_actor_frustum =dist_to_actor_le(5)} %=karlik_friend_commands_hint%
on_info4 = {+karlik_stay} mob_remark@stay2
on_info5 = {+karlik_getlost} mob_home@away2

; Стоим для разговора:
[mob_remark@stay1]
anim = norm_idle
combat_ignore_cond = true
invulnerable = true
on_info = {-karlik_talk} mob_move@2 %=set_visual_memory_enabled(1)%
on_info2 = {+karlik_stay} mob_remark@stay2
on_info3 = {+karlik_getlost} mob_home@away2

; Стоим просто так:
[mob_remark@stay2]
anim = norm_idle
combat_ignore_cond = true
invulnerable = true
on_info = {=health_le(0.25)} mob_home@away1 %=set_visual_memory_enabled(0)%
on_info2 = {-karlik_stay} mob_move@2 %=set_visual_memory_enabled(1)%

; Ранены, сваливаем:
[mob_home@away1]
path_home = maroders_escape_point1
home_min_radius = 3
home_max_radius = 8
invulnerable = true
combat_ignore_cond = true
on_actor_dist_ge_nvis = 50|%=destroy_object -karlik_talk%

; Просто сваливаем:
[mob_home@away2]
path_home = maroders_escape_point1
home_min_radius = 3
home_max_radius = 8
invulnerable = true
combat_ignore_cond = true
on_info = {-karlik_getlost} mob_move@2 %=set_visual_memory_enabled(1)%
on_actor_dist_ge_nvis = 50|%=destroy_object -karlik_talk%



[mob_death]
on_info = %+karlik_friend_dead =destroy_object -karlik_talk%






