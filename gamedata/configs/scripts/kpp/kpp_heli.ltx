path_look = kpp_merc1_walk
engine_sound = true
enemy = actor
combat_use_rocket = false
invulnerable = false
immortal = false
max_velocity = 100
show_health = true
on_game_timer = 150|heli_move@fly3_2

[heli_move@fly3_2]
path_move = kpp_heli_point5
path_look = kpp_merc1_walk
engine_sound = true
enemy = actor
combat_use_rocket = false
invulnerable = false
immortal = false
max_velocity = 100
show_health = true
on_game_timer = 150|heli_move@fly3_3

[heli_move@fly3_3]
path_move = kpp_heli_point6
path_look = kpp_merc1_walk
engine_sound = true
enemy = actor
combat_use_rocket = false
invulnerable = false
immortal = false
max_velocity = 100
show_health = true
on_game_timer = 150|heli_move@fly3



; Улетаем:
[heli_move@fly_away]
path_move = kpp_heli_point2
path_look = kpp_heli_point1
engine_sound = true
combat_use_rocket = false
combat_ignore = true
invulnerable = true
immortal = true
max_velocity = 100
on_signal = arriwed | %=destroy_object%
















