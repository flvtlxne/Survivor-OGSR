[logic]
active = ph_door@close

[ph_door@close]
locked = false
closed = true
snd_open_start = wood_large_open
snd_close_start = wood_large_close_start
snd_close_stop = wood_large_close_stop
show_tips = true
tip_open = locked_door_need_key_tip
on_info = {+kpp_mercs_agree} ph_door@open
;on_info2 = {=master_difficulty} %=destroy_object%


[ph_door@open]
locked = false
closed = false
snd_open_start = wood_large_open
snd_close_start = wood_large_close_start
snd_close_stop = wood_large_close_stop
;on_use = ph_door@close


[ph_door@free]
locked = false
closed = true
no_force = true
on_use = ph_door@open