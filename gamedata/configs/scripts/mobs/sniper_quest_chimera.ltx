[smart_terrains]
none = true

[logic]
active = {+sniper_tree_check} mob_home@2, mob_home@1
on_death = mob_death


; Для кат-сцены в начале:
[mob_home@1]
path_home = quest_sniper_zone_point1
home_min_radius = 1
home_max_radius = 2
on_info = {+stranger_talk1} %=destroy_object%


; Записка прочитана, атакуем:
[mob_home@2]
path_home = quest_sniper_zone_point1
home_min_radius = 5
home_max_radius = 18
;combat_ignore_cond = true
;invulnerable = true







[mob_death]
on_info = %+sniper_quest_chimera_dead%



