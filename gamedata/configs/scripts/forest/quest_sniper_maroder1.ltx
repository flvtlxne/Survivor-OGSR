[smart_terrains]
none = true

[logic]
active = walker@start
on_death = death

[walker@start]
path_walk = quest_sniper_zone_point9_1
path_look = quest_sniper_zone_point8_1
on_info = {+actor_has_lr300} walker@1 %=give_items(wpn_lr300)%
on_info2 = {+actor_has_ak74} walker@1 %=give_items(wpn_ak74)%
on_info3 = {+actor_has_aksu} walker@1 %=give_items(wpn_ak74u)%
on_info4 = {+actor_has_toz} walker@1 %=give_items(wpn_toz34)%
on_info5 = {+actor_has_bizon} walker@1 %=give_items(wpn_bizon)%
on_info6 = {+actor_has_sayga} walker@1 %=give_items(wpn_sayga)%
on_info7 = {-actor_has_toz -actor_has_lr300 -actor_has_ak74 -actor_has_aksu -actor_has_bizon -actor_has_sayga} walker@1


[walker@1]
path_walk = quest_sniper_zone_point9_1
path_look = quest_sniper_zone_point8_1
combat_ignore_cond = true
invulnerable = true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
meet = no_meet
on_info = {+quest_sniper_scene_alarm} walker@2 %=reset_maroder_sniper_anim =play_sound(maroder_sniper_kill_him) =actor_neutral =make_enemy(quest_sniper2)%

[walker@2]
path_walk = quest_sniper_zone_point9_1
path_look = quest_sniper_zone_point8_2
def_state_moving1 = assault
combat_ignore_cond = true
invulnerable = true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
meet = no_meet
on_game_timer = 32|camper@1 %+maroder_sniper_scene_rasstrel%

[camper@1]
path_walk = quest_sniper_zone_point9_1
path_look = quest_sniper_zone_point8_2
def_state_standing = threat_fire
def_state_moving = assault_fire
def_state_moving_fire = assault_fire
no_retreat = true
gather_items_enabled = false
corpse_detection_enabled = false
on_game_timer = 122|walker@4 %=actor_enemy%



[walker@3]
path_walk = quest_sniper_zone_point9_1
path_look = quest_sniper_zone_point8_2
;combat_ignore_cond = true
invulnerable = true
def_state_moving1 = assault
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
meet = no_meet
on_game_timer = 122|walker@4 %=actor_enemy%

[walker@4]
path_walk = quest_sniper_zone_point9_1
path_look = quest_sniper_zone_point8_2
combat_ignore_cond = {-quest_sniper_scene} true
def_state_moving1 = assault
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
meet = no_meet



[death]
on_info = %+sniper_maroder1_dead%






