[logic]
active = ph_door@close

[ph_door@close]
locked = false
closed = false
snd_open_start = wood_large_open
snd_close_start = wood_large_close_start
snd_close_stop = wood_large_close_stop
show_tips = false
tip_open = karlik_quest_plita_use
on_info = {+karlik_plita_open} ph_door@open

[ph_door@open]
locked = true
closed = true
snd_open_start = wood_large_open
snd_close_start = wood_large_close_start
snd_close_stop = wood_large_close_stop
show_tips = false
tip_close = karlik_quest_plita_use






