[logic]
active = ph_idle@0

[ph_idle@0]
tips = village_undegr_door_use1
on_info = {+undegr_door_check} ph_idle@1

[ph_idle@1]
tips = village_undegr_door_use2
on_use = {=actor_has_item(suicider_key)} ph_idle@2 %=play_sound(repare_something) =remove_item(suicider_key) =disable_ui =run_postprocess(fade_in)%

[ph_idle@2]
on_game_timer = 20|ph_idle@3 %=run_postprocess(fade_in) =play_sound(karlik_psyzone_trap)%

[ph_idle@3]
on_game_timer = 15|%=actor_teleport_to_karlik_trap +actor_teleport_to_karlik_trap =enable_ui =destroy_object%


