[smart_terrains]
none = true

[logic]
active = walker@start

[walker@start]
path_walk = quest_sniper_maroder2_walk
path_look = quest_sniper_maroder2_look1
on_info = {+actor_has_lr300} remark@1 %=give_items(wpn_lr300)%
on_info2 = {+actor_has_ak74} remark@1 %=give_items(wpn_ak74)%
on_info3 = {+actor_has_aksu} remark@1 %=give_items(wpn_ak74u)%
on_info4 = {+actor_has_toz} remark@1 %=give_items(wpn_toz34)%
on_info5 = {+actor_has_bizon} remark@1 %=give_items(wpn_bizon)%
on_info6 = {+actor_has_sayga} remark@1 %=give_items(wpn_sayga)%
on_info7 = {-actor_has_toz -actor_has_lr300 -actor_has_ak74 -actor_has_aksu -actor_has_bizon -actor_has_sayga} remark@1


[remark@1]
anim = wait
target = path | quest_sniper_maroder2_walk, 0
danger = danger_condition
combat_ignore_cond = true
show_spot = false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_game_timer = 70|walker@1 %=play_sound(maroder_alarm)%

[walker@1]
path_walk = quest_sniper_maroder2_walk
path_look = quest_sniper_maroder2_look2
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
def_state_moving1 = sprint
def_state_moving2 = sprint
def_state_moving3 = sprint
on_info = {=actor_in_zone(script_zone_lonl_house)} %=destroy_object%









