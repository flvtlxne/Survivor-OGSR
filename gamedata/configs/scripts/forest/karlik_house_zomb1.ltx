[smart_terrains]
none = true

[logic]
active = walker@1
;on_death = death
;on_hit = hit

[walker@1]
path_walk = karlik_house_zomb_point_1
path_look = karlik_house_zomb_point_2
invulnerable = false
can_use_knife = false
meet = no_meet
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_info = {+actor_has_lr300} walker@2 %=give_items(wpn_lr300) =make_enemy(lw_scientist)%
on_info2 = {+actor_has_ak74} walker@2 %=give_items(wpn_ak74) =make_enemy(lw_scientist)%
on_info3 = {+actor_has_aksu} walker@2 %=give_items(wpn_ak74u) =make_enemy(lw_scientist)%
on_info4 = {+actor_has_toz} walker@2 %=give_items(wpn_toz34) =make_enemy(lw_scientist)%
on_info5 = {+actor_has_bizon} walker@2 %=give_items(wpn_bizon) =make_enemy(lw_scientist)%
on_info6 = {+actor_has_sayga} walker@2 %=give_items(wpn_sayga) =make_enemy(lw_scientist)%
on_info7 = {-actor_has_toz -actor_has_lr300 -actor_has_ak74 -actor_has_aksu -actor_has_bizon -actor_has_sayga} walker@2 %=make_enemy(lw_scientist)%

[walker@2]
path_walk = karlik_house_zomb_point_1
path_look = karlik_house_zomb_point_2
invulnerable = false
can_use_knife = false
meet = no_meet
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
def_state_moving1 = run
def_state_moving2 = run
def_state_moving3 = run
;combat_ignore_cond = true
;on_info = {=dist_to_actor_le(7)} walker@3
on_signal       = arriwed|walker@3

[walker@3]
path_walk = karlik_house_zomb_point_1
path_look = karlik_house_zomb_point_2
invulnerable = false
can_use_knife = false
meet = no_meet
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
def_state_moving1 = sprint
def_state_moving2 = sprint
def_state_moving3 = sprint
;on_info = {!dist_to_actor_le(7)} walker@2


[hit]
on_info = walker@3 %=make_enemy(lw_scientist)%

[death]
on_info = {!counter_greater(housezomb:4)} %=spawn_karlik_house_zombies =inc_counter(housezomb)%, {=counter_greater(housezomb:4) !story_object_exist(script_karlik)} %=spawn_house_karlik%











