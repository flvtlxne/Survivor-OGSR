def_state_moving2 = run
def_state_moving3 = run
invulnerable = true
combat_ignore_cond = true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
meet = meet@2
on_info = {+lw_scientist_to_komp} animpoint@3
on_info2 = {+lake_house_check} walker@2 %=play_sound(lw_scientist_bye)%
on_game_timer = 500|walker@1_2

