help_wounded_enabled = false
corpse_detection_enabled = false
meet = no_meet
on_info = {!story_obj_in_zone_by_name(lw_scientist:karlik_quest_zone5)} remark@1


[remark@1]
anim = pri_a25_psy_medic_idle
target = story | karlik_quest_zone7
combat_ignore_cond = true
invulnerable = true
meet = no_meet
on_info = %=play_sound(help_heavy)%
on_signal = sound_end | remark@2 %+scientist_psy_atack%

[remark@2]
anim = pri_a25_psy_medic_idle
target = story | karlik_quest_zone7
combat_ignore_cond = true
invulnerable = true
meet = meet@2
on_info = {+karlik_first_talk} remark@3 %=play_sound(pri_a28_army_what_is_that)%
on_info2 = {+karlik_kill_scientist} remark@4 %=play_sound(pri_a28_army_what_is_that)%

[remark@3]
anim = caution
target = story | karlik_quest_zone7
combat_ignore_cond = true
invulnerable = true
meet = meet@2
on_info = {+scientist_goto_house} animpoint@1

[remark@4]
anim = caution
target = story | karlik_quest_zone7
combat_ignore_cond = true
invulnerable = false
meet = no_meet


[animpoint@1]
cover_name = lonl_house_scientist_animpoint1
avail_animations = animpoint_sit_normal
reach_distance = 1.5
danger = danger_condition
combat_ignore_cond = true
reach_movement = run
;invulnerable = true
invulnerable = false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
meet = no_meet
on_info = {+karlik_real_death} animpoint@2 %=restore_health%

[animpoint@2]
cover_name = lonl_house_scientist_animpoint1
avail_animations = animpoint_sit_normal
reach_distance = 1.5
danger = danger_condition
combat_ignore_cond = true
reach_movement = run
invulnerable = true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
meet = meet@3
on_info = {+lonl_house_marodr_atack} remark@maroders1
on_info2 = {+lw_scientist_to_komp} animpoint@3


; При нападении мародёров на убежище:
[remark@maroders1]
anim = hands_up
target = path | lonl_house_bed_point2, 0
combat_ignore_cond = true
meet = no_meet
invulnerable = true
can_use_knife = false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_info = {-lonl_house_marodr_atack -lw_scientist_to_komp} animpoint@2
on_info2 = {-lonl_house_marodr_atack +lw_scientist_to_komp} animpoint@3


; За компом:
[animpoint@3]
cover_name = lonl_house_scientist_animpoint2
avail_animations = animpoint_sit_normal
reach_distance = 1.5
danger = danger_condition
combat_ignore_cond = true
reach_movement = run
invulnerable = true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
meet = meet@3
on_info = {+lonl_house_marodr_atack} remark@maroders1




; диалог обычный(без торговли):
[meet@2]
abuse = false
use = true
trade_enable = false
allow_break = true


[meet@3]
close_snd_hello = lw_scientist_hello
close_snd_bye = lw_scientist_bye
close_anim 		= nil
close_victim 	= nil
far_anim 		= nil
far_victim 		= nil
close_distance  = 0
far_distance 	= 0
close_snd_distance = 3
use = {=actor_enemy} false, true
allow_break = true
trade_enable = true
meet_on_talking = false


[death]
on_info = {=killed_by_actor} %=actor_kill_quest_npc_replic +lw_scientist_dead%, {!killed_by_actor} %+lw_scientist_dead%



