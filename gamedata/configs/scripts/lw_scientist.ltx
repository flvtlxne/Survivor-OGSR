[smart_terrains]
none = true

[logic]
active = {+lw_scientist_to_komp} animpoint@3, {+karlik_real_death} animpoint@2, {+scientist_goto_house -karlik_real_death} animpoint@1, walker@1_1
on_death = death
trade = misc\trade_scientist.ltx

[walker@1_1]
