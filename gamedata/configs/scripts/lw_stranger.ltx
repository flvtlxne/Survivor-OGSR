; Сдаём ГГ мародёрам:
[walker@ambush]
path_walk = lw_stranger_willage_pnt1_walk
path_look = lw_stranger_willage_pnt1_look
meet = no_meet
invulnerable = true
combat_ignore_keep_when_attacked = true
combat_ignore_cond = true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_info = {+maroders_ambush_end} %=destroy_object%


; В туннеле с контролёром:
[walker@end1]
path_walk = lw_stranger_after_ambush_spawn_pnt
path_look = lw_stranger_after_ambush_spawn_pnt2
meet = meet@2
invulnerable = true
combat_ignore_keep_when_attacked = true
danger = danger_condition
combat_ignore_cond = true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
