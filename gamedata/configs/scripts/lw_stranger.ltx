[remark@end]
snd = jup_b1_stalkers_psy_wound_1
anim = psy_pain
target = story | actor
;in_restr = mechanical_npc1_zone
danger = danger_condition
combat_ignore_cond = true
meet = no_meet
invulnerable = true
on_info = {+village_stranger_controller_dead} %=destroy_object =spawn_lw_stranger_zombied +lw_stranger_dead%





; диалог неразрываемый(нпс юзает ГГ сам):
[meet@1]
abuse = false
use = self
trade_enable = false
allow_break = false

; диалог обычный(без торговли):
[meet@2]
abuse = false
use = true
trade_enable = false
allow_break = true


[danger_condition]
ignore_distance = 0
ignore_distance_grenade = 0
ignore_distance_corpse = 0
ignore_distance_hit = 0
ignore_distance_sound = 0


[death] 
on_info = %+lw_stranger_dead%


