[smart_terrains]
none = true

[logic]
active = walker@start
on_death = death

[walker@start]
path_walk = lw_stranger1_walk1
path_look = lonl_house_bed_point1

on_info = {+stranger_talk7} remark@end
on_info2 = {+marouder_lider_3pda_info} walker@end1
on_info3 = {+marorers_house_trap} walker@ambush
on_info4 = {+lake_scenar_marod_lider_dead} animpoint@7
on_info5 = {+willage_scenar_marod_lider_dead} animpoint@6
on_info6 = {+stranger_talk4} walker@3
on_info7 = {+lw_stranger_after_newbie_call} animpoint@5
on_info8 = {+marodr_camp_done} animpoint@3
on_info9 = {+stranger_talk1} animpoint@1
on_info10 = {-stranger_talk1 -stranger_talk2} walker@1


; Первая встреча(после аварии очнулись в доме отшельника):
[walker@1]
path_walk = lw_stranger1_walk1
path_look = lonl_house_bed_point1
meet = meet@1
invulnerable = true
combat_ignore_keep_when_attacked = true
danger = danger_condition
combat_ignore_cond = true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
;on_info = {+stranger_talk1} walker@2 %=disable_ui%
on_info = {+stranger_talk1} walker@fade %=disable_ui =run_postprocess(fade_in_out)%

;=play_sound(jup_a12_bandits_bodyguard_warning_actor)
; Survivor: после первого разговора Незнакомец исчезает в затемнении экрана
[walker@fade]
path_walk = lw_stranger1_walk1
path_look = lonl_house_bed_point1
meet = no_meet
invulnerable = true
combat_ignore_keep_when_attacked = true
danger = danger_condition
combat_ignore_cond = true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_timer = 1000 | walker@gone %=destroy_object =enable_ui +note_diary1 +note_using =scenario_save1%

[walker@gone]
path_walk = lw_stranger1_walk1
path_look = lonl_house_bed_point1
meet = no_meet
invulnerable = true

[remark@1]
snd = stranger_phrase1
anim = fold_arms
;target = path | lonl_house_bed_point1, 0
target = story | actor
danger = danger_condition
combat_ignore_cond = true
invulnerable = true
on_signal = sound_end|walker@2

[walker@2]
path_walk = lw_stranger1_walk2
path_look = lonl_house_pnt5_3_walk
meet = no_meet
invulnerable = false
combat_ignore_keep_when_attacked = true
danger = danger_condition
combat_ignore_cond = true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_signal       = arriwed|%=destroy_object =enable_ui +note_diary1 +note_using =scenario_save1%


; Вторая встреча(после обыска ящика):
[animpoint@1]
cover_name = lonl_house_starnger_animpoint1
avail_animations = animpoint_sit_normal
reach_distance = 0.5
danger = danger_condition
combat_ignore_cond = true
invulnerable = true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
meet = meet@2
on_info = {+stranger_talk2} animpoint@2 %=scenario_save2 =spawn_forest_camp_mutants_quest =give_task(lwtask_stranger_work) =spawn_object_in(detector_simple:forest_camp_invbox1) =destroy_object(story:helicrash_body2) =destroy_object(story:helicrash_body3) =delete_helicrash_mobs =play_sound(stranger_phrase2)%

[animpoint@2]
