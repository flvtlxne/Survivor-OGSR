[smart_terrains]
none = true

[logic]
active = walker@start1
on_hit = hit
on_death = death

[walker@start1]
path_walk = helicrash_pnt1_look
path_look = helicrash_pnt1_walk
on_info = {+actor_has_vss} walker@start2 %=give_items(wpn_vintorez)%
on_info2 = {+actor_has_lr300} walker@start2 %=give_items(wpn_lr300)%
on_info3 = {+actor_has_aksu} walker@start2 %=give_items(wpn_ak74u)%
on_info4 = {+actor_has_toz} walker@start2 %=give_items(wpn_toz34)%
on_info5 = {-actor_has_toz -actor_has_lr300 -actor_has_vss -actor_has_aksu} walker@start2

[walker@start2]
path_walk = helicrash_pnt1_look
path_look = helicrash_pnt1_walk
invulnerable = false
gather_items_enabled = false
corpse_detection_enabled = false
out_restr = script_zone_helicrash
combat_ignore_cond = {-helicrash_marod_hit =actor_wears_novice_outfit !personal_dog_near !actor_has_item(rnd_task_helicrash_item) !actor_has_item(helicrash_rnd_artefact)} true
on_signal       = arriwed|walker@1

[walker@1]
path_walk = helicrash_pnt8_1_walk
path_look = helicrash_pnt8_1_look
def_state_moving1 = patrol
gather_items_enabled = false
corpse_detection_enabled = false
out_restr = script_zone_helicrash
combat_ignore_cond = {-helicrash_marod_hit =actor_wears_novice_outfit !personal_dog_near !actor_has_item(rnd_task_helicrash_item) !actor_has_item(helicrash_rnd_artefact)} true
on_signal       = arriwed|walker@1_1

[walker@1_1]
path_walk = helicrash_pnt8_1_walk
path_look = helicrash_pnt8_1_look
def_state_moving1 = patrol
gather_items_enabled = false
corpse_detection_enabled = false
out_restr = script_zone_helicrash
combat_ignore_cond = {-helicrash_marod_hit =actor_wears_novice_outfit !personal_dog_near !actor_has_item(rnd_task_helicrash_item) !actor_has_item(helicrash_rnd_artefact)} true
on_info = {=dist_to_actor_le(3) -helicrash_marod_hit} %+helicrash_marod_hit%
on_game_timer = 800|walker@2 %=play_sound(state_maroder)%

