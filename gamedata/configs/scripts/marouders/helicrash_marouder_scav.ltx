on_info = {=dist_to_actor_le(3) -helicrash_marod_hit} %+helicrash_marod_hit%
on_game_timer = 800|walker@3 %=play_sound(state_maroder)%

[walker@3]
path_walk = helicrash_pnt8_3_walk
path_look = helicrash_pnt8_3_look
