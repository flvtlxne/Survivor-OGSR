[smart_terrains]
none = true

[logic]
active = walker@start
on_death = death
on_hit = hit

[walker@start]
path_walk = maroders_escape_point1
path_look = lonl_house_pnt5_1_look
on_info = {+actor_has_lr300} walker@1 %=give_items(wpn_lr300)%
on_info2 = {+actor_has_ak74} walker@1 %=give_items(wpn_ak74)%
on_info3 = {+actor_has_aksu} walker@1 %=give_items(wpn_ak74u)%
on_info4 = {+actor_has_toz} walker@1 %=give_items(wpn_toz34)%
on_info5 = {+actor_has_bizon} walker@1 %=give_items(wpn_bizon)%
on_info6 = {+actor_has_sayga} walker@1 %=give_items(wpn_sayga)%
on_info7 = {+actor_has_mosin} walker@1 %=give_items(wpn_m1891)%
on_info8 = {-actor_has_toz -actor_has_lr300 -actor_has_ak74 -actor_has_aksu -actor_has_bizon -actor_has_sayga -actor_has_mosin} walker@1

: Не спеша идём к выходу с локации:
[walker@1]
path_walk = maroders_escape_point1
path_look = lonl_house_pnt5_1_look
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
combat_ignore_cond = true
avail_release = false
combat_ignore_keep_when_attacked = false
can_use_knife = true
on_signal       = arriwed|%=destroy_object +courier_task_fail -courier_task%
on_actor_dist_le = 70|remark@1

; ГГ близко, осматриваемся:
[remark@1]
anim = binocular
target = story | actor
combat_ignore_cond = true
meet = no_meet
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
can_use_knife = false
on_actor_dist_le = 60|walker@run %=send_tip(maroder_courier_alarm_tip:default) =maroder_courier_reset_anim%
on_game_timer = 11|walker@1

; Заметили ГГ и валим со всех ног к выходу:
[walker@run]
path_walk = maroders_escape_point1
path_look = lonl_house_pnt5_1_look
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
combat_ignore_cond = true
avail_release = false
combat_ignore_keep_when_attacked = true
can_use_knife = false
on_info = {~30} walker@run1, {~50} walker@run2, {~70} walker@run3, {~90} walker@run4

[walker@run1]
path_walk = maroders_escape_point1
path_look = lonl_house_pnt5_1_look
