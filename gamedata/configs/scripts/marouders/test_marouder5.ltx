[smart_terrains]
none = true

[logic]
active = walker@start1

[walker@start1]
path_walk = lonl_house_pnt5_1_walk
path_look = lonl_house_pnt5_1_look
on_info = {+actor_has_vss} walker@start2 %=give_items(wpn_vintorez)%
on_info2 = {+actor_has_lr300} walker@start2 %=give_items(wpn_lr300)%
on_info3 = {+actor_has_aksu} walker@start2 %=give_items(wpn_ak74u)%
on_info4 = {+actor_has_toz} walker@start2 %=give_items(wpn_toz34)%
on_info5 = {-actor_has_toz -actor_has_lr300 -actor_has_vss -actor_has_aksu} walker@start2

[walker@start2]
path_walk = lonl_house_pnt5_1_walk
path_look = lonl_house_pnt5_1_look
def_state_moving1 = assault
meet = no_meet
invulnerable = false
gather_items_enabled = true
help_wounded_enabled = true
corpse_detection_enabled = true
out_restr = script_zone_lonl_house
on_signal       = arriwed|walker@1


