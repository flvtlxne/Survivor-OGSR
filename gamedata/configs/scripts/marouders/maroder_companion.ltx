[smart_terrains]
none = true

[logic]
active = walker@start

[walker@start]
path_walk = radhill_pnt2_walk
path_look = radhill_pnt2_look
on_info = {+actor_has_lr300} companion@1 %=give_items(wpn_lr300)%
on_info2 = {+actor_has_ak74} companion@1 %=give_items(wpn_ak74)%
on_info3 = {+actor_has_aksu} companion@1 %=give_items(wpn_ak74u)%
on_info4 = {+actor_has_toz} companion@1 %=give_items(wpn_toz34)%
on_info5 = {+actor_has_bizon} companion@1 %=give_items(wpn_bizon)%
on_info6 = {+actor_has_sayga} companion@1 %=give_items(wpn_sayga)%
on_info7 = {+actor_has_mosin} companion@1 %=give_items(wpn_m1891)%
on_info8 = {-actor_has_toz -actor_has_lr300 -actor_has_ak74 -actor_has_aksu -actor_has_bizon -actor_has_sayga -actor_has_mosin} companion@1


[companion@1]
meet = meet@2
invulnerable = false
gather_items_enabled = false
help_wounded_enabled = true
corpse_detection_enabled = false
can_use_knife = false
on_info = {-actor_set_maroder} %=destroy_object%


; диалог обычный(без торговли):
[meet@2]
abuse = false
use = true
trade_enable = false
allow_break = true




