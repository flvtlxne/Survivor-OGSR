[smart_terrains]
none = true

[logic]
active = walker@start
on_death = death

[walker@start]
path_walk = sbu_comand1_look
path_look = kpp_ambush_mercs_look_pnt
on_info = {+actor_has_lr300} walker@1 %=give_items(wpn_lr300)%
on_info2 = {+actor_has_ak74} walker@1 %=give_items(wpn_ak74)%
on_info3 = {+actor_has_aksu} walker@1 %=give_items(wpn_ak74u)%
on_info4 = {-actor_has_lr300 -actor_has_ak74 -actor_has_aksu} walker@1


[walker@1]
path_walk = sbu_comand1_look
path_look = kpp_ambush_mercs_look_pnt
invulnerable = false
combat_ignore_cond = {=distance_to_obj_ge(kpp_merc_lider:40)} true
combat_ignore_keep_when_attacked = {=distance_to_obj_ge(kpp_merc_lider:40)} true
meet = no_meet
def_state_moving1 = sprint
def_state_moving2 = sprint
def_state_moving3 = sprint
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_info = {+kpp_sbu_dead !npc_in_actor_frustum} %=destroy_object%


[death]
on_info = %=inc_counter(kpp_mercs_helpers)%






