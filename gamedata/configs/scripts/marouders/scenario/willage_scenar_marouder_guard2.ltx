[smart_terrains]
none = true

[logic]
active = walker@start
on_death = death
on_hit = hit

[walker@start]
path_walk = willage_avtoritet_guard2_walk
path_look = willage_avtoritet_guard2_look
on_info = {+actor_has_lr300} remark@1 %=give_items(wpn_lr300)%
on_info2 = {+actor_has_ak74} remark@1 %=give_items(wpn_ak74)%
on_info3 = {+actor_has_aksu} remark@1 %=give_items(wpn_ak74u)%
on_info4 = {+actor_has_toz} remark@1 %=give_items(wpn_toz34)%
on_info5 = {+actor_has_bizon} walker@1 %=give_items(wpn_bizon)%
on_info6 = {+actor_has_mosin} walker@1 %=give_items(wpn_m1891)%
on_info7 = {-actor_has_toz -actor_has_lr300 -actor_has_ak74 -actor_has_aksu -actor_has_bizon -actor_has_mosin} walker@1

; Сначала ждём:
[remark@1]
anim = wait
target = story | script_zone_lonl_house
combat_ignore_cond = always
show_spot = false
on_actor_dist_le = 40|walker@alarm %=willage_scenario_maroders_alarm%
on_info = {+willage_scenario_maroders_alarm} walker@alarm
on_info2 = {+willage_avtoritet_on_place} walker@1

; Идём за главарём на точку:
[walker@1]
path_walk = willage_avtoritet_guard2_walk
path_look = willage_avtoritet_guard2_look
def_state_moving1 = assault
invulnerable = false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
combat_ignore_cond = true
on_info = {+willage_scenario_maroders_alarm} walker@alarm
on_actor_dist_le = 25|walker@alarm %=willage_scenario_maroders_alarm%


; Спугнули:
[walker@alarm]
path_walk = willage_avtoritet_guard2_walk
path_look = willage_avtoritet_guard2_look
def_state_moving1 = assault
invulnerable = false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
;combat_ignore_cond = false


[hit]
on_info = {=hit_by_actor} %=willage_scenario_maroders_alarm%

[death]
on_info = {=killed_by_actor} %=willage_scenario_maroders_alarm%











