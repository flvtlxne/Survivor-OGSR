[smart_terrains]
none = true

[logic]
active = walker@start
on_death = death

[walker@start]
path_walk = village_blackhole_zone_point2
path_look = village_blackhole_zone_point1
on_info = {+actor_has_lr300} walker@1 %=give_items(wpn_lr300)%
on_info2 = {+actor_has_ak74} walker@1 %=give_items(wpn_ak74)%
on_info3 = {+actor_has_aksu} walker@1 %=give_items(wpn_ak74u)%
on_info4 = {+actor_has_toz} walker@1 %=give_items(wpn_toz34)%
on_info5 = {+actor_has_bizon} walker@1 %=give_items(wpn_bizon)%
on_info6 = {-actor_has_toz -actor_has_lr300 -actor_has_ak74 -actor_has_aksu -actor_has_bizon} walker@1

[walker@1]
path_walk = village_blackhole_zone_point2
path_look = village_blackhole_zone_point1
invulnerable = true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
combat_ignore_cond = true
on_info = {+anomaly_maroder2_dead} walker@2 %=play_sound(anomaly_maroder1_snd)%

[walker@2]
path_walk = village_blackhole_zone_point2
path_look = village_blackhole_zone_point1
invulnerable = false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false



[death]
on_info = %=give_items(anomaly_maroder1_pda:af_baloon)%












