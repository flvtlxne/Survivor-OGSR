[smart_terrains]
none = true

[logic]
active = walker@start


[walker@start]
path_walk = kpp_merc_guard2_walk
path_look = kpp_merc_guard2_look
on_info = {+actor_has_lr300} walker@1 %=give_items(wpn_lr300) =actor_neutral%
on_info2 = {+actor_has_ak74} walker@1 %=give_items(wpn_ak74) =actor_neutral%
on_info3 = {+actor_has_aksu} walker@1 %=give_items(wpn_ak74u) =actor_neutral%
on_info4 = {-actor_has_lr300 -actor_has_ak74 -actor_has_aksu} walker@1 %=actor_neutral%

[walker@1]
path_walk = kpp_merc_guard2_walk
path_look = kpp_merc_guard2_look
invulnerable = true
combat_ignore_cond = true
meet = no_meet
def_state_moving1 = run
def_state_moving2 = run
def_state_moving3 = run
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_info = {+kpp_mercs_getlost} walker@2
on_info2 = {+kpp_mercs_agree} walker@3


; Обиделись на ГГ:
[walker@2]
path_walk = kpp_merc_guard2_walk
path_look = kpp_merc_guard2_look
invulnerable = false
meet = no_meet
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false


; Смотрим на агентов СБУ:
[walker@3]
path_walk = kpp_merc_guard2_walk
path_look = kpp_merc_guard2_look
invulnerable = true
meet = no_meet
combat_ignore_cond = true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_info = {+kpp_merc_heli_alarm} walker@4


; Сваливаем в бункер:
[walker@4]
path_walk = kpp_merc2_bunker_walk
path_look = kpp_mercs_bunker_look
invulnerable = true
meet = no_meet
combat_ignore_cond = true
def_state_moving1 = sprint
def_state_moving2 = sprint
def_state_moving3 = sprint
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_signal       = arriwed|walker@5


; В бункере:
[walker@5]
path_walk = kpp_merc2_bunker_walk
path_look = kpp_mercs_bunker_look
invulnerable = true
meet = no_meet
combat_ignore_cond = true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_info = {+kpp_mercs_ambush_atack} walker@6 %=actor_enemy%
on_info2 = {+kpp_sbu_atack} walker@6 %=actor_neutral%


; В последний бой:
[walker@6]
path_walk = kpp_merc2_bunker_walk
path_look = kpp_mercs_bunker_look
invulnerable = false
meet = no_meet
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_info = {+kpp_heli_dead} walker@7


; После боя:
[walker@7]
path_walk = sbu_comand3_walk
path_look = sbu_comand4_walk
invulnerable = true
meet = no_meet
combat_ignore_cond = true



