[smart_terrains]
none = true

[logic]
active = walker@start1
known_info = known_info
on_death = death
on_hit = hit

[known_info]
scenar_maroder_lider4_info


[walker@start1]
path_walk = kolhoz_pnt1_look
path_look = kolhoz_pnt1_walk
on_info = {+actor_has_vss} walker@start2 %=give_items(wpn_vintorez)%
on_info2 = {+actor_has_lr300} walker@start2 %=give_items(wpn_lr300)%
on_info3 = {+actor_has_aksu} walker@start2 %=give_items(wpn_ak74u)%
on_info4 = {+actor_has_toz} walker@start2 %=give_items(wpn_toz34)%
on_info5 = {+actor_has_mosin} walker@start2 %=give_items(wpn_m1891)%
on_info6 = {-actor_has_toz -actor_has_lr300 -actor_has_vss -actor_has_aksu -actor_has_mosin} walker@start2

[walker@start2]
path_walk = kolhoz_pnt1_look
path_look = kolhoz_pnt1_walk
def_state_moving1 = assault
invulnerable = false
gather_items_enabled = false
help_wounded_enabled = true
corpse_detection_enabled = false
out_restr = script_zone_workshop
combat_ignore_cond = {-workshop_scenar_maroder_hit =dist_to_actor_ge(100)} true
on_signal       = arriwed|walker@1


