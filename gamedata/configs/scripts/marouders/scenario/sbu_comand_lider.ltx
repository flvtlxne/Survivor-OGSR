[smart_terrains]
none = true

[logic]
active = {+kpp_mercs_ambush_atack} walker@4, walker@start


[walker@start]
path_walk = sbu_comand1_walk
path_look = sbu_comand1_look
on_info = {+actor_has_ak74} walker@1 %=give_items(wpn_ak74) =actor_neutral%
on_info2 = {+actor_has_aksu} walker@1 %=give_items(wpn_ak74u) =actor_neutral%
on_info3 = {-actor_has_ak74 -actor_has_aksu} walker@1 %=actor_neutral%


[walker@1]
path_walk = sbu_comand1_walk
path_look = sbu_comand1_look
def_state_moving1 = sprint
def_state_moving2 = sprint
def_state_moving3 = sprint
invulnerable = true
meet = no_meet
combat_ignore_cond = true
gather_items_enabled = false
help_wounded_enabled = true
corpse_detection_enabled = false
on_signal       = arriwed|walker@2

; Перед бункером:
[walker@2]
path_walk = sbu_comand1_walk
path_look = sbu_comand1_look
def_state_moving1 = run
invulnerable = true
meet = meet@sbu_comand1
combat_ignore_cond = true
gather_items_enabled = false
help_wounded_enabled = true
corpse_detection_enabled = false
on_info = {+kpp_sbu_see_ambush2} walker@3

[walker@3]
path_walk = sbu_comand1_walk
path_look = sbu_comand1_look
invulnerable = true
meet = no_meet
combat_ignore_cond = true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_info = {+kpp_sbu_atack} walker@5
on_info2 = {+kpp_mercs_ambush_atack} walker@4


; ГГ атаковал наёмников:
[walker@4]
path_walk = sbu_comand1_walk
path_look = sbu_comand1_look
def_state_moving1 = run
invulnerable = true
meet = no_meet
gather_items_enabled = false
help_wounded_enabled = true
corpse_detection_enabled = false
can_use_knife = false
on_game_timer = 1000|remark@wounded1

; Ранение:
[remark@wounded1]
anim = wounded_heavy_3
;target = path | lonl_house_pnt5_1_look, 0
target = story | actor
combat_ignore_cond = true
combat_ignore_keep_when_attacked = true
invulnerable = true
meet = no_meet
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
can_use_knife = false
on_info = {+kpp_mercs_dead} remark@wounded2 %=actor_friend%

[remark@wounded2]
anim = hello
target = story | actor
combat_ignore_cond = true
combat_ignore_keep_when_attacked = true
invulnerable = true
meet = meet@sbu_comand1
gather_items_enabled = false
help_wounded_enabled = true
corpse_detection_enabled = false


; ГГ атаковал СБУ(сваливаем к переходу):
[walker@5]
path_walk = maroders_escape_point1
path_look = lonl_house_pnt5_1_look
def_state_moving1 = sprint
def_state_moving2 = sprint
def_state_moving3 = sprint
invulnerable = true
meet = no_meet
wounded = wounded@no_wound
combat_ignore_cond = true
combat_ignore_keep_when_attacked = true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
can_use_knife = false
on_signal       = arriwed|%=destroy_object%


[wounded@no_wound]
hp_state = 0 | wounded_heavy@help_heavy
hp_state_see = 0 | wounded_heavy@help_heavy
hp_victim = 0 | nil
hp_cover = 0 | false
hp_fight = 0 | false


[meet@sbu_comand1]
abuse = false
use = true
trade_enable = false
allow_break = true















