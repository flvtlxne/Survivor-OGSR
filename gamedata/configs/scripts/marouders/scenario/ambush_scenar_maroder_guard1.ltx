[smart_terrains]
none = true

[logic]
active = walker@start
on_death = death

[walker@start]
path_walk = willage_maroder_guard1_walk
path_look = willage_maroder_guard_look
on_info = {+actor_has_lr300} walker@1 %=give_items(wpn_lr300)%
on_info2 = {+actor_has_ak74} walker@1 %=give_items(wpn_ak74)%
on_info3 = {+actor_has_aksu} walker@1 %=give_items(wpn_ak74u)%
on_info4 = {+actor_has_toz} walker@1 %=give_items(wpn_toz34)%
on_info5 = {+actor_has_bizon} walker@1 %=give_items(wpn_bizon)%
on_info6 = {+actor_has_mosin} walker@1 %=give_items(wpn_m1891)%
on_info7 = {-actor_has_toz -actor_has_lr300 -actor_has_ak74 -actor_has_aksu -actor_has_bizon -actor_has_mosin} walker@1

[walker@1]
path_walk = willage_maroder_guard1_walk
path_look = willage_maroder_guard_look
def_state_moving1 = walk
invulnerable = true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
combat_ignore_cond = true
on_info = {+maroders_ambush_end} remark@guard_actor


[remark@guard_actor]
anim = guard_na
target = story | actor
combat_ignore_cond = {!actor_has_item(wpn_knife)} true
meet = no_meet
invulnerable = false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_game_timer = 250|walker@2 %=play_sound(marodr_guard_aktor_kill1)%


; Теперь мочим актора:
[walker@2]
path_walk = willage_maroder_guard1_walk
path_look = willage_maroder_guard_look
def_state_moving1 = walk
invulnerable = false
combat_ignore_cond = {!actor_has_item(wpn_knife)} true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_game_timer = 150|walker@3 %=play_sound(marodr_guard_aktor_kill2)%

[walker@3]
path_walk = willage_maroder_guard1_walk
path_look = willage_maroder_guard_look
def_state_moving1 = walk
invulnerable = false
combat_ignore_cond = {!actor_has_item(wpn_knife)} true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_game_timer = 250|walker@4 %=play_sound(marodr_guard_aktor_kill2) =ambush_marodr_guard_weapons_remowe%

[walker@4]
path_walk = willage_maroder_guard1_walk
path_look = willage_maroder_guard_look
def_state_moving1 = walk
invulnerable = false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false


[death]
on_info = %=give_items(medkit:bandage:ammo_12x70_buck)%












