[smart_terrains]
none = true

[logic]
active = walker@1
on_death = death

[walker@start]
path_walk = zavhoz_friend_point1
path_look = zavhoz_friend_point2
on_info = {+actor_has_lr300} walker@1 %=give_items(wpn_lr300)%
on_info2 = {+actor_has_ak74} walker@1 %=give_items(wpn_ak74)%
on_info3 = {+actor_has_aksu} walker@1 %=give_items(wpn_ak74u)%
on_info4 = {+actor_has_toz} walker@1 %=give_items(wpn_toz34)%
on_info5 = {+actor_has_bizon} walker@1 %=give_items(wpn_bizon)%
on_info6 = {-actor_has_toz -actor_has_lr300 -actor_has_ak74 -actor_has_aksu -actor_has_bizon} walker@1

[walker@1]
path_walk = zavhoz_friend_point1
path_look = zavhoz_friend_point2
invulnerable = true
def_state_moving1 = sprint
def_state_moving2 = sprint
def_state_moving3 = sprint
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
combat_ignore_cond = true
can_use_knife = false
meet = no_meet
combat_ignore_keep_when_attacked = true
on_info = {+zavhoz_friend_mob_dead} remark@end1
on_signal	= arriwed|walker@2 %=play_sound(panic_monster_bandit)%

[walker@2]
path_walk = zavhoz_friend_point2
path_look = zavhoz_friend_point1
invulnerable = true
def_state_moving1 = sprint
def_state_moving2 = sprint
def_state_moving3 = sprint
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
combat_ignore_cond = true
can_use_knife = false
meet = no_meet
combat_ignore_keep_when_attacked = true
on_info = {+zavhoz_friend_mob_dead} remark@end1
on_signal	= arriwed|walker@1 %=play_sound(panic_monster_bandit)%


[remark@end1]
anim = hands_up
target = story | actor
combat_ignore_cond = true
meet = no_meet
invulnerable = true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
can_use_knife = false
meet = meet@2
on_info = {+zavhoz_friend_info} remark@end2

[remark@end2]
anim = hands_up
target = story | actor
combat_ignore_cond = true
meet = no_meet
invulnerable = false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
can_use_knife = false
meet = no_meet
on_actor_dist_ge_nvis = 45|%=destroy_object%


[meet@2]
abuse = false
use = true
trade_enable = false
allow_break = true


[death]
on_info = %+zavhoz_friend_dead%












