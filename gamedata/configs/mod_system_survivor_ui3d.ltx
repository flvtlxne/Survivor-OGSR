; Survivor: per-item settings of the 3D icons ([ui3d_cell_icons] in external.ltx; engine ui/UICellItem.cpp, ui/UIModel.cpp).
; DLTX: ![sect] changes a section (see mod_system_survivor_s2wp.ltx).

; === orientation. ui3d_icon_cell: the cell shape the model is oriented for (its longest axis along the longer side); the cell stays
; novice jacket: a 2x2 cell (the 2D icon's), the folded coat lay on its side; oriented as the other outfits' 2x3,
; then turned upright (ui3d_icon_turn from the editor, _appdata_\ui3d_icon_fixes.ltx)
![novice_outfit]
ui3d_icon_cell = 2, 3
ui3d_icon_turn = 0, 0, 180

; === 2D icons for the items whose world model is a stand-in (another item's model). ui3d_icon = false: the cell keeps the 2D icon.
; Remove an item from here once it gets its own model.

; --- misc/items.ltx: model box_kanifol
![firewood]
ui3d_icon = false

![wood_log]
ui3d_icon = false

