;---------------------------------------
; настройки для разных рангов НПС
; добавка урона при ударе

[novice]
addhit_actor = 0.5
addhit_stalker = 0
addhit_mutant = 0.1

[experienced]
addhit_actor = 1
addhit_stalker = 0
addhit_mutant = 0.2

[veteran]
addhit_actor = 2
addhit_stalker = 0.1
addhit_mutant = 0.4

[master]
addhit_actor = 3
addhit_stalker = 0.5
addhit_mutant = 1

;---------------------------------------
; настройки для разных группировок

[stalker]
courage = 0.95		; чтобы идти в атаку с ножом, нужна смелость
mutant_hunt = true	; можно ли охотиться на монстров

[bandit]
courage = 1.4
mutant_hunt = true

[freedom]
courage = 1.3
mutant_hunt = true

[dolg]
courage = 1
mutant_hunt = true

[killer]
courage = 0.75
mutant_hunt = true

[army]
courage = 0.8
mutant_hunt = true

[monolith]
courage = 1.4
mutant_hunt = true


