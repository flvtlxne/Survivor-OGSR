[main]
weapon_to_spawn = wpn_knife			; секция ножа для выдачи
spawn_chance = 1.0			; шанс на выдачу новенькому сталкеру ножа
forbidden_factions = zombied,ecolog,trader	; группировки, для которых схема будет отключена

[forbidden_npcs]	; имена НПС, для которых схема будет отключена (name,section,profile_name)
mechanical_npc1,sbu_comand_lider,kpp_merc_lider

;---------------------------------------
; список классов, на которых разрешено применение
; тип существа = минимально требуемая величина courage

[attack_courage]
actor		= 25
stalker		= 40
bloodsucker	= 60
boar		= 40
burer		= 60
;cat		= 40
;chimera	= 90
;controller	= 80
dog		= 40
flesh		= 35
;fracture	= 50
giant		= 75
;poltergeist	= 65
pseudodog	= 55
psy_dog		= 45
;psy_dog_phantom = 40
snork		= 60
;tushkano	= 30
;zombie		= 55

