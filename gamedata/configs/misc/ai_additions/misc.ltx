;--------------------------------------
; Rulix aka Bak
; Настройки разных модулей
;--------------------------------------

[aim]
ai_aim_max_angle 1.1
ai_aim_min_angle 0.06
ai_aim_min_speed 0.4
ai_aim_predict_time 0.2

[sound]	; вероятности отыгрывания звука
death_probability		= 40	;%
friendlyfire_probability	= 50	;%
grenade_probability		= 20	;%

[npc_eating]
enabled			= off		; дублирует схему bandage
excluded_communities	= zombied
excluded_npcs		= none
medkit_health		= 60		; кушаем аптечку если здоровье меньше, %
bandage_bleeding	= 0.2		; кушаем бинт, если кровотечение больше
medkits = medkit,medkit_army,medkit_scientic ; аптечки или то чем можно лечиться
bandages = bandage			; бинты
in_combat		= false		; лечиться в бою
out_combat		= true		; лечиться вне боя
delay			= 14000,26000	; мин. и максимальная задержка перед лечением

; дублирует аналогичную движковую фичу, см. параметры holder_range_modifier,holder_fov_modifier
[look_into_os]
enabled			= off
excluded_communities	= zombied
excluded_npcs		= none
; для 2x оптики
range_add		= 30		; %
fov_add			= -20		; %


;--------------------------------------
; Модуль rx_addons
;--------------------------------------

[addons]
check_period = 350 ;90		;сек ; время между подходами
forbidden_factions = zombied,trader	; (community)
forbidden_npcs = none
online_mode = true		; возможность работы в онлайне, иначе это будет происходить при переходе в офлайн

;надевание аддонов
addons = on			; включить
max_upg_weapons = 3		; максимальное количество пушек с аддонами

; апгрейды оружия
upgrades = on			; включить
up_chance_base = 30		; % ; шанс сделать апгрейд, минимальный
up_chance_rank_factor = 0.4	; увеличение шанса с ростом ранга (1.0 -> +100% для мастера)
up_price_k = 0.2		; коэффициент стоимости апгрейда для НПС

; продажа лишнего оружия
surplus_sales = on		; включить
no_sale_items = af_compass	; список запрещённых к продаже предметов


;--------------------------------------
; Настройки модуля rx_ff
;--------------------------------------

[ff]
forbidden_factions = zombied,monolith	; название группировки
forbidden_npcs = mechanical_npc1		; имя персонажа


;--------------------------------------
; Настройки модуля rx_reload
;--------------------------------------

[reload]
enabled = false				; включить
reload_one = false			; перезаряжать только текущее оружие
elapsed_percent = 75			; процент загруженности магазина, при котором перезарядка не требуется
clean_gun = 10				; чинить оружие при перезарядке на % состояния



