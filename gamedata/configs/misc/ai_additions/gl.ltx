;--------------------------------------
; Модуль grenade launch
; Rulix aka Bak
;--------------------------------------

[main]
check_period		= 1500	;мс ; время между проверками
check_period_covert	= 3700	;мс ; время между проверками
forbidden_factions	= zombied	; группировки, для которых схема будет отключена (community)
forbidden_npcs		= none	; имена, профили НПС, для которых схема будет отключена (name,profile_name)
min_dist		= 11	; минимальное расстояние выстрела
max_dist		= 95	; максимальное расстояние выстрела
; значение уменьшено, так как в оригинале ЗП очень низкая скорость запуска гранаты
; при возвращении адекватной скорости необходимо увеличить max_dist !
spawn_ammo		= true	; автоматически спавнить гранаты
aim_be_only		= false ; стрелять только по лучшему врагу, или же выбирать любую доступную цель


; настройки для разных рангов НПС

[novice]
aim_time	= 4500		;мс ; время прицеливания на 100 метров, линейная интерполяция начиная от 0
reload_time	= 2100		;мс ; время, затрачиваемое на перезарядку
repose_time	= 5000		;мс ; минимальная пауза между двумя выстрелами
accuracy	= 0		;%  ; точность; 100 - отклонение отсутствует; допустимы отрицательные значения

[experienced]
aim_time	= 3000
reload_time	= 1500
repose_time	= 5000
accuracy	= 40

[veteran]
aim_time	= 2000
reload_time	= 1000
repose_time	= 5000
accuracy	= 60

[master]
aim_time	= 600
reload_time	= 1000
repose_time	= 5000
accuracy	= 90
