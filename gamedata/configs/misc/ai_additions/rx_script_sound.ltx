[list]	; список тем для загрузки
gl_fire			= rx_gl
knife_attack		= rx_knife
knife_attack_mutant	= rx_knife
monster_defend		= rx_knife
enemy_death		= rx_knife
kill_wounded		= rx_kill_wounded

friendly_fire
friendly_grenade
npc_hit
;enemy_hit


[mute_characters] ; имена НПС без озвучки (name,profile_name) (чтобы персонажи с уникальным голосом не говорили стандартной озвучкой)
all_story
mechanical_npc1


[example]			; описание параметров
sound = sound_die		; движковый айди звука (из stalker_ids); Для проигрывания стандартных движковых фраз
path = fight\fire\fire_		; путь к набору фраз (или к единичному звуку)
idle = 20,40,80			; минимальная пауза между фразами, максимальная пауза, вероятность воспроизведения
avail_communities = stalker, dolg	; список группировок, для которых доступна озвучка ; по умолчанию разрешено для всех
is_combat_sound = true		; это зачем? - по-видимому для возбуждения услышавших звук на врага говорящего
delay_sound = 100,500		; задержка проигрывания звука в миллисекундах ; минимальная, максимальная
npc_prefix = false		; использовать префикс персонажа в пути к звуку, по умолчанию true
shuffle = seq			; способ выбора звука: rnd - случайно, seq - последовательно, loop - последовательно с повторением ; по умолчанию rnd
group_snd = true		; групповой звук - может говорить только 1 персонаж одновременно
pda_snd = true			; проигрывать также звук по рации для игрока, если есть (.."_pda.ogg")
type = talk			; тип звука (snd_type), определяет реакцию персонажей, по умолчанию monster_talk


[gl_fire]
path = fight\fire\fire_
idle = 20,40,80
is_combat_sound = true

[knife_attack]
path = fight\threat\threat_close_
idle = 6,15,70
is_combat_sound = true
delay_sound = 300,1100

[knife_attack_mutant]
path = fight\threat\threat_distant_
idle = 5,20,70
is_combat_sound = true
delay_sound = 1000

[monster_defend]
path = states\panic_monster\panic_monster_
idle = 6,16,70
is_combat_sound = true

[npc_hit]
sound = sound_injuring
idle = 3,6,60
is_combat_sound = true

[friendly_fire]
sound = sound_injuring_by_friend
idle = 2,5,100

[friendly_grenade]
sound = sound_friendly_grenade_alarm
idle = 10,30,100

[enemy_hit]
sound = sound_enemy_critically_wounded
idle = 5,10,100

[enemy_death]
sound = sound_enemy_killed_or_wounded
idle = 5,10,70
delay_sound = 400

[kill_wounded]
sound = sound_kill_wounded
idle = 4,6,100

; check end

