;================Profiles================

[default]
min_loot_distance	= 8		; Всегда собирать вещи, ближе чем эта дистанция
max_loot_distance	= 45		; Максимальное расстояние поиска
min_loot_value		= 100		; Минимальная ценность предмета, за которым будет ходить дальше min_loot_distance
max_loot_value		= 5000		; Максимальнно требуемая ценность предмета (на max_loot_distance)
walk_dist		= 3.7		; Расстояние перехода на шаг (ближе - шагаем, дальше - бежим)

meet			= false		; прерывать шмон при разговоре
leisurely		= false		; собираем вещички не спеша (не бегать)
keep_actor_haul		= false		; Не трогать чуваков, убитых игроком
loot_items		= true		; собирать предметы с пола
loot_stalker		= true		; обыскивать трупы людей
loot_mutant		= false		; чикибрикать монстров ( на ЗП недоступно по известным причинам )

gather_items_enabled	= true		; собирать выбранное движком оружие (best_item) (расстояние не ограничено)
take_artefacts		= true		; брать артефакты
take_best_weapons_only	= false		; брать только оружие лучше своего
take_useful_items_only	= false		; брать только предметы из списка useful_items (помимо оружия и артефактов)


[story]	; ограничения для НПС со story_id
;meet			= true		; прерывать шмон при разговоре
gather_items_enabled	= false		; собирать выбранное движком оружие
max_loot_distance	= 30		; Будет выбирать только вещи, ближе чем эта дистанция
min_loot_value		= 1000		; Минимальная ценность предмета, за которым будет ходить дальше min_loot_distance
max_loot_value		= 9000		; Максимальнно требуемая ценность предмета (на max_loot_distance)


