[main]
check_period		= 5000		; мс ; время между проверками
knife_req_to_loot_monster = false	; обязательно ли наличие ножа для добычи частей у монстров
detector_req_to_loot_artefacts = true	; обязательно ли наличие детектора для поиска артефактов
take_quest_items	= false		; можно ли собирать квестовые предметы
take_secret_items	= true		; можно ли собирать предметы из тайников
min_weapon_condition	= 0.1		; при состоянии ниже оружие не брать
excluded_communities	= zombied	; названия группировок, которым будет запрещено лутать (character_community)


