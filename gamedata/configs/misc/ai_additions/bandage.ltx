spawn_random = false		; спавнить случайный предмет или первый из списка?

forbidden_npcs	= mechanical_npc1,sbu_comand_lider,maroder_killer1,maroder_killer2,maroder_killer3,maroder_killer4,maroder_courier1,maroder_courier2,maroder_courier3,maroder_courier4,btr_maroder7,marouder_lider3,lake_scenar_marouder_lider,willage_scenar_marouder_lider		;имена, профили НПС, для которых схема будет отключена (name,profile_name)
forbidden_factions = zombied	; группировки, для которых схема будет отключена (community)
