; Соборанный ремкомплект для автомобилей
[car_remkit]:identity_immunities
GroupControlSection	= spawn_group
discovery_dependency=
$spawn 				= "devices\dev_flash_2"
$prefetch 			= 16
class				= D_PDA
cform				= skeleton
visual				= dynamics\equipments\quest\box_transistors.ogf

inv_grid_width		= 2
inv_grid_height		= 2
inv_grid_x			= 10
inv_grid_y			= 25

slot				= 7
radius				= 50
default_to_ruck		= false
inv_weight			= 2.5

inv_name			= car_remkit_name
inv_name_short		= car_remkit_name
description			= car_remkit_descr
cost				= 800
can_trade			= true
quest_item     		= false




