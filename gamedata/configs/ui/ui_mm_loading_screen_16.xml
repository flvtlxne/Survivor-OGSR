<w>
	<!-- Survivor: stencil-style loading screen. The level picture is drawn first, under the background. -->
	<loading_logo x="0" y="0" width="1024" height="768" stretch="1" under_background="1"/>

	<background x="0" y="0" width="1024" height="768">
		<auto_static x="0" y="0" width="1024" height="190" stretch="1">
			<texture>surv_grad_up</texture>
		</auto_static>
		<auto_static x="0" y="400" width="1024" height="368" stretch="1">
			<texture>surv_grad_dn</texture>
		</auto_static>
		<auto_static x="40" y="36" width="200" height="80" stretch="1">
			<texture>surv_logo</texture>
		</auto_static>
	</background>

	<loading_progress_background x="40" y="726" width="944" height="3" stretch="1">
		<texture>surv_track</texture>
	</loading_progress_background>

	<loading_progress x="40" y="726" width="944" height="3" horz="1" min="0" max="100" pos="0" inertion="5.0" under_background="0">
		<progress stretch="1">
			<texture>surv_fill</texture>
		</progress>
	</loading_progress>

	<loading_progress_percent x="884" y="698" width="100" height="22">
		<text font="ui_font_surv_btn_s" r="214" g="209" b="196" align="r" vert_align="c"/>
	</loading_progress_percent>

	<loading_stage x="40" y="698" width="600" height="22">
		<text font="ui_font_surv_small" r="165" g="160" b="148" align="l" vert_align="c"/>
	</loading_stage>

	<loading_header x="40" y="588" width="640" height="26">
		<text font="ui_font_surv_btn_s" r="201" g="168" b="76" align="l" vert_align="c"/>
	</loading_header>

	<loading_tip_number x="40" y="616" width="640" height="22">
		<text font="ui_font_surv_small" r="165" g="160" b="148" align="l" vert_align="c"/>
	</loading_tip_number>

	<loading_tip x="40" y="640" width="560" height="56" complex_mode="1">
		<text font="ui_font_surv_small" r="214" g="209" b="196" align="l"/>
	</loading_tip>
</w>
