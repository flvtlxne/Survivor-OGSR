--// А тут у нас устаревший кусок 

function wait_manager(time_to_wait, type)
	verify_if_thread_is_running()
	if time_to_wait == nil then
	   coroutine.yield()
	else
	   while type <= game.time() + time_to_wait do
	     coroutine.yield()
	   end
     end
end

function wait_game(time_to_wait)
 wait_manager(time_to_wait, game.time())
end

function wait(time_to_wait)
 wait_manager(time_to_wait, time_global())
end
