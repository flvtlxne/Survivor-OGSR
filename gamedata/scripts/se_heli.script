---------------------------------------------------------------------
--'Helicopter
class "se_heli" (cse_alife_helicopter)
--------------------
function se_heli:__init (section) super (section)
end

function se_heli:on_register()
	cse_alife_helicopter.on_register(self)
	-- Survivor: у всех вертолётов mg_start_heli* в all.spawn один story_id.
	-- Как и раньше, он достаётся последнему зарегистрированному, только без ABORT в логе.
	local registry = story_objects.get_story_objects_registry()
	local old_id = registry.id_by_story_id["mg_start_heli"]
	if old_id ~= nil and old_id ~= self.id and string.find(self:name(), "^mg_start_heli") then
		registry:unregister_by_story_id("mg_start_heli")
	end
	story_objects.check_spawn_ini_for_story_id(self)
end

function se_heli:on_unregister()
	unregister_story_object_by_id(self.id)
	cse_alife_helicopter.on_unregister(self)
end

function se_heli:keep_saved_data_anyway()
	return true
end