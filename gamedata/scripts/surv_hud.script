--[[ ----------------------------------------------------------------------------------------------
 File       : surv_hud.script
 Description: Survivor HUD parts that the engine HUD has no place for:
              - title of the active task right of the minimap (while Tab is held); the task
                description (engine static "secondary_task", shown while Tab is held) is moved
                under it;
              - health number right of the health bar;
              - the dog block above the state icons while the dog is near;
              - grenade frame left of the weapon frame (knife, gun or grenade in the hands):
                grenade in slot 4, count, key;
              - compass at the bottom centre: heading, cardinal letters, ticks and the target of
                the active task (marker, distance, the name when the target is a person);
                with the minimap off (console hud_minimap 0, option «Миникарта») also the PDA
                contacts the minimap would show: stalkers by relation with the distance (names of
                neutrals and friends) and bodies;
              - with the minimap off the task title moves to the left edge.
              The parts are described in ui_surv_hud(_16).xml and hang on the custom static
              "surv_hud" (ui_custom_msgs.xml). update() runs every frame from
              module_dynamic_update.script.
--]] ----------------------------------------------------------------------------------------------

local XML_FILE  = "ui_surv_hud.xml"
local HOLDER    = "surv_hud"
local SLOW_MS   = 250          -- heavier lookups (task, dog, grenades) run this often
local DOG_DIST2 = 30 * 30      -- the dog block is shown closer than this (squared metres)
local GREN_SLOT = 4
-- inventory icon cell in ui_icon_equipment, pixels: [features] icon_equipments_cell_size, as in the engine
local GRID      = system_ini():line_exist("features", "icon_equipments_cell_size")
                  and system_ini():r_float("features", "icon_equipments_cell_size") or 50

local C_TITLE   = {255, 238, 198, 86}
local C_NOTASK  = {255, 165, 160, 148}
local C_TEXT    = {255, 214, 209, 196}
local C_LOW     = {255, 196, 82, 66}
local C_DOG     = {{0.5, {146, 170, 116}}, {0.25, {214, 140, 64}}, {-1, {196, 82, 66}}}

local PARTS = {"task_diamond", "task_title", "task_descr", "health_num",
               "dog_name", "dog_bar_back", "dog_bar",
               "gren_frame", "gren_icon", "gren_count", "gren_key"}

local ui            -- the statics; nil until built and again when the engine drops custom statics
local cache = {}    -- last values given to the statics, so they are touched only on change
local next_slow = 0
local task_title    -- title of the active task, nil when there is none
local gren_ready    -- a grenade is in slot 4 and its frame is filled in
local WEAPON_SLOTS = {[1] = true, [2] = true, [3] = true, [4] = true, [13] = true}   -- knife, weapon 1, weapon 2, grenade, pistol

local CMP_FOV     = 120        -- degrees shown across the compass line
local CMP_STEP    = 15         -- a tick every 15 degrees, taller every 45
local CMP_TICKS   = 10         -- pools: ticks and letters that can be on the line at once
local CMP_LETTERS = 3
local CMP_CARDINAL = {[0] = "N", [90] = "E", [180] = "S", [270] = "W"}
local C_ARROW     = 0          -- texture colours, set in build()
local C_ARROW_HI  = 0
local cmp_target  -- {pos = vector, name = string or nil, id = number or nil} of the active task's target

-- PDA contacts on the compass while the minimap is off; the rules are the minimap's (engine
-- CPda::feel_touch_*, CRelationMapLocation::Update): stalkers within the PDA radius while a PDA is in
-- its slot; enemies only while the actor sees them; bodies only within 3 m of height
local CMP_NPC_MAX = 16         -- markers at once (the nearest)
local CMP_LBL_MAX = 8          -- distance/name labels at once (the ones nearest to the centre of the line)
local PDA_SLOT    = 8
local PDA_R2      = (system_ini():line_exist("device_pda", "radius") and system_ini():r_float("device_pda", "radius") or 50) ^ 2
local DEAD_DY     = 3
local C_REL       = {friend = {120, 210, 90}, neutral = {238, 198, 86}, enemy = {235, 70, 50}, dead = {225, 222, 212}}
local TASK_X_NO_MAP = 12       -- left edge of the task title when the minimap is off
local minimap_on  = true
local cmp_npcs    = {}         -- {id, kind, name} of the contacts, nearest first
local lbl_used    = {}         -- x of the labels placed this frame
local cmp_dist_fmt = "%d"   -- "%d m", from the string table
local V = vector2()            -- reused for SetWndPos / SetWndSize

local function set_text(key, st, text)
	if cache[key] ~= text then
		cache[key] = text
		st:TextControl():SetText(text)
	end
end

local function set_text_color(key, st, c)
	if cache[key] ~= c then
		cache[key] = c
		st:SetTextColor(c[1], c[2], c[3], c[4])
	end
end

local function show(st, on)
	if st:IsShown() ~= on then
		st:Show(on)
	end
end

local function build(hud)
	if hud:GetCustomStatic(HOLDER) then
		hud:RemoveCustomStatic(HOLDER)   -- left from before a script reload: its parts are not ours
	end
	local holder = hud:AddCustomStatic(HOLDER, true):wnd()
	local xml = CScriptXmlInit()
	xml:ParseFile(XML_FILE)
	ui = {holder = holder}
	for _, name in ipairs(PARTS) do
		ui[name] = xml:InitStatic(name, holder)
	end

	local p = ui.task_descr:GetWndPos()
	ui.descr_pos = vector2():set(p.x, p.y)
	ui.descr_pos0 = vector2():set(p.x, p.y)
	ui.task_descr:Show(false)
	p = ui.task_diamond:GetWndPos()
	ui.diamond_pos0 = vector2():set(p.x, p.y)
	p = ui.task_title:GetWndPos()
	ui.title_pos0 = vector2():set(p.x, p.y)

	ui.dog_w, ui.dog_h = ui.dog_bar:GetWidth(), ui.dog_bar:GetHeight()

	p = ui.gren_icon:GetWndPos()
	ui.icon_box = {x = p.x, y = p.y, w = ui.gren_icon:GetWidth(), h = ui.gren_icon:GetHeight()}
	ui.gren_icon:InitTexture("ui\\ui_icon_equipment")
	ui.gren_icon:SetStretchTexture(true)

	-- compass: fixed parts, then pools of ticks and letters, the target parts on top
	for _, name in ipairs({"compass_line", "compass_cap_l", "compass_cap_r", "compass_arrow_l", "compass_arrow_r"}) do
		ui[name] = xml:InitStatic(name, holder)
	end
	ui.cmp_ticks, ui.cmp_letters = {}, {}
	for i = 1, CMP_TICKS do
		ui.cmp_ticks[i] = xml:InitStatic("compass_tick", holder)
		ui.cmp_ticks[i]:Show(false)
	end
	for i = 1, CMP_LETTERS do
		ui.cmp_letters[i] = xml:InitStatic("compass_letter", holder)
		ui.cmp_letters[i]:Show(false)
	end
	ui.cmp_npc, ui.cmp_npc_name, ui.cmp_npc_dist = {}, {}, {}
	for i = 1, CMP_NPC_MAX do
		ui.cmp_npc[i] = xml:InitStatic("compass_npc", holder)
		ui.cmp_npc[i]:Show(false)
	end
	for i = 1, CMP_LBL_MAX do
		ui.cmp_npc_name[i] = xml:InitStatic("compass_npc_name", holder)
		ui.cmp_npc_dist[i] = xml:InitStatic("compass_npc_dist", holder)
		ui.cmp_npc_name[i]:Show(false)
		ui.cmp_npc_dist[i]:Show(false)
	end
	for _, name in ipairs({"compass_center", "compass_marker", "compass_name", "compass_dist"}) do
		ui[name] = xml:InitStatic(name, holder)
	end
	ui.npc_w, ui.npc_y = ui.cmp_npc[1]:GetWidth(), ui.cmp_npc[1]:GetWndPos().y
	ui.npc_name_w, ui.npc_name_y = ui.cmp_npc_name[1]:GetWidth(), ui.cmp_npc_name[1]:GetWndPos().y
	ui.npc_dist_w, ui.npc_dist_y = ui.cmp_npc_dist[1]:GetWidth(), ui.cmp_npc_dist[1]:GetWndPos().y
	ui.npc_lbl_gap = ui.npc_name_w * 0.55   -- a label closer than this to a placed one is not shown
	p = ui.compass_line:GetWndPos()
	ui.cmp_x0, ui.cmp_w, ui.cmp_y = p.x, ui.compass_line:GetWidth(), p.y
	ui.cmp_tick_w, ui.cmp_tick_h = ui.cmp_ticks[1]:GetWidth(), ui.cmp_ticks[1]:GetHeight()
	ui.cmp_tick_y = ui.cmp_ticks[1]:GetWndPos().y
	ui.cmp_letter_w, ui.cmp_letter_y = ui.cmp_letters[1]:GetWidth(), ui.cmp_letters[1]:GetWndPos().y
	ui.cmp_marker_w, ui.cmp_marker_y = ui.compass_marker:GetWidth(), ui.compass_marker:GetWndPos().y
	ui.cmp_name_w, ui.cmp_name_y = ui.compass_name:GetWidth(), ui.compass_name:GetWndPos().y
	ui.cmp_dist_w, ui.cmp_dist_y = ui.compass_dist:GetWidth(), ui.compass_dist:GetWndPos().y
	C_ARROW = ui.compass_arrow_l:GetTextureColor()
	C_ARROW_HI = GetARGB(255, 238, 198, 86)
	ui.compass_marker:Show(false)
	ui.compass_name:Show(false)
	ui.compass_dist:Show(false)

	for _, name in ipairs(PARTS) do
		if name ~= "task_descr" then
			ui[name]:Show(false)
		end
	end
	cache = {}
	next_slow = 0
end

local function hud_visible()
	if not (db.actor and db.actor:alive()) then
		return false
	end
	if not get_console():get_bool("hud_draw") then
		return false
	end
	if level.game_indicators_shown and not level.game_indicators_shown() then
		return false
	end
	return level.main_input_receiver() == nil
end

-------------------------------------------------------------------------------------------------
-- slow part

local function active_task()
	local tm = task_manager.get_task_manager()
	for _, v in pairs(tm.task_info) do
		if v.t and db.actor:is_active_task(v.t) then
			return v
		end
	end
end

local function update_dog()
	local dog = get_story_object("personal_dog")
	local near = dog ~= nil and dog:alive() and dog:position():distance_to_sqr(db.actor:position()) <= DOG_DIST2
	show(ui.dog_name, near)
	show(ui.dog_bar_back, near)
	show(ui.dog_bar, near)
	if not near then
		return
	end
	local hp = math.max(0, math.min(1, dog.health))
	ui.dog_bar:SetWndSize(vector2():set(ui.dog_w * hp, ui.dog_h))
	for _, lvl in ipairs(C_DOG) do
		if hp > lvl[1] then
			if cache.dog_col ~= lvl then
				cache.dog_col = lvl
				ui.dog_bar:SetTextureColor(GetARGB(255, lvl[2][1], lvl[2][2], lvl[2][3]))
			end
			break
		end
	end
end

local function set_grenade_icon(sect)
	local ini = system_ini()
	local gx, gy = ini:r_float(sect, "inv_grid_x"), ini:r_float(sect, "inv_grid_y")
	local gw = ini:line_exist(sect, "inv_grid_width") and ini:r_float(sect, "inv_grid_width") or 1
	local gh = ini:line_exist(sect, "inv_grid_height") and ini:r_float(sect, "inv_grid_height") or 1
	ui.gren_icon:SetTextureRect(Frect():set(gx * GRID, gy * GRID, (gx + gw) * GRID, (gy + gh) * GRID))
	-- keep the icon's proportions inside its box
	local b = ui.icon_box
	local w, h = b.w, b.h
	if gw > gh then
		h = b.h * gh / gw
	elseif gh > gw then
		w = b.w * gw / gh
	end
	ui.gren_icon:SetWndPos(vector2():set(b.x + (b.w - w) / 2, b.y + (b.h - h) / 2))
	ui.gren_icon:SetWndSize(vector2():set(w, h))
end

local function update_grenade()
	local item = db.actor:item_in_slot(GREN_SLOT)
	gren_ready = item ~= nil
	if not gren_ready then
		cache.gren_sect = nil
		return
	end
	local sect = item:section()
	if cache.gren_sect ~= sect then
		cache.gren_sect = sect
		set_grenade_icon(sect)
	end
	local n = 0
	db.actor:iterate_inventory(function(_, obj)
		if obj:section() == sect then
			n = n + 1
		end
	end, db.actor)
	set_text("gren_n", ui.gren_count, "x" .. n)
	set_text("gren_key", ui.gren_key, game.translate_string("st_surv_hud_gren_key"))
end

-- position (and the name, for a person) of the active task's target
local function update_target(v)
	cmp_target = nil
	local id = v and v.current_target
	if not id then
		return
	end
	local obj = level.object_by_id(id)
	if obj then
		cmp_target = {pos = obj:position(), name = IsStalker(obj) and obj:alive() and obj:character_name() or nil, id = id}
		return
	end
	local se = alife():object(id)
	if se then
		cmp_target = {pos = se.position}
	end
end

local function by_dist(a, b)
	return a.d2 < b.d2
end

local function update_contacts()
	local n = 0
	if not minimap_on and db.actor:item_in_slot(PDA_SLOT) then
		local me, aid = db.actor:position(), db.actor:id()
		for id, st in pairs(db.storage) do
			local o = st.object
			if o and id ~= aid and IsStalker(o) then
				local p = o:position()
				local d2 = p:distance_to_sqr(me)
				if d2 <= PDA_R2 then
					local kind
					if not o:alive() then
						if math.abs(p.y - me.y) < DEAD_DY then
							kind = "dead"
						end
					else
						local rel = o:relation(db.actor)
						if rel == game_object.friend then
							kind = "friend"
						elseif rel == game_object.neutral then
							kind = "neutral"
						elseif db.actor:see(o) then
							kind = "enemy"
						end
					end
					if kind then
						n = n + 1
						local c = cmp_npcs[n] or {}
						cmp_npcs[n] = c
						c.id, c.kind, c.d2 = id, kind, d2
						c.name = (kind == "friend" or kind == "neutral") and o:character_name() or nil
					end
				end
			end
		end
	end
	for i = #cmp_npcs, n + 1, -1 do
		cmp_npcs[i] = nil
	end
	table.sort(cmp_npcs, by_dist)
end

local function slow_update()
	minimap_on = get_console():get_bool("hud_minimap")
	update_contacts()
	local v = active_task()
	task_title = v and game.translate_string(v.t:get_title()) or nil
	update_target(v)
	cmp_dist_fmt = game.translate_string("st_surv_hud_dist")
	update_dog()
	update_grenade()
end

-------------------------------------------------------------------------------------------------
-- every frame

-- title of the active task only while Tab is held (the engine adds "main_task" then);
-- the description is the engine's "secondary_task", it fades in by its light anim
local function update_task(hud)
	local tab = hud:GetCustomStatic("main_task") ~= nil
	if tab then
		if task_title then
			set_text("title", ui.task_title, task_title)
			set_text_color("title_c", ui.task_title, C_TITLE)
		else
			set_text("title", ui.task_title, game.translate_string("st_no_active_task"))
			set_text_color("title_c", ui.task_title, C_NOTASK)
		end
	end
	show(ui.task_diamond, tab and task_title ~= nil)
	show(ui.task_title, tab)

	if cache.task_left ~= not minimap_on then
		cache.task_left = not minimap_on
		local dx = minimap_on and 0 or TASK_X_NO_MAP - ui.diamond_pos0.x
		ui.task_diamond:SetWndPos(vector2():set(ui.diamond_pos0.x + dx, ui.diamond_pos0.y))
		ui.task_title:SetWndPos(vector2():set(ui.title_pos0.x + dx, ui.title_pos0.y))
		ui.descr_pos:set(ui.descr_pos0.x + dx, ui.descr_pos0.y)
	end
	local descr = hud:GetCustomStatic("secondary_task")
	if descr then
		descr:wnd():SetWndPos(ui.descr_pos)
	end
end

-- the grenade frame goes with the weapon frame, only while a weapon is in the hands
local function update_grenade_frame()
	local on = gren_ready and WEAPON_SLOTS[db.actor:active_slot()] == true
	show(ui.gren_frame, on)
	show(ui.gren_icon, on)
	show(ui.gren_count, on)
	show(ui.gren_key, on)
end

-- degrees from north (+z) clockwise, as on the map
local function bearing(dx, dz)
	return math.deg(math.atan2(dx, dz)) % 360
end

local function update_compass()
	local dir = device().cam_dir
	local heading = bearing(dir.x, dir.z)
	local half, cx, half_w = CMP_FOV / 2, ui.cmp_x0 + ui.cmp_w / 2, ui.cmp_w / 2

	-- ticks and cardinal letters inside the field of view
	local ti, li = 0, 0
	local d = math.ceil((heading - half) / CMP_STEP) * CMP_STEP
	while d <= heading + half do
		local x = cx + (d - heading) / half * half_w
		local deg = d % 360
		local letter = CMP_CARDINAL[deg]
		if letter then
			li = li + 1
			local st = ui.cmp_letters[li]
			if st then
				st:SetWndPos(V:set(x - ui.cmp_letter_w / 2, ui.cmp_letter_y))
				set_text("cmp_l" .. li, st, letter)
				show(st, true)
			end
		else
			ti = ti + 1
			local st = ui.cmp_ticks[ti]
			if st then
				local h = deg % 45 == 0 and ui.cmp_tick_h * 2 or ui.cmp_tick_h
				st:SetWndPos(V:set(x - ui.cmp_tick_w / 2, ui.cmp_y - h))
				if cache["cmp_t" .. ti] ~= h then
					cache["cmp_t" .. ti] = h
					st:SetWndSize(V:set(ui.cmp_tick_w, h))
				end
				show(st, true)
			end
		end
		d = d + CMP_STEP
	end
	for i = ti + 1, CMP_TICKS do
		show(ui.cmp_ticks[i], false)
	end
	for i = li + 1, CMP_LETTERS do
		show(ui.cmp_letters[i], false)
	end

	-- PDA contacts inside the field of view; labels go to the ones nearest to the centre first
	local mi, li = 0, 0
	if #cmp_npcs > 0 then
		local me = db.actor:position()
		local cand = {}
		for i = 1, math.min(#cmp_npcs, CMP_NPC_MAX) do
			local c = cmp_npcs[i]
			local o = level.object_by_id(c.id)
			if o then
				local p = o:position()
				local dx, dz = p.x - me.x, p.z - me.z
				local delta = (bearing(dx, dz) - heading + 540) % 360 - 180
				if math.abs(delta) <= half then
					mi = mi + 1
					local x = cx + delta / half * half_w
					local st = ui.cmp_npc[mi]
					st:SetWndPos(V:set(x - ui.npc_w / 2, ui.npc_y))
					local tex = c.kind == "dead" and "surv_mm_dead" or "surv_mm_dot"
					if cache["npc_t" .. mi] ~= tex then
						cache["npc_t" .. mi] = tex
						cache["npc_c" .. mi] = nil
						st:InitTexture(tex)
					end
					if cache["npc_c" .. mi] ~= c.kind then
						cache["npc_c" .. mi] = c.kind
						local col = C_REL[c.kind]
						st:SetTextureColor(GetARGB(255, col[1], col[2], col[3]))
					end
					show(st, true)
					if c.kind ~= "dead" and not (cmp_target and cmp_target.id == c.id) then
						cand[#cand + 1] = {x = x, ad = math.abs(delta), c = c, d = math.sqrt(dx * dx + dz * dz)}
					end
				end
			end
		end
		table.sort(cand, function(a, b) return a.ad < b.ad end)
		local n_used = 0
		for _, k in ipairs(cand) do
			if li >= CMP_LBL_MAX then
				break
			end
			local free = true
			for j = 1, n_used do
				if math.abs(lbl_used[j] - k.x) < ui.npc_lbl_gap then
					free = false
					break
				end
			end
			if free then
				n_used = n_used + 1
				lbl_used[n_used] = k.x
				li = li + 1
				local nm, ds = ui.cmp_npc_name[li], ui.cmp_npc_dist[li]
				local col = C_REL[k.c.kind]
				ds:SetWndPos(V:set(k.x - ui.npc_dist_w / 2, k.c.name and ui.npc_dist_y or ui.npc_name_y))
				set_text("npc_d" .. li, ds, string.format(cmp_dist_fmt, math.floor(k.d + 0.5)))
				show(ds, true)
				if k.c.name then
					nm:SetWndPos(V:set(k.x - ui.npc_name_w / 2, ui.npc_name_y))
					set_text("npc_n" .. li, nm, k.c.name)
					if cache["npc_nc" .. li] ~= k.c.kind then
						cache["npc_nc" .. li] = k.c.kind
						nm:SetTextColor(255, col[1], col[2], col[3])
					end
				end
				show(nm, k.c.name ~= nil)
			end
		end
	end
	for i = mi + 1, CMP_NPC_MAX do
		show(ui.cmp_npc[i], false)
	end
	for i = li + 1, CMP_LBL_MAX do
		show(ui.cmp_npc_name[i], false)
		show(ui.cmp_npc_dist[i], false)
	end

	-- the task target: on the line, or held at the end the target is behind (that arrow lights up)
	local side = 0
	if cmp_target then
		local me = db.actor:position()
		local dx, dz = cmp_target.pos.x - me.x, cmp_target.pos.z - me.z
		local delta = (bearing(dx, dz) - heading + 540) % 360 - 180
		if delta > half then
			delta, side = half, 1
		elseif delta < -half then
			delta, side = -half, -1
		end
		local x = cx + delta / half * half_w
		ui.compass_marker:SetWndPos(V:set(x - ui.cmp_marker_w / 2, ui.cmp_marker_y))
		ui.compass_dist:SetWndPos(V:set(x - ui.cmp_dist_w / 2, ui.cmp_dist_y))
		set_text("cmp_dist", ui.compass_dist, string.format(cmp_dist_fmt, math.floor(math.sqrt(dx * dx + dz * dz) + 0.5)))
		if cmp_target.name then
			ui.compass_name:SetWndPos(V:set(x - ui.cmp_name_w / 2, ui.cmp_name_y))
			set_text("cmp_name", ui.compass_name, cmp_target.name)
		end
	end
	show(ui.compass_marker, cmp_target ~= nil)
	show(ui.compass_dist, cmp_target ~= nil)
	show(ui.compass_name, cmp_target ~= nil and cmp_target.name ~= nil)
	if cache.cmp_side ~= side then
		cache.cmp_side = side
		ui.compass_arrow_l:SetTextureColor(side == -1 and C_ARROW_HI or C_ARROW)
		ui.compass_arrow_r:SetTextureColor(side == 1 and C_ARROW_HI or C_ARROW)
	end
end

local function update_health()
	local hp = math.floor(db.actor.health * 100 + 0.5)
	if hp < 1 then
		hp = 1
	end
	set_text("hp", ui.health_num, tostring(hp))
	set_text_color("hp_c", ui.health_num, hp <= 25 and C_LOW or C_TEXT)
	show(ui.health_num, true)
end

-- The mod's action hints (gather items, dog, dwarf) are custom statics too: the engine draws them
-- under the open windows, so they are hidden while the HUD is.
local HINTS = {"gather_items_box_static1", "gather_items_box_static2", "gather_items_box_static3",
	"gather_items_box_static4", "karlik_friend_commands_hint", "personal_dog_commands_hint0",
	"personal_dog_commands_hint1", "personal_dog_commands_hint2"}

local function show_hints(hud, on)
	for _, name in ipairs(HINTS) do
		local st = hud:GetCustomStatic(name)
		if st then
			st:wnd():Show(on)
		end
	end
end

function update()
	local hud = get_hud()
	if not hud then
		return
	end
	if not (ui and hud:GetCustomStatic(HOLDER)) then
		build(hud)
	end

	local on = hud_visible()
	show(ui.holder, on)
	show_hints(hud, on)
	if not on then
		return
	end

	local now = time_global()
	if now >= next_slow then
		next_slow = now + SLOW_MS
		slow_update()
	end
	update_task(hud)
	update_health()
	update_grenade_frame()
	update_compass()
end
