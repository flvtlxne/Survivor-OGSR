function kpp_radio_talking_timer_action1()
local st = get_hud():GetCustomStatic("kpp_radio_talking1") or get_hud():AddCustomStatic("kpp_radio_talking1",true)
st.m_endTime = time_global()/1000 + 5
soundtrack.raciya_sounds()
end

function kpp_radio_talking_timer_action2()
local st = get_hud():GetCustomStatic("kpp_radio_talking2") or get_hud():AddCustomStatic("kpp_radio_talking2",true)
st.m_endTime = time_global()/1000 + 5
soundtrack.raciya_sounds()
end

function after_vodka_replic_timer_action()
local counter_name = "vodka"
	local cnt_value = xr_logic.pstor_retrieve(db.actor, counter_name, 0)
	if cnt_value > 4 then
		if db.actor:dont_has_info("vodka_peredoz") then
			db.actor:give_info_portion ("vodka_peredoz")
		end
	elseif cnt_value < 4 then
		soundtrack.actor_after_vodka_replic()
	end
end

function actor_freeplay_timer_action1()
local st = get_hud():GetCustomStatic("actor_freeplay_think") or get_hud():AddCustomStatic("actor_freeplay_think",true)
st.m_endTime = time_global()/1000 + 7
end


