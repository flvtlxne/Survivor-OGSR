function critical_health_effect_action1()
level.show_weapon(true)
db.actor.bleeding = 1.0
db.actor.health = 1.0
db.actor.radiation = -1.0
db.actor.power = 1.0
end

function critical_health_effect_action2()
if db.actor:dont_has_info("marorers_house_trap") then
	news_manager.send_tip(db.actor, "lw_stranger_critical_health_tip", nil, "default", nil, nil)
elseif has_alife_info("marorers_house_trap") then
	news_manager.send_tip(db.actor, "lw_newbie_critical_health_tip", nil, "default", nil, nil)
end
end

function critical_health_effect_action3()
mod_functions.after_sleep_event()
end

