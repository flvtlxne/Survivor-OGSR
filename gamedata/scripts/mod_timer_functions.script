function mark_lonl_house_car_action()
   local obj = get_story_object("car_buhanka")
   local obj_id = obj:id()
   if obj_id then
   text = "УАЗ"
	level.map_add_object_spot_ser(obj_id,"alife_presentation_squad_neutral",text)
   end
end

