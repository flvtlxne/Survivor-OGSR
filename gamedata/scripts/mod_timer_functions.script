function lights1()
if db.actor:dont_has_info("lonl_house_electricity") then
	xr_effects.turn_off_lonl_house_lamps()
elseif has_alife_info("lonl_house_electricity") then
	xr_effects.turn_on_lonl_house_lamps()
end
end

function lights2()
if db.actor:dont_has_info("workshop_electricity") then
	xr_effects.turn_off_workshop_lamps()
elseif has_alife_info("workshop_electricity") then
	xr_effects.turn_on_workshop_lamps()
end
end

function lights3()
if db.actor:dont_has_info("narkoman_pribor_on") then
	xr_effects.turn_off_anomal_mushrom_light()
elseif has_alife_info("narkoman_pribor_on") then
	xr_effects.turn_on_anomal_mushrom_light()
end
end



