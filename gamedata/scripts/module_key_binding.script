-- Survivor: горячие клавиши мода.
-- В оригинале нажатия ловились через консольную переменную mm_net_player_name
-- и bind_console, но в OGSR её нет: мультиплеер вырезан.
-- Здесь клавиши опрашиваются через key_state() из OGSR, срабатывание - в момент нажатия.

local tbinding = {
	tab = "mod_functions.test",
	f5  = "mod_functions.test",
	h   = "mod_functions.dog_command1",
	j   = "mod_functions.dog_command2",
	k   = "mod_functions.dog_command3",
	t   = "mod_functions.start_test_interface",
	z   = "mod_functions.gather_outfit_upgrade_items_from_box",
	b   = "mod_functions.gather_weapon_upgrade_items_from_box",
	u   = "mod_functions.put_all_upgrades_to_box",
	m   = "mod_functions.talk_to_karlik",
}

local handlers = nil -- dik -> функция
local pressed = {}   -- dik -> была ли клавиша нажата на прошлом кадре

local function resolve(action)
	local p = string.find(action, "%.")
	if not p then
		return _G[action]
	end
	local mod = _G[string.sub(action, 1, p - 1)]
	if type(mod) == "table" then
		return mod[string.sub(action, p + 1)]
	end
end

local function key_down(dik)
	local s = key_state(dik)
	if type(s) == "number" then
		return s ~= 0
	end
	return s == true
end

local function init()
	handlers = {}
	if type(key_state) ~= "function" then
		log3("!!module_key_binding: key_state() is not available, hotkeys disabled")
		return
	end
	local count = 0
	for key, action in pairs(tbinding) do
		local dik = DIK_keys["DIK_" .. string.upper(key)]
		local f = resolve(action)
		if dik and type(f) == "function" then
			handlers[dik] = f
			count = count + 1
		else
			log3("!!module_key_binding: cannot bind [%s] -> [%s]", key, action)
		end
	end
	log3("module_key_binding: %s hotkeys bound", count)
	log3("module_key_binding: key_state() returns %s", type(key_state(DIK_keys.DIK_H)))
end

function update()
	if not handlers then
		init()
	end
	for dik, f in pairs(handlers) do
		local down = key_down(dik)
		if down and not pressed[dik] then
			f()
		end
		pressed[dik] = down
	end
end