function saveEvent() --// Событие при сэйве, например сохранение переменных в хранилища se_stor
module_dynamic_update.saveTbl()
module_callbacks.SaveCallbacks()
end

function loadEvent() --// Событие при лоаде, например загрузка переменных из хранилища se_stor
module_dynamic_update.loadTbl()
module_callbacks.LoadCallbacks()
end