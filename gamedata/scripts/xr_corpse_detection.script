for k1,v1 in pairs(animations) do
	for k2,v2 in pairs(v1) do
		if type(v2) == "table" then
			local at,ft = {},{}
			for _,v3 in ipairs(v2) do
				if type(v3) == "function" then
					ft[#at] = v3
				else
					table.insert(at,v3)
				end
			end
			v1[k2] = {a = at,f = ft}
		end
	end
end
