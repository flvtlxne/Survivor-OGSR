-- Индикация непрочитанного блокнота: --------------------------------------------

function note_using_indication()
if db.actor:alive() and has_alife_info("note_using") then
	local st = get_hud():GetCustomStatic("note_using_indicator") or get_hud():AddCustomStatic("note_using_indicator",true)
	st.m_endTime = time_global()/1000 + 1
end
end


-- Временная неуязвимость (для теста) -------------------------------------------

function invulnerability()
if has_alife_info("invulnerability") then
	db.actor.health = 1.0
	db.actor.bleeding = 1.0
end
end

-- Если актор в машине и низкое здоровье, то удаляем её, ибо смерть в тачке = движковый вылет: -----------------

function car_death_control()
local health = db.actor.health
local health_threasold = 0.5
if ( health <= health_threasold and xr_conditions.actor_in_car1() == true ) then
		mod_functions.del_car1()
		local pos = db.actor:position()
		local fx_particle = particles_object("explosions\\expl_car")
		fx_particle:play_at_pos(pos)
		soundtrack.explosion()
		start_real_timer(1, "mod_timer_functions.kill_actor_timer_action")
end
end


