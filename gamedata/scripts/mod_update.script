
-- Функционал с постоянной проверкой -----------------------------------------------------------
------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------



-- Голод: ----------------------------------------------------

function hunger_control()
if db.actor:alive() then
local sat = db.actor.satiety
	if sat>0 then
		sat = -0.001
	end
end
end

function hunger_effect()
if db.actor:alive() then
local sat = db.actor.satiety
local hunger_health_factor1 = -0.0001
local hunger_health_factor2 = -0.0003
	if sat<1.0 and sat>0.0005 then
		db.actor.health = hunger_health_factor1
		hunger_effect_hud_mesg1()	--	"страдаю от голода"
	elseif sat<0.0005 then
		db.actor.health = hunger_health_factor2
		hunger_effect_hud_mesg2()	--	"умираю от голода"
	end
end
end

function hunger_effect_hud_mesg1()
	local st = get_hud():GetCustomStatic("hunger_effect_hud_mesg1") or get_hud():AddCustomStatic("hunger_effect_hud_mesg1",true)
	st.m_endTime = time_global()/1000 + 1
end

function hunger_effect_hud_mesg2()
	local st = get_hud():GetCustomStatic("hunger_effect_hud_mesg2") or get_hud():AddCustomStatic("hunger_effect_hud_mesg2",true)
	st.m_endTime = time_global()/1000 + 1
end

-- тенденция к уменьшению;
-- 1-0.005 слабый голод
-- 0.005-0.0 сильный голод


-- Критическое ранение: ----------------------------------------------------
lite_treshold = 0.03    --'насколько должно уменьшиться здоровье с предыдущего обновления, чтобы экран окрасился в красный
crit_treshold = 0.20    --'насколько должно уменьшиться здоровье с предыдущего обновления, чтобы ГГ начало шатать
drop_item_on_crit_prob = 0.20    --'вероятность того, что ГГ выронит оружие
effector_power_coeff = 0.7
prev_health = -1
 
function wounded_pp_update()
    if prev_health > (db.actor.health + lite_treshold) then
      level.add_pp_effector("fire_hit.ppe", 2011, false)
      local effector_power = (prev_health - db.actor.health)*100*effector_power_coeff
      level.set_pp_effector_factor(2011, effector_power)
      if prev_health > db.actor.health + crit_treshold then
        level.add_cam_effector("camera_effects\\fusker.anm", 999, false, "") 
		soundtrack.hit_replics()
        if math.random() < drop_item_on_crit_prob then
          local active_item = db.actor:active_item()
          if active_item and active_item:section() ~= "bolt" and active_item:section()~= "wpn_knife" then
            db.actor:drop_item(active_item)
          end
        end
      end
    prev_health = db.actor.health
    end
end



-- Нас сильно поранили и пора возвращаться домой: --------------------------------------------

function critical_health_effect()
mod_achievements.update()
local diff = level.get_game_difficulty()

if diff == 0 then health_threasold = 0.05	--	новичок;
elseif diff == 1 then health_threasold = 0.10 	-- сталкер;
elseif diff == 2 then health_threasold = 0.15	-- ветеран;
elseif diff == 3 then health_threasold = 0.20 	-- мастер;
end
local hud = get_hud()
local health = db.actor.health
local health_screen_effect = health_threasold + 0.25		-- уровень здоровья, при котором экран будет мигать красным;
if health < health_screen_effect and db.actor:dont_has_info("critical_health") and has_alife_info("stranger_talk1") then
	level.add_pp_effector("thermal.ppe", 1084, false)
end
if db.actor:alive() and has_alife_info("stranger_talk1") and db.actor:dont_has_info("actor_set_maroder") then
if not xr_conditions.actor_in_zone(nil,nil,{"village_trap_house_room_zone"}) 
		and not xr_conditions.actor_in_zone(nil,nil,{"village_proval_zone"})
		and not xr_conditions.actor_in_zone(nil,nil,{"lonl_house_save_zone"})
		and not xr_conditions.actor_in_zone(nil,nil,{"willage_stranger_trap_zone"})
		and not xr_conditions.actor_in_zone(nil,nil,{"village_tunnel_zone"}) then	-- проверка, что актор не в сюжетном месте;
	if health <= health_threasold then 
	if xr_conditions.actor_in_kpp_fight() == false then	-- проверка, не идёт ли финальная битва;
	if xr_conditions.actor_in_car1() == false then	-- проверка, не в тачке ли актор;
	if db.actor:dont_has_info("critical_health") then
			db.actor:give_info_portion ("critical_health")	-- по инфо переносим лут(кроме костюма) в ящик и удаляем его;
			hud:HideActorMenu()
			hud:HidePdaMenu()
			db.actor:stop_talk()
			soundtrack.actor_critical_health_replic()
			critical_health_think()
			db.actor.health = health + 1.0
			db.actor.bleeding = 1.0
			start_real_timer(5, "mod_timer_functions.critical_health_effect_action1")	-- лечим ГГ;
			start_real_timer(10, "mod_timer_functions.critical_health_effect_action2")	-- шлём типс от Незнакомца; 
			db.actor:set_actor_position(patrol("lonl_house_bed_point1"):point(0))
			level.add_pp_effector("deadcity_wake.ppe", 1924, false)
			level.show_weapon(false)
		--	xr_effects.forward_game_time(actor, nil, {"1"})		-- перематываем время на час вперёд:
		-- удаляем все инфопоршены рандомных заданий, т.к. теперь они провалены:
			disable_info("random_event_helicrash")
			disable_info("random_event_blokpost")
			disable_info("random_event_forest")
			disable_info("random_event_forest_camp")
			disable_info("random_event_graveyard")
			disable_info("random_event_razlom")
			disable_info("random_event_island")
			disable_info("random_event_rad_hill")
			disable_info("random_event_willage")
			disable_info("random_event_workshop")
			disable_info("random_event_lonl_house")
			disable_info("courier_task")
			disable_info("courier_task_fail")
			xr_effects.delete_maroder_courier()
		-- а также удаляем квестовые предметы\артефакты, они больше не нужны:
			rnd_tasks_items_delete()
			low_health_counter()
		
		-- переспавниваем транспорт:
			mod_functions.reload_car1()
			mod_functions.reload_car2()
			mod_functions.reload_car3()
			mod_functions.reload_car4()
			
		-- и выдаём все задания по новой:
			start_real_timer(15, "mod_timer_functions.critical_health_effect_action3")
			
	end
	end
	end
	end
end
end
end

function low_health_counter()
local counter_name = "low_health"
	local cnt_value = xr_logic.pstor_retrieve(db.actor, counter_name, 0)
	if cnt_value < 10 then
		xr_effects.inc_counter(db.actor, nil, {"low_health",tostring(1)})
	end
end

function critical_health_think()
	local st = get_hud():GetCustomStatic("critical_health_think") or get_hud():AddCustomStatic("critical_health_think",true)
	st.m_endTime = time_global()/1000 + 5
end

