function effect_repair_item( item_name, item_condition )
	if mechanic_name ~= "kat_cs_commander" then
		local price = how_much_repair( item_name, item_condition )
		db.actor:give_money(-price)
	end
	
	if item_name=="novice_outfit" then
			mod_craft.take("upgr_item_novice_outf4", 1)
			mod_craft.take("upgr_item_novice_outf2", 1)	--	удаляем расходные материалы для брони
			soundtrack.repair_sounds()
			xr_effects.dec_counter(db.actor, nil, {"generator",1})
	end
	if item_name=="stalker_outfit" then
			mod_craft.take("upgr_item_specops_outf8", 1)
			mod_craft.take("upgr_item_novice_outf2", 1)	--	удаляем расходные материалы для брони
			soundtrack.repair_sounds()
			xr_effects.dec_counter(db.actor, nil, {"generator",1})
	end
	if item_name=="scientific_outfit" then
			mod_craft.take("upgr_item_scient_outf2", 1)
			mod_craft.take("upgr_item_novice_outf2", 1)	--	удаляем расходные материалы для брони
			soundtrack.repair_sounds()
			xr_effects.dec_counter(db.actor, nil, {"generator",1})
	end
	if item_name=="specops_outfit" then
			mod_craft.take("upgr_item_specops_outf1", 1)
			mod_craft.take("upgr_item_milit_outf2", 1)	--	удаляем расходные материалы для брони
			soundtrack.repair_sounds()
			xr_effects.dec_counter(db.actor, nil, {"generator",1})
	end
	if item_name=="military_outfit" then
			mod_craft.take("upgr_item_specops_outf1", 1)
			mod_craft.take("upgr_item_milit_outf2", 1)	--	удаляем расходные материалы для брони
			soundtrack.repair_sounds()
			xr_effects.dec_counter(db.actor, nil, {"generator",1})
	end
	if item_name=="exo_outfit" then
			mod_craft.take("upgr_item_specops_outf4", 1)
			mod_craft.take("upgr_item_specops_outf5", 1)	--	удаляем расходные материалы для брони
			soundtrack.repair_sounds()
			xr_effects.dec_counter(db.actor, nil, {"generator",1})
	end
	if item_name=="helm_respirator" then
			mod_craft.take("upgr_item_milit_outf9", 1)	--	удаляем расходные материалы для брони
			soundtrack.repair_sounds()
			xr_effects.dec_counter(db.actor, nil, {"generator",1})
	end
	if item_name=="helm_hardhat" then
			mod_craft.take("upgr_item_milit_outf2", 1)	--	удаляем расходные материалы для брони
			soundtrack.repair_sounds()
			xr_effects.dec_counter(db.actor, nil, {"generator",1})
	end
	if item_name=="helm_protective" then
			mod_craft.take("upgr_item_specops_outf2", 1)	--	удаляем расходные материалы для брони
			soundtrack.repair_sounds()
			xr_effects.dec_counter(db.actor, nil, {"generator",1})
	end
	if item_name=="helm_tactic" then
			mod_craft.take("upgr_item_specops_outf9", 1)	--	удаляем расходные материалы для брони
			soundtrack.repair_sounds()
			xr_effects.dec_counter(db.actor, nil, {"generator",1})
	end
	
	
	if(item_name=="wpn_pm"
		or item_name=="wpn_pb"
		or item_name=="wpn_fort"
		or item_name=="wpn_hpsa"
		or item_name=="wpn_beretta"
		or item_name=="wpn_walther"
		or item_name=="wpn_sig220"
		or item_name=="wpn_colt1911"
		or item_name=="wpn_usp"
		or item_name=="wpn_desert_eagle"
		or item_name=="wpn_bm16"
		or item_name=="wpn_toz34"
		or item_name=="wpn_wincheaster1300"
		or item_name=="wpn_spas12"
		or item_name=="wpn_protecta"
		or item_name=="wpn_ak74u"
		or item_name=="wpn_mp5"
		or item_name=="wpn_ak74"
		or item_name=="wpn_abakan"
		or item_name=="wpn_l85"
		or item_name=="wpn_lr300"
		or item_name=="wpn_sig550"
		or item_name=="wpn_groza"
		or item_name=="wpn_val"
		or item_name=="wpn_vintorez"
		or item_name=="wpn_svu"
		or item_name=="wpn_svd"
		or item_name=="wpn_rg-6"
		or item_name=="wpn_rpg7"
		or item_name=="wpn_g36"
		or item_name=="wpn_fn2000"
		or item_name=="wpn_pkm"
		or item_name=="wpn_bizon"
		or item_name=="wpn_sayga"
		or item_name=="wpn_m1891"
		or item_name=="wpn_gauss" and mod_craft.has("weapon_remkit") == nil ) then
			mod_craft.take("weapon_remkit", 1)	--	удаляем расходные материалы для оружия
			soundtrack.repair_sounds()
			xr_effects.dec_counter(db.actor, nil, {"generator",1})
	end
end

function can_upgrade_item( item_name, mechanic )
	mechanic_name = mechanic
	setup_discounts()
	if param_ini:line_exist(mechanic, "he_upgrade_nothing") then
		return false
	end
	if not param_ini:line_exist(mechanic, item_name) then
		return false
	end
	return true
end

function setup_discounts()
		if param_ini:line_exist(mechanic_name, "discount_condlist") then
				local condlist = param_ini:r_string(mechanic_name, "discount_condlist")
		local parsed = xr_logic.parse_condlist(db.actor, nil, nil, condlist)
		xr_logic.pick_section_from_condlist(db.actor, nil, parsed)
	end
end

function mech_discount(perc)
	cur_price_percent = perc
end
