	dialogs.relocate_item_section(second_speaker, "ammo_9x18_fmj", "in")
	dialogs.relocate_item_section(second_speaker, "ammo_9x18_fmj", "in")
	dialogs.relocate_item_section(second_speaker, "ammo_9x18_fmj", "in")
end


function lost_soldier_reward(first_speaker, second_speaker)
    dialogs.relocate_item_section(second_speaker, "helm_tactic", "in")
end

-- Если герой в тачке, то удаляем её к чертям, ибо транспорт забагован: ---------------------------------------------

function check_nearest_car()
local sim = alife()
for i=1,65534 do
local sobj = sim:object(i)
	if sobj and sobj:name():find("^veh_uaz_buhanka") and sobj.position:distance_to_sqr(db.actor:position())  <= 4*4 then
		sim:release(sobj,true)
		local pos = db.actor:position()
		alife():create("veh_uaz_buhanka", vector():set(pos.x+1, pos.y, pos.z), db.actor:level_vertex_id(), db.actor:game_vertex_id())
		db.actor:set_actor_position(vector():set(pos.x, pos.y-1.5, pos.z), db.actor:level_vertex_id(), db.actor:game_vertex_id())
		return
	end
end
end


function reload_car1()
local sim = alife()
for i=1,65534 do
local sobj = sim:object(i)
	if sobj and sobj:name():find("^veh_uaz_buhanka") and sobj.position:distance_to_sqr(db.actor:position())  > 4*4 then
		start_real_timer(1, "mod_functions.del_car1")
	end
end
end

function del_car1()
local sim = alife()
for i=1,65534 do
local sobj = sim:object(i)
	if sobj and sobj:name():find("^veh_uaz_buhanka") then
	sim:release(sobj,true)
	xr_effects.spawn_object(actor, nil, {"veh_uaz_buhanka","lonl_house_car_spawn_point","0","45"})
	return
	end
end
end


