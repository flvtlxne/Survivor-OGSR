function load_safe_zone_autosave()
xr_effects.load_game(actor, nil, {"safe_zone_autosave"})
end


function save_game_action()
if xr_conditions.master_difficulty() == false and mod_saves.base_save_only() == false then
	return
end
if xr_conditions.master_difficulty() == false then
if has_alife_info("stranger_talk1") then
if xr_conditions.actor_in_lonl_house_save_zone() == false then
	news_manager.send_tip(db.actor, "save_game_incorrect_tip", nil, "recent_surge", nil, nil)
	save_game_action_no_sounds()
elseif xr_conditions.actor_in_lonl_house_save_zone() == true then
	news_manager.send_tip(db.actor, "save_game_correct_tip", nil, "recent_surge", nil, nil)
	save_game_action_yes_sounds()
end
end
elseif xr_conditions.master_difficulty() == true and xr_conditions.actor_in_mg_start_zone() == false and xr_conditions.actor_in_kpp_surge_hide_zone() == false then
	news_manager.send_tip(db.actor, "save_game_incorrect_tip2", nil, "recent_surge", nil, nil)
	soundtrack.no_replics_mg()
end
end

function save_game_action_no_sounds()
if has_alife_info("actor_set_maroder") then
	soundtrack.no_replics_maroder()
elseif db.actor:dont_has_info("actor_set_maroder") then
	soundtrack.no_replics()
end
end

function save_game_action_yes_sounds()
if has_alife_info("actor_set_maroder") then
	soundtrack.accept_replics_maroder()
elseif db.actor:dont_has_info("actor_set_maroder") then
	soundtrack.accept_replics()
end
end


