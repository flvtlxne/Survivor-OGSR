-- Выгружаем все апгрейды из инвентаря в ближайший ящик: --------------------------------------------------------

function put_all_upgrades_to_box()
put_all_upgrades_to_box1()
put_all_upgrades_to_box2()
end

function put_all_upgrades_to_box1()
local box1 = get_story_object("lonl_house_store_box")
local box2 = get_story_object("lonl_house_invbox_4")
local box3 = get_story_object("lonl_house_invbox_3")
local box4 = get_story_object("lonl_house_invbox_2")
local box5 = get_story_object("lonl_house_invbox_1")

	local function transfer_object_item(item)
		if ( (system_ini():line_exist(item:section(), "specops_outf_item") and system_ini():r_bool(item:section(), "specops_outf_item")) ) or
			( (system_ini():line_exist(item:section(), "scient_outf_item") and system_ini():r_bool(item:section(), "scient_outf_item")) ) or
			( (system_ini():line_exist(item:section(), "military_outf_item") and system_ini():r_bool(item:section(), "military_outf_item")) ) or
			( (system_ini():line_exist(item:section(), "novice_outf_item") and system_ini():r_bool(item:section(), "novice_outf_item")) ) or
			( (system_ini():line_exist(item:section(), "exo_outf_item") and system_ini():r_bool(item:section(), "exo_outf_item")) ) or
			( (system_ini():line_exist(item:section(), "stalker_outf_item") and system_ini():r_bool(item:section(), "stalker_outf_item")) ) or
			( (system_ini():line_exist(item:section(), "hardhat_item") and system_ini():r_bool(item:section(), "hardhat_item")) ) or
			( (system_ini():line_exist(item:section(), "protective_item") and system_ini():r_bool(item:section(), "protective_item")) ) or
			( (system_ini():line_exist(item:section(), "respirator_item") and system_ini():r_bool(item:section(), "respirator_item")) ) or
			( (system_ini():line_exist(item:section(), "tactic_item") and system_ini():r_bool(item:section(), "tactic_item")) )	or
			( (system_ini():line_exist(item:section(), "pm_item") and system_ini():r_bool(item:section(), "pm_item")) ) or
			( (system_ini():line_exist(item:section(), "pb_item") and system_ini():r_bool(item:section(), "pb_item")) ) or
			( (system_ini():line_exist(item:section(), "obrez_item") and system_ini():r_bool(item:section(), "obrez_item")) ) or
			( (system_ini():line_exist(item:section(), "usp_item") and system_ini():r_bool(item:section(), "usp_item")) ) or
			( (system_ini():line_exist(item:section(), "hpsa_item") and system_ini():r_bool(item:section(), "hpsa_item")) ) or
			( (system_ini():line_exist(item:section(), "toz_item") and system_ini():r_bool(item:section(), "toz_item")) ) or
			( (system_ini():line_exist(item:section(), "aksu_item") and system_ini():r_bool(item:section(), "aksu_item")) ) or
			( (system_ini():line_exist(item:section(), "ak74_item") and system_ini():r_bool(item:section(), "ak74_item")) ) or
			( (system_ini():line_exist(item:section(), "lr300_item") and system_ini():r_bool(item:section(), "lr300_item")) ) or
			( (system_ini():line_exist(item:section(), "vintorez_item") and system_ini():r_bool(item:section(), "vintorez_item")) ) or
			( (system_ini():line_exist(item:section(), "bizon_item") and system_ini():r_bool(item:section(), "bizon_item")) ) or
			( (system_ini():line_exist(item:section(), "mosin_item") and system_ini():r_bool(item:section(), "mosin_item")) ) or
			( (system_ini():line_exist(item:section(), "sayga_item") and system_ini():r_bool(item:section(), "sayga_item")) )	then
			
			if distance_between(box1, db.actor) < 1.7 then
				db.actor:transfer_item(item, box1)
				soundtrack.actor_gather_stuff2()
			elseif distance_between(box2, db.actor) < 1.7 then
				db.actor:transfer_item(item, box2)
				soundtrack.actor_gather_stuff2()
			elseif distance_between(box3, db.actor) < 1.7 then
				db.actor:transfer_item(item, box3)
				soundtrack.actor_gather_stuff2()
			elseif distance_between(box4, db.actor) < 1.7 then
				db.actor:transfer_item(item, box4)
				soundtrack.actor_gather_stuff2()
			elseif distance_between(box5, db.actor) < 1.7 then
				db.actor:transfer_item(item, box5)
				soundtrack.actor_gather_stuff2()
			end
			
		end
	end
	db.actor:inventory_for_each(transfer_object_item)
end


function put_all_upgrades_to_box2()				-- для лабы;
local box = get_story_object("lonl_house_invbox_5")

	local function transfer_object_item(item)
		if (system_ini():line_exist(item:section(), "lab_item") and system_ini():r_bool(item:section(), "lab_item")) then
			
			if distance_between(box, db.actor) < 1.7 then
				db.actor:transfer_item(item, box)
				soundtrack.actor_gather_stuff2()
			end		
		end
	end
	db.actor:inventory_for_each(transfer_object_item)
end

--------------------------------------------------------------------------------------------------------------



function have_scientific_outfit()
    return db.actor:object("scientific_outfit") ~= nil
end

function have_af_treasure()
    return db.actor:object("af_treasure") ~= nil
end

function have_af_electra_moonlight()
    return db.actor:object("af_electra_moonlight") ~= nil
end

function have_drug_psy_blockade()
    return db.actor:object("drug_psy_blockade") ~= nil
end


function scientist_karlik_reward(first_speaker, second_speaker)
	dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "specops_outfit")
	delete_karlik_house_zombies()
end



function talk_to_karlik()
local karlik = get_story_object("karlik_friend")
if karlik ~= nil and karlik:alive() and karlik:position():distance_to(db.actor:position()) < 5 then
	local pos = karlik:position()
	alife():create("karlik_npc", vector():set(pos.x+1, pos.y, pos.z), karlik:level_vertex_id(), karlik:game_vertex_id())
	start_real_timer(1, "mod_functions.use_karlik_npc")
	db.actor:give_info_portion("karlik_talk")
	disable_info("karlik_getlost")
	disable_info("karlik_stay")
	soundtrack.karlik_command1()
end
end

function use_karlik_npc()
local npc = get_story_object("karlik_npc")
	if npc ~= nil then
		db.actor:run_talk_dialog(npc, actor)
	end
end



function karlik_habar_give(first_speaker, second_speaker)
if has_alife_info("karlik_bandage") then
	dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "bandage")
	karlik_info_disable()
end
if has_alife_info("karlik_medkit") then
	dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "medkit")
	karlik_info_disable()
end
if has_alife_info("karlik_ammo1") then
	dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "ammo_5.45x39_ap")
	karlik_info_disable()
end
if has_alife_info("karlik_ammo2") then
	dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "grenade_f1")
	karlik_info_disable()
end
if has_alife_info("karlik_part1") then
	dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "sayga_part_4")
	karlik_info_disable()
end
if has_alife_info("karlik_part2") then
	dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "vintorez_part1")
	karlik_info_disable()
end
if has_alife_info("karlik_part3") then
	dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "trs_part4")
	karlik_info_disable()
end
if has_alife_info("karlik_part4") then
	dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "ak_part4")
	karlik_info_disable()
end
if has_alife_info("karlik_food") then
	dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "bread")
	karlik_info_disable()
end
if has_alife_info("karlik_caritem1") then
	dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "car_item_wd40")
	karlik_info_disable()
end
if has_alife_info("karlik_meditem1") then
	dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "chem_item_liquor")
	karlik_info_disable()
end
if has_alife_info("karlik_meditem2") then
	dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "chem_item_gematogen")
	karlik_info_disable()
end
end


function karlik_habar_random_info()
rnd = math.random(1, 30)
if rnd == 1 then 
db.actor:give_info_portion("karlik_bandage")
end
if rnd == 2 then 
db.actor:give_info_portion("karlik_medkit")
end
if rnd == 3 then 
db.actor:give_info_portion("karlik_ammo1")
end
if rnd == 4 then 
db.actor:give_info_portion("karlik_ammo2")
end
if rnd == 5 then 
db.actor:give_info_portion("karlik_part1")
end
if rnd == 6 then 
db.actor:give_info_portion("karlik_part2")
end
if rnd == 7 then 
db.actor:give_info_portion("karlik_part3")
end
if rnd == 8 then 
db.actor:give_info_portion("karlik_part4")
end
if rnd == 9 then 
db.actor:give_info_portion("karlik_food")
end
if rnd == 10 then 
db.actor:give_info_portion("karlik_caritem1")
end
if rnd == 11 then 
db.actor:give_info_portion("karlik_meditem1")
end
if rnd == 12 then 
db.actor:give_info_portion("karlik_meditem2")
end
