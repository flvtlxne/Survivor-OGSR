-- Удалить всё оружие в радиусе 20м ---------------------------------------------

function clear_weapons_around()
local sim = alife()
for i=1,65534 do
local sobj = sim:object(i)
	if sobj and isWeapon(sobj) and sobj:name():find("wpn_lr300") and sobj.position:distance_to(db.actor:position()) < 20 then
		--alife():release(alife():object(db.actor:object(obj):id()), true)
		alife():release(sobj, true)
	end
end
end


