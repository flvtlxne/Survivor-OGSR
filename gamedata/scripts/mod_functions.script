-- Подбираем все апгрейды для одетой брони и пушек в слотах из ближайшего ящика:

function gather_outfit_upgrade_items_from_box()
	--local inv_box_out = get_story_object("lonl_house_store_box")
	local inv_box1_out = get_story_object("lonl_house_store_box")
	local inv_box2_out = get_story_object("lonl_house_invbox_4")
	local inv_box3_out = get_story_object("lonl_house_invbox_3")
	local inv_box4_out = get_story_object("lonl_house_invbox_2")
	local inv_box5_out = get_story_object("lonl_house_invbox_1")
	local obj_in = db.actor
	local items_to_relocate = {	}
	
	if distance_between(inv_box1_out, db.actor) < 1.7 then
	local function relocate(inv_box1_out, item)
		if ( xr_conditions.actor_wears_specops_outfit() == true and (system_ini():line_exist(item:section(), "specops_outf_item") and system_ini():r_bool(item:section(), "specops_outf_item")) ) or
			( xr_conditions.actor_wears_scient_outfit() == true and (system_ini():line_exist(item:section(), "scient_outf_item") and system_ini():r_bool(item:section(), "scient_outf_item")) ) or
			( xr_conditions.actor_wears_military_outfit() == true and (system_ini():line_exist(item:section(), "military_outf_item") and system_ini():r_bool(item:section(), "military_outf_item")) ) or
			( xr_conditions.actor_wears_novice_outfit() == true and (system_ini():line_exist(item:section(), "novice_outf_item") and system_ini():r_bool(item:section(), "novice_outf_item")) ) or
			( xr_conditions.actor_wears_exo_outfit() == true and (system_ini():line_exist(item:section(), "exo_outf_item") and system_ini():r_bool(item:section(), "exo_outf_item")) ) or
			( xr_conditions.actor_wears_stalker_outfit() == true and (system_ini():line_exist(item:section(), "stalker_outf_item") and system_ini():r_bool(item:section(), "stalker_outf_item")) ) or
			( xr_conditions.actor_wears_helm_hardhat() == true and (system_ini():line_exist(item:section(), "hardhat_item") and system_ini():r_bool(item:section(), "hardhat_item")) ) or
			( xr_conditions.actor_wears_helm_protective() == true and (system_ini():line_exist(item:section(), "protective_item") and system_ini():r_bool(item:section(), "protective_item")) ) or
			( xr_conditions.actor_wears_helm_respirator() == true and (system_ini():line_exist(item:section(), "respirator_item") and system_ini():r_bool(item:section(), "respirator_item")) ) or
			( xr_conditions.actor_wears_helm_tactic() == true and (system_ini():line_exist(item:section(), "tactic_item") and system_ini():r_bool(item:section(), "tactic_item")) )	then
			table.insert(items_to_relocate, item)
		end
	end
	inv_box1_out:iterate_inventory_box	(relocate, inv_box1_out)
	soundtrack.actor_gather_stuff()
	for k,v in pairs(items_to_relocate) do
		inv_box1_out:transfer_item(v, obj_in)
	end
	end
	
	if distance_between(inv_box2_out, db.actor) < 1.7 then
	local function relocate(inv_box2_out, item)
		if ( xr_conditions.actor_wears_specops_outfit() == true and (system_ini():line_exist(item:section(), "specops_outf_item") and system_ini():r_bool(item:section(), "specops_outf_item")) ) or
			( xr_conditions.actor_wears_scient_outfit() == true and (system_ini():line_exist(item:section(), "scient_outf_item") and system_ini():r_bool(item:section(), "scient_outf_item")) ) or
			( xr_conditions.actor_wears_military_outfit() == true and (system_ini():line_exist(item:section(), "military_outf_item") and system_ini():r_bool(item:section(), "military_outf_item")) ) or
			( xr_conditions.actor_wears_novice_outfit() == true and (system_ini():line_exist(item:section(), "novice_outf_item") and system_ini():r_bool(item:section(), "novice_outf_item")) ) or
