function reload_car3()
local sim = alife()
for i=1,65534 do
local sobj = sim:object(i)
	if sobj and sobj:name():find("^veh_niva") and sobj.position:distance_to_sqr(db.actor:position())  > 4*4 then
		start_real_timer(1, "mod_functions.del_car3")
	end
end
end

function del_car3()
local sim = alife()
for i=1,65534 do
local sobj = sim:object(i)
	if sobj and sobj:name():find("^veh_niva") then
	sim:release(sobj,true)
	xr_effects.spawn_object(actor, nil, {"veh_niva","lonl_house_car_spawn_point3","0","45"})
	return
	end
end
end


function reload_car4()
local sim = alife()
for i=1,65534 do
local sobj = sim:object(i)
	if sobj and sobj:name():find("^veh_zil_130") and sobj.position:distance_to_sqr(db.actor:position())  > 4*4 then
		start_real_timer(1, "mod_functions.del_car4")
	end
end
end

function del_car4()
local sim = alife()
for i=1,65534 do
local sobj = sim:object(i)
	if sobj and sobj:name():find("^veh_zil_130") then
	sim:release(sobj,true)
	xr_effects.spawn_object(actor, nil, {"veh_zil_130","lonl_house_car_spawn_point4","0","45"})
	return
	end
end
end



