-- Удаление предмета из инвентаря ------------------------------------------------------------

function remove_items(sect, cnt)
cnt = cnt or 1
 local actor, sim = db.actor, alife()
 local i = actor:object_count() - 1
 while (i>0 and cnt>0) do
  local item = actor:object(i)
  if item and item:section()==sect then
   local soItem = sim:object(item:id())
   if soItem then
    cnt = cnt - 1
    sim:release(soItem, true)
   end
  end
  i = i - 1
 end
end


function post_load_game_action1()
start_real_timer(1, "mod_functions.post_load_game_action2")
end

function post_load_game_action2()
	if mod_saves.save_is_valid_here() then
		return
	end
	if xr_conditions.master_difficulty() then
		xr_effects.load_game(db.actor, nil, {"scenario_save_master1"})
	else
		xr_effects.load_game(db.actor, nil, {"safe_zone_autosave"})
	end
end

function after_surge_think()
local st = get_hud():GetCustomStatic("after_surge_think") or get_hud():AddCustomStatic("after_surge_think",true)
st.m_endTime = time_global()/1000 + 7
end


