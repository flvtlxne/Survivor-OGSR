-- Система рандомных событий(ивентов) на локации: ------------------------------------

function random_events_action_general()
if has_alife_info("stranger_talk2") then	--	все ивенты разрешены только после второго разговора с Незнакомцем;
	-- Вертушка:
	if has_alife_info("stranger_talk2") then
		if db.actor:dont_has_info("random_event_helicrash") then
			db.actor:give_info_portion ("random_event_helicrash")
		end
	end
	-- Блокпост:
	if db.actor:dont_has_info("shron_merc_lider_pda_info") then
		if db.actor:dont_has_info("random_event_blokpost") then
			db.actor:give_info_portion ("random_event_blokpost")
		end
	elseif has_alife_info("shron_merc_lider_pda_info") then
		if has_alife_info("lw_freeplay") then
			if db.actor:dont_has_info("random_event_blokpost") then
				db.actor:give_info_portion ("random_event_blokpost")
			end
		end
	end
	-- Роща:
	if db.actor:dont_has_info("random_event_forest") then
		db.actor:give_info_portion ("random_event_forest")
	end
	-- Лагерь в лесу:
	if db.actor:dont_has_info("stranger_talk2") then
		if db.actor:dont_has_info("random_event_forest_camp") then
			db.actor:give_info_portion ("random_event_forest_camp")
		end
	elseif has_alife_info("stranger_talk2") then
		if has_alife_info("marodr_camp_done") then
			if db.actor:dont_has_info("random_event_forest_camp") then
				db.actor:give_info_portion ("random_event_forest_camp")
			end
		end
	end
	-- Кладбище:
	if db.actor:dont_has_info("random_event_graveyard") then
		db.actor:give_info_portion ("random_event_graveyard")
	end
	-- Разлом:
	if db.actor:dont_has_info("stranger_talk3") then
		if db.actor:dont_has_info("random_event_razlom") then
			db.actor:give_info_portion ("random_event_razlom")
		end
	elseif has_alife_info("stranger_talk3") then
		if has_alife_info("lw_newbie_on_base") then
			if db.actor:dont_has_info("random_event_razlom") then
				db.actor:give_info_portion ("random_event_razlom")
			end
		end
	end
	-- Островок:
	if db.actor:dont_has_info("random_event_island") then
		db.actor:give_info_portion ("random_event_island")
	end
	-- Очаг радиации:
	if db.actor:dont_has_info("random_event_rad_hill") then
		db.actor:give_info_portion ("random_event_rad_hill")
	end
	-- Деревня:
	if db.actor:dont_has_info("stranger_talk4") then
		if db.actor:dont_has_info("random_event_willage") then
			db.actor:give_info_portion ("random_event_willage")
		end
	elseif has_alife_info("stranger_talk4") then
		if has_alife_info("lw_stranger_after_willage_call") then
			if db.actor:dont_has_info("random_event_willage") then
				db.actor:give_info_portion ("random_event_willage")
			end
		end
	end
	-- Рембаза:
	if db.actor:dont_has_info("stranger_talk6") then
		if db.actor:dont_has_info("random_event_workshop") then
			db.actor:give_info_portion ("random_event_workshop")
		end
	elseif has_alife_info("stranger_talk6") then
		if has_alife_info("marorers_house_trap") then
			if db.actor:dont_has_info("random_event_workshop") then
				db.actor:give_info_portion ("random_event_workshop")
			end
		end
	end
	
	-- Курьер:
	if db.actor:dont_has_info("courier_task") then
		spawn_maroder_courier()
		--task_manager.get_task_manager():give_task("rnd_task_kill_courier")
		start_real_timer(2, "mod_timer_functions.kill_courier_task_timer")
		db.actor:give_info_portion ("courier_task")
	end
	
end
end

-- Спавним куръера: --------------------------------------------------------------------------------

function spawn_maroder_courier()
rnd = math.random(1, 4)
if rnd == 1 then 
mod_functions.script_spawn("maroder_courier1", "derevnya", vector():set(-218.03,38.12,-377.01) )
end
if rnd == 2 then 
mod_functions.script_spawn("maroder_courier2", "derevnya", vector():set(-395.86,16.70,-3.80) )
end
if rnd == 3 then 
mod_functions.script_spawn("maroder_courier3", "derevnya", vector():set(-646.03,13.54,464.24) )
end
if rnd == 4 then 
mod_functions.script_spawn("maroder_courier4", "derevnya", vector():set(271.30,22.49,222.88) )
end
end


