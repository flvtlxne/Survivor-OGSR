-- Мочкануть всех мутантов в радиусе 50м ---------------------------------------------
function kill_mutants_around()
for k, v in pairs (db.storage) do
    local mob = level.object_by_id(k)
	if ( mob and IsMonster(mob) and mob:alive() and mob:id() ~= db.actor:id() and mob:section() ~= "personal_dog" and mob:section() ~= "karlik_friend" and mob:position():distance_to(db.actor:position()) < 50 )	then
			local hit = hit()
			hit.direction = vector():set(0, 1, 0)
			hit.impulse = 0
			hit.draftsman = db.actor
			hit.power = 150.0
			hit.type = hit.wound
			mob:hit(hit)
	end
end
end

-- Мочкануть всех сталкеров-врагов в радиусе 50м ---------------------------------------------
function kill_stalkers_around()
    for k, v in pairs (db.storage) do
        local stalker = level.object_by_id(k)
        if (stalker and IsStalker(stalker) and stalker:id() ~= db.actor:id() and stalker:section() ~= "lw_stranger" and stalker:section() ~= "lw_scientist" and stalker:section() ~= "lw_newbie" and stalker:relation(db.actor) == game_object.enemy ) then
            if stalker:position():distance_to(db.actor:position()) < 50 then
				--stalker:kill(stalker)
				local hit = hit()
				hit.direction = vector():set(0, 1, 0)
				hit.impulse = 0
				hit.draftsman = db.actor
				hit.power = 50.0
				hit.type = hit.wound
				stalker:hit(hit)
            end
        end
    end
end

-- Мочкануть всех сталкеров-врагов в радиусе 20м ---------------------------------------------
