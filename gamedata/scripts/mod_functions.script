function delete_karlik_house_zombies()
delete_karlik_house_zombie1()
delete_karlik_house_zombie2()
delete_karlik_house_zombie3()
delete_karlik_house_karlik()
end


function delete_karlik_house_zombie1()
local sim = alife()
for i=1,65534 do
local sobj = sim:object(i)
	if sobj and sobj:name():find("^karlik_house_zomb1") then
	sim:release(sobj,true)
	return
	end
end
end

