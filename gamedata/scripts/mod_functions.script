-- Команды суке: ----------------------------------------------------------------

function dog_command1()	-- сидеть на месте(H);
local dog = get_story_object("personal_dog")
if dog ~= nil and dog:alive() and dog:position():distance_to(db.actor:position()) < 15 then
if db.actor:dont_has_info("wounded_dog_help") then
	if db.actor:object("bandage") ~= nil then
		db.actor:give_info_portion ("wounded_dog_help")
		mod_functions.remove_items("bandage", 1)
		soundtrack.dog_command0()
	end
elseif has_alife_info("wounded_dog_help") then
	if db.actor:dont_has_info("personal_dog_stay") then
		db.actor:give_info_portion ("personal_dog_stay")
		disable_info("personal_dog_gohome")
		soundtrack.dog_command2()	-- личному составу отдыхать;
	elseif has_alife_info("personal_dog_stay") then
		disable_info("personal_dog_stay")
		soundtrack.dog_command3()	-- не спать, осмотреться;
	end
end
end
end

function dog_command2()	-- домой(J);
local dog = get_story_object("personal_dog")
if dog ~= nil and dog:alive() and dog:position():distance_to(db.actor:position()) < 15 then
	db.actor:give_info_portion ("personal_dog_gohome")
	disable_info("personal_dog_stay")
	soundtrack.dog_command1()	-- вольно, разойдись;
end
end


function dog_command3()	-- лечение;
local dog = get_story_object("personal_dog")
if dog ~= nil and dog:alive() and dog:position():distance_to(db.actor:position()) < 15 and db.actor:object("kolbasa") ~= nil then
	dog.health = 1
	mod_functions.remove_items("kolbasa", 1)
	soundtrack.dog_command4()
end
end



