function maroder_item_reward(items_table, count)
	--local conut = 7
	for i = 1,8 do
		alife():create(random_maroder_item_table[math.random(#random_maroder_item_table)],
			db.actor:position(),
			db.actor:level_vertex_id(),
			db.actor:game_vertex_id(),
			db.actor:id())
	end
end

