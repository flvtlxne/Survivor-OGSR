-- Работа сканера артефактов: ---------------------------------------------------------

function artefact_scaner_work()
if db.actor:dont_has_info("artefacts_spawn") then
	spawn_location_artefacts1()
	spawn_location_artefacts2()
	spawn_location_artefacts3()
	spawn_location_artefacts4()
	spawn_location_artefacts5()
	db.actor:give_info_portion ("artefacts_spawn")
	start_game_timer(720*60, "mod_timer_functions.artefacts_spawn_timer_action")
end
end

