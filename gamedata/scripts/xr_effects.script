end
end


function delete_maroder_courier()
delete_maroder_courier1()
delete_maroder_courier2()
delete_maroder_courier3()
delete_maroder_courier4()
end

function delete_maroder_courier1()
local sim = alife()
for i=1,65534 do
local sobj = sim:object(i)
	if sobj and sobj:name():find("^maroder_courier1") then
	sim:release(sobj,true)
	return
	end
end
end

