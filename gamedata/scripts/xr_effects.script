function additional_boxes_random_loot_all()
rnd = math.random(1, 4)
if rnd == 1 then 
additional_boxes_random_loot1()
end
if rnd == 2 then 
additional_boxes_random_loot2()
end
if rnd == 3 then 
additional_boxes_random_loot3()
end
if rnd == 4 then 
additional_boxes_random_loot4()
end
end

