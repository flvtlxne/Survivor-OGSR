-- Спавним артефакты и аномалии по точкам: -----------------------------------------------------------

-- Блокпост:
function kpp_artefact_spawn()
rnd = math.random(1, 3)
if rnd == 1 then 
kpp_artefact_spawn1()
end
if rnd == 2 then 
kpp_artefact_spawn2()
end
if rnd == 3 then 
kpp_artefact_spawn3()
end
end

function kpp_artefact_spawn1()
xr_effects.spawn_object(actor, nil, {"kpp_rnd_artefact","kpp_anomaly_spawn_point1"})
kpp_anomalys_spawn()
end

function kpp_artefact_spawn2()
xr_effects.spawn_object(actor, nil, {"kpp_rnd_artefact","kpp_anomaly_spawn_point3"})
kpp_anomalys_spawn()
end

function kpp_artefact_spawn3()
xr_effects.spawn_object(actor, nil, {"kpp_rnd_artefact","kpp_anomaly_spawn_point4"})
kpp_anomalys_spawn()
end

-- и сопутствующие аномалии:
function kpp_anomalys_spawn()
local point1 = patrol("kpp_anomaly_spawn_point1")
local lv1 = point1:level_vertex_id()
local gv1 = point1:game_vertex_id()
sgm_packet.create_anomaly("kpp_anom_1",3,lv1,gv1)
local point2 = patrol("kpp_anomaly_spawn_point2")
local lv2 = point2:level_vertex_id()
local gv2 = point2:game_vertex_id()
sgm_packet.create_anomaly("kpp_anom_2",3,lv2,gv2)
local point3 = patrol("kpp_anomaly_spawn_point3")
local lv3 = point3:level_vertex_id()
local gv3 = point3:game_vertex_id()
sgm_packet.create_anomaly("kpp_anom_3",3,lv3,gv3)
local point4 = patrol("kpp_anomaly_spawn_point4")
local lv4 = point4:level_vertex_id()
local gv4 = point4:game_vertex_id()
sgm_packet.create_anomaly("kpp_anom_4",3,lv4,gv4)
local point5 = patrol("kpp_anomaly_spawn_point5")
local lv5 = point5:level_vertex_id()
local gv5 = point5:game_vertex_id()
sgm_packet.create_anomaly("kpp_anom_5",3,lv5,gv5)
local point6 = patrol("kpp_anomaly_spawn_point6")
local lv6 = point6:level_vertex_id()
local gv6 = point6:game_vertex_id()
sgm_packet.create_anomaly("kpp_anom_6",3,lv6,gv6)
local point7 = patrol("kpp_anomaly_spawn_point7")
local lv7 = point7:level_vertex_id()
local gv7 = point7:game_vertex_id()
sgm_packet.create_anomaly("kpp_anom_7",3,lv7,gv7)
local point8 = patrol("kpp_anomaly_spawn_point8")
local lv8 = point8:level_vertex_id()
local gv8 = point8:game_vertex_id()
sgm_packet.create_anomaly("kpp_anom_8",3,lv8,gv8)
end

function delete_kpp_anomalys()
xr_effects.delete_kpp_anom_1()
xr_effects.delete_kpp_anom_2()
xr_effects.delete_kpp_anom_3()
xr_effects.delete_kpp_anom_4()
xr_effects.delete_kpp_anom_5()
xr_effects.delete_kpp_anom_6()
xr_effects.delete_kpp_anom_7()
