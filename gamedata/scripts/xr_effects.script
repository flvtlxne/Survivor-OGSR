function spawn_grenade_at_pos(actor, npc, p)
local sobj = alife():object(npc:id())
local pos = npc:position()
if sobj then
alife():create("npc_bomb", vector():set(pos.x, pos.y+1, pos.z), npc:level_vertex_id(), npc:game_vertex_id())
end
end

function hit_bomber_grenade()
start_real_timer(1, "xr_effects.hit_bomber_grenade1")
end

function hit_bomber_grenade1()
for i=1,65534 do
local bomb = level.object_by_id(i)
	if bomb and bomb:section() == "npc_bomb" then
			local h=hit()
			h.type = hit.fire_wound
			h.power = 10.0
			h.impulse = 0
			h.draftsman = db.actor
			h.direction = vector():set(0,0,0)
			bomb:hit(h)
	end
end
end


function spawn_smoke_grenade_at_pos(actor, npc, p)
local sobj = alife():object(npc:id())
local pos = npc:position()
if sobj then
alife():create("npc_bomb_smoke", vector():set(pos.x, pos.y+1, pos.z), npc:level_vertex_id(), npc:game_vertex_id())
end
end

function start_npc_smoke_bomb_timer()
start_real_timer(1, "xr_effects.hit_smoke_grenade")
end

function hit_smoke_grenade()
for i=1,65534 do
local bomb = level.object_by_id(i)
	if bomb and bomb:section() == "npc_bomb_smoke" then
			local h=hit()
			h.type = hit.fire_wound
			h.power = 10.0
			h.impulse = 0
			h.draftsman = db.actor
			h.direction = vector():set(0,0,0)
			bomb:hit(h)
	end
end
end



