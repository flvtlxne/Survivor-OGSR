-- Помечаем тачанки: -----------------------------

function mark_mg_cars()
mark_car1()
mark_car2()
mark_car3()
mark_car4()
mark_car5()
mark_car6()
end

function mark_car1()
local sim = alife()
for a=1,65534 do
local obj = sim:object( a )
  if obj then
  local obj_id = obj.id
   if obj:section_name():find("^veh_niva") then
		text = "Транспорт"
		level.map_add_object_spot_ser(obj_id,"mg_car_mark",text)
   end
  end
 end
end

