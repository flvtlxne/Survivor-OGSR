function kill_mutants_around_actor120()
for k, v in pairs (db.storage) do
    local mob = level.object_by_id(k)
	if ( mob and IsMonster(mob) and mob:alive() and mob:id() ~= db.actor:id() and mob:section() ~= "personal_dog" and mob:section() ~= "karlik_friend" and mob:position():distance_to(db.actor:position()) < 120 )	then
			local hit = hit()
			hit.direction = vector():set(0, 1, 0)
			hit.impulse = 0
			hit.draftsman = db.actor
			hit.power = 20.0
			hit.type = hit.wound
			mob:hit(hit)
	end
end
end

function kill_mutants_around_actor50()
for k, v in pairs (db.storage) do
    local mob = level.object_by_id(k)
	if ( mob and IsMonster(mob) and mob:alive() and mob:id() ~= db.actor:id() and mob:section() ~= "personal_dog" and mob:section() ~= "karlik_friend" and mob:position():distance_to(db.actor:position()) < 50 )	then
			local hit = hit()
			hit.direction = vector():set(0, 1, 0)
			hit.impulse = 0
			hit.draftsman = db.actor
			hit.power = 20.0
			hit.type = hit.wound
			mob:hit(hit)
	end
end
end

function clear_weapons_around_actor15()
local sim = alife()
for i=1,65534 do
local sobj = sim:object(i)
	if sobj and isWeapon(sobj) 
	and ( sobj:name():find("wpn_pm") or
	sobj:name():find("wpn_ak74") or
	sobj:name():find("wpn_ak74u") or
	sobj:name():find("wpn_bm16") or
	sobj:name():find("wpn_lr300") or
	sobj:name():find("wpn_vintorez") or
	sobj:name():find("wpn_hpsa") or
	sobj:name():find("wpn_toz34") )
	and sobj.position:distance_to(db.actor:position()) < 15	then
		alife():release(sobj, true)
	end
end
end

