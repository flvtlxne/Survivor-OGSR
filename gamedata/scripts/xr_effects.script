function turn_off_lonl_house_lamps(actor, npc)
	local lamps_table = {
							["lonl_house_lamp1"] = true,
							["lonl_house_lamp2"] = true,
							["lonl_house_lamp3"] = true,
							["lonl_house_lamp4"] = true,
						}
	local obj
	for k,v in pairs(lamps_table) do
		obj = get_story_object(k)

		if obj then
			obj:get_hanging_lamp():turn_off()
		else
		end
	end
end

function turn_on_lonl_house_lamps(actor, npc)
	local lamps_table = {
							["lonl_house_lamp1"] = true,
							["lonl_house_lamp2"] = true,
							["lonl_house_lamp3"] = true,
							["lonl_house_lamp4"] = true,
						}
	local obj
	for k,v in pairs(lamps_table) do
		obj = get_story_object(k)

		if obj then
			obj:get_hanging_lamp():turn_on()
		else
		end
	end
end

function lonl_house_generator_timer()
start_game_timer(720*60, "mod_timer_functions.lonl_house_generator_timer_action")
news_manager.send_tip(db.actor, "generator_timer_tip", nil, "default", nil, nil)
end



