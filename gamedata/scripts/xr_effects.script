-- Вертолёт: -------
function helicrash_artefact_spawn()
rnd = math.random(1, 3)
if rnd == 1 then 
helicrash_artefact_spawn1()
end
if rnd == 2 then 
helicrash_artefact_spawn2()
end
if rnd == 3 then 
helicrash_artefact_spawn3()
end
end

function helicrash_artefact_spawn1()
xr_effects.spawn_object(actor, nil, {"helicrash_rnd_artefact","helicrash_anomaly_spawn_point3"})
helicrash_anomalys_spawn()
end

function helicrash_artefact_spawn2()
xr_effects.spawn_object(actor, nil, {"helicrash_rnd_artefact","helicrash_anomaly_spawn_point4"})
helicrash_anomalys_spawn()
end

function helicrash_artefact_spawn3()
xr_effects.spawn_object(actor, nil, {"helicrash_rnd_artefact","helicrash_anomaly_spawn_point7"})
helicrash_anomalys_spawn()
end

-- и сопутствующие аномалии:
function helicrash_anomalys_spawn()
local point1 = patrol("helicrash_anomaly_spawn_point1")
local lv1 = point1:level_vertex_id()
local gv1 = point1:game_vertex_id()
sgm_packet.create_anomaly("helicrash_anom_1",2,lv1,gv1)
local point2 = patrol("helicrash_anomaly_spawn_point2")
local lv2 = point2:level_vertex_id()
local gv2 = point2:game_vertex_id()
sgm_packet.create_anomaly("helicrash_anom_2",2,lv2,gv2)
local point3 = patrol("helicrash_anomaly_spawn_point3")
local lv3 = point3:level_vertex_id()
local gv3 = point3:game_vertex_id()
sgm_packet.create_anomaly("helicrash_anom_3",2,lv3,gv3)
local point4 = patrol("helicrash_anomaly_spawn_point4")
local lv4 = point4:level_vertex_id()
local gv4 = point4:game_vertex_id()
sgm_packet.create_anomaly("helicrash_anom_4",2,lv4,gv4)
local point5 = patrol("helicrash_anomaly_spawn_point5")
local lv5 = point5:level_vertex_id()
local gv5 = point5:game_vertex_id()
sgm_packet.create_anomaly("helicrash_anom_5",2,lv5,gv5)
local point6 = patrol("helicrash_anomaly_spawn_point6")
local lv6 = point6:level_vertex_id()
local gv6 = point6:game_vertex_id()
sgm_packet.create_anomaly("helicrash_anom_6",2,lv6,gv6)
local point7 = patrol("helicrash_anomaly_spawn_point7")
local lv7 = point7:level_vertex_id()
local gv7 = point7:game_vertex_id()
sgm_packet.create_anomaly("helicrash_anom_7",2,lv7,gv7)
end

function delete_helicrash_anomalys()
xr_effects.delete_helicrash_anom_1()
xr_effects.delete_helicrash_anom_2()
xr_effects.delete_helicrash_anom_3()
xr_effects.delete_helicrash_anom_4()
xr_effects.delete_helicrash_anom_5()
xr_effects.delete_helicrash_anom_6()
xr_effects.delete_helicrash_anom_7()
end

