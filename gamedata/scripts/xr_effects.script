function knife_achivement_check()
if xr_conditions.actor_armed_knife() == true and xr_conditions.maroder_lider4_near() == true then
	local counter_name = "knife"
		local cnt_value = xr_logic.pstor_retrieve(db.actor, counter_name, 0)
