function mark_mg_deadzone1()
if xr_conditions.is_render_r1() == true or xr_conditions.is_render_r2() == true then
	mark_mg_deadzone_zone1a()
end
if xr_conditions.is_render_r3() == true or xr_conditions.is_render_r4() == true then
	mark_mg_deadzone_zone1b()
end
end

function mark_mg_deadzone_zone1a()
   local obj = get_story_object("mg_deadzone")
   local obj_id = obj:id()
   if obj_id then
   text = "Безопасная зона"
	level.map_add_object_spot_ser(obj_id,"mg_deathzone_mark1a",text)
   end
end

