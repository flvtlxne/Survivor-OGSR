function stress_effect1()
if db.actor:dont_has_info("actor_set_maroder") then
	get_hud():AddCustomStatic("stress_indicator1",true) 
	get_hud():RemoveCustomStatic("stress_indicator2",true)
	get_hud():RemoveCustomStatic("stress_indicator3",true)
end
end

function stress_effect2()
if db.actor:dont_has_info("actor_set_maroder") then
	get_hud():AddCustomStatic("stress_indicator2",true) 
	get_hud():RemoveCustomStatic("stress_indicator1",true)
	get_hud():RemoveCustomStatic("stress_indicator3",true)
end
end

function stress_effect3()
if db.actor:dont_has_info("actor_set_maroder") then
	get_hud():AddCustomStatic("stress_indicator3",true) 
	get_hud():RemoveCustomStatic("stress_indicator1",true)
	get_hud():RemoveCustomStatic("stress_indicator2",true)
	local health = db.actor.health
	if health >= 0.9 then
		health = - 0.001
	end
end
end


