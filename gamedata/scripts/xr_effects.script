function actor_goto_lonl_house()
local health = db.actor.health
local hud = get_hud()
			hud:HideActorMenu()
			hud:HidePdaMenu()
			db.actor:stop_talk()
			soundtrack.actor_critical_health_replic()
			mod_update.critical_health_think()
			db.actor.health = health + 1.0
			db.actor.bleeding = 1.0
			start_real_timer(5, "mod_timer_functions.critical_health_effect_action1")	-- лечим ГГ;
			start_real_timer(10, "mod_timer_functions.critical_health_effect_action2")	-- шлём типс от Незнакомца; 
			db.actor:set_actor_position(patrol("lonl_house_bed_point1"):point(0))
			level.add_pp_effector("deadcity_wake.ppe", 1924, false)
			level.show_weapon(false)
		--	xr_effects.forward_game_time(actor, nil, {"1"})		-- перематываем время на час вперёд:
		-- удаляем все инфопоршены рандомных заданий, т.к. теперь они провалены:
			disable_info("random_event_helicrash")
			disable_info("random_event_blokpost")
			disable_info("random_event_forest")
			disable_info("random_event_forest_camp")
			disable_info("random_event_graveyard")
			disable_info("random_event_razlom")
			disable_info("random_event_island")
			disable_info("random_event_rad_hill")
			disable_info("random_event_willage")
			disable_info("random_event_workshop")
			disable_info("random_event_lonl_house")
		-- а также удаляем квестовые предметы\артефакты, они больше не нужны:
			mod_update.rnd_tasks_items_delete()
end		


