function mg_scav1_mark()
if db.actor:object("af_eye_mg") ~= nil then
local sim = alife()
for a=1,65534 do
local obj = sim:object( a )
  if obj then
  local obj_id = obj.id
   if obj:section_name():find("^mg_scavenger") then
		text = "Гладиатор"
		level.map_add_object_spot_ser(obj_id,"mg_npc_scav_mark",text)
   end
  end
 end
end
end

function mg_scav2_mark()
if db.actor:object("af_eye_mg") ~= nil then
local sim = alife()
for a=1,65534 do
local obj = sim:object( a )
  if obj then
  local obj_id = obj.id
   if obj:section_name():find("^mg_scavenger_strong") then
		text = "Гладиатор"
		level.map_add_object_spot_ser(obj_id,"mg_npc_scav_mark",text)
   end
  end
 end
end
end


function del_mg_airdrop()
local sim = alife()
for i=1,65534 do
local sobj = sim:object(i)
	if sobj and sobj:name():find("^mg_airdrop") then
	sim:release(sobj,true)
	return
	end
end
end


