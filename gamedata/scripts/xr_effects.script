function spawn_lonl_house_maroders()
rnd = math.random(1, 3)
if rnd == 1 then 
lonl_house_maroders_spawn1()
end
if rnd == 2 then 
lonl_house_maroders_spawn2()
end
if rnd == 3 then 
lonl_house_maroders_spawn3()
end
end


