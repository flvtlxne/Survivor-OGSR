-- Если счётчик водки больше 0, снижаем стресс на единицу;
function lonl_house_guitar_effect()
local counter_name = "vodka"
	local cnt_value = xr_logic.pstor_retrieve(db.actor, counter_name, 0)
	if cnt_value > 0 then
		xr_effects.dec_counter(db.actor, nil, {"stress",1})
	end
end		
	
	
