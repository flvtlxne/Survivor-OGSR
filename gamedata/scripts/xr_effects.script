function actor_mg_deathzone_effect()
if db.actor:object("af_dummy_glassbeads_mg") == nil then
	if xr_conditions.actor_wears_rad_protection() == false then
		soundtrack.radhit()
		db.actor.health = -0.01
		db.actor.radiation = 0.004
		level.add_pp_effector("radiation.ppe", 2111, false)
		mg_deathzone_hudicon1()
	elseif xr_conditions.actor_wears_rad_protection() == true then
		soundtrack.radhit()
		db.actor.health = -0.004
		db.actor.radiation = 0.001
		mg_deathzone_hudicon2()
	end
elseif db.actor:object("af_dummy_glassbeads_mg") ~= nil then
	db.actor.radiation = 0.001
	mg_deathzone_hudicon2()
end
end


function mg_deathzone_hudicon1()
	local st = get_hud():GetCustomStatic("mg_deathzone_hudicon1") or get_hud():AddCustomStatic("mg_deathzone_hudicon1",true)
	st.m_endTime = time_global()/1000 + 1
	get_hud():RemoveCustomStatic("mg_deathzone_hudicon2",true)
end

