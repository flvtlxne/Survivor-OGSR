function actor_vodka_overdose_think()
level.add_pp_effector("deadcity_wake.ppe", 1224, false)
	local st = get_hud():GetCustomStatic("actor_vodka_overdose_think") or get_hud():AddCustomStatic("actor_vodka_overdose_think",true)
	st.m_endTime = time_global()/1000 + 2
end
	
	
	
function actor_set_maroder_action()
xr_effects.inc_faction_goodwill_to_actor(db.actor, nil, {"bandit", 100})
change_actor_community(nil,nil,{"bandit"})
actor_teleport_to_random_place()
relocate_actor_inventory_to_box(db.actor, nil, {"lonl_house_invbox_3"})
mod_functions.remove_items("actors_note", 1)
alife():create('novice_outfit', db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
spawn_maroder_companions()
give_random_maroders_equip1()
give_random_maroders_equip2()
give_random_maroders_equip3()
disable_info("note_using")
start_real_timer(8, "mod_timer_functions.actor_maroder_think")
mod_update.rnd_tasks_items_delete()
get_hud():RemoveCustomStatic("stress_indicator1",true)
get_hud():RemoveCustomStatic("stress_indicator2",true)
get_hud():RemoveCustomStatic("stress_indicator3",true)
db.actor.health = 1.0
end



function actor_teleport_to_random_place()
rnd = math.random(1, 8)
if rnd == 1 then 
	actor_maroder_tepelort1()
end
if rnd == 2 then 
	actor_maroder_tepelort_graveyard()
end
if rnd == 3 then
	actor_maroder_tepelort3()
end
if rnd == 4 then 
	actor_maroder_tepelort4()
end
if rnd == 5 then 
	actor_maroder_tepelort5()
end
if rnd == 6 then 
	actor_maroder_tepelort6()
end
if rnd == 7 then 
	actor_maroder_tepelort_forest()
end
if rnd == 8 then 
	actor_maroder_tepelort_island()
end

end


function actor_maroder_tepelort1()
if db.actor:dont_has_info("stranger_talk4") then
	actor_maroder_tepelort_willage()
elseif has_alife_info("stranger_talk4") then
	actor_maroder_tepelort_graveyard()
end
end

function actor_maroder_tepelort3()
if db.actor:dont_has_info("shron_merc_lider_pda_info") then
	actor_maroder_tepelort_kpp()
elseif has_alife_info("shron_merc_lider_pda_info") then
	actor_maroder_tepelort_forest()
end
end

function actor_maroder_tepelort4()
if db.actor:dont_has_info("stranger_talk3") then
	actor_maroder_tepelort_razlom()
elseif has_alife_info("stranger_talk3") then
	actor_maroder_tepelort_island()
end
end

function actor_maroder_tepelort5()
if db.actor:dont_has_info("hostage_scenar_maroder_talk1") then
	actor_maroder_tepelort_kolhoz()
elseif has_alife_info("hostage_scenar_maroder_talk1") then
	actor_maroder_tepelort_forest()
end
end

function actor_maroder_tepelort6()
if db.actor:dont_has_info("stranger_talk2") then
	actor_maroder_tepelort_forest_camp()
elseif has_alife_info("stranger_talk2") then
	actor_maroder_tepelort_island()
end
end



function actor_maroder_tepelort_willage()
	db.actor:set_actor_position(patrol("travel_point_willage"):point(0))
	disable_info("random_event_willage")
	db.actor:give_info_portion ("rnd_task_willage_discard")
	spawn_actor_enemy_willage()
	delete_willage_maroders()
	delete_willage_mobs()
	delete_willage_anomalys()
	xr_effects.clear_box(actor, nil, {"willage_invbox_1"})
	xr_effects.clear_box(actor, nil, {"willage_invbox_2"})
	xr_effects.clear_box(actor, nil, {"willage_invbox_3"})
	--news_manager.send_tip(db.actor, "willage", nil, "default", 10000, nil)
end

