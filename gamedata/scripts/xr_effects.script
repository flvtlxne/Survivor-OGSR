function turn_on_lake_art_lamp(actor, npc)
	local lamps_table = {
							["lake_art_light"] = true,
						}
	local obj
	for k,v in pairs(lamps_table) do
		obj = get_story_object(k)

		if obj then
			obj:get_hanging_lamp():turn_on()
		else
		end
	end
end
	
function turn_off_lake_art_lamp(actor, npc)
	local lamps_table = {
							["lake_art_light"] = true,
						}
	local obj
	for k,v in pairs(lamps_table) do
		obj = get_story_object(k)

		if obj then
			obj:get_hanging_lamp():turn_off()
		else
		end
	end
end


