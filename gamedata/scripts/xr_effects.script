function give_mg_zone_last_phase_info()
if db.actor:dont_has_info("village_seif1_opened") then
rnd = math.random(1, 11)
if rnd == 1 then 
db.actor:give_info_portion("mg_zone_helicrash")
end
if rnd == 2 then 
db.actor:give_info_portion("mg_zone_kpp")
end
if rnd == 3 then 
db.actor:give_info_portion("mg_zone_forest")
end
if rnd == 4 then 
db.actor:give_info_portion("mg_zone_forest_camp")
end
if rnd == 5 then 
db.actor:give_info_portion("mg_zone_graveyard")
end
if rnd == 6 then 
db.actor:give_info_portion("mg_zone_razlom")
end
if rnd == 7 then 
db.actor:give_info_portion("mg_zone_island")
end
if rnd == 8 then 
db.actor:give_info_portion("mg_zone_lonl_house")
end
if rnd == 9 then 
db.actor:give_info_portion("mg_zone_radhill")
end
if rnd == 10 then 
db.actor:give_info_portion("mg_zone_willage")
end
if rnd == 11 then 
db.actor:give_info_portion("mg_zone_workshop")
end
end
end




function send_mg_start_heli_tip1()
if db.actor:dont_has_info("mg_phase1_completed") then
	news_manager.send_tip(db.actor, "mg_start_heli_tip1", nil, "ad_pro", 14000, nil)
elseif has_alife_info("mg_phase1_completed") then
	rnd = math.random(1, 3)
	if rnd == 1 then 
		news_manager.send_tip(db.actor, "mg_start_heli_tip1_1", nil, "ad_pro", 14000, nil)
	end
	if rnd == 2 then 
		news_manager.send_tip(db.actor, "mg_start_heli_tip1_2", nil, "ad_pro", 14000, nil)
	end
	if rnd == 3 then 
		news_manager.send_tip(db.actor, "mg_start_heli_tip1_3", nil, "ad_pro", 14000, nil)
	end
end
end

