-- Спавним легендарное рыло: ------------------------------------------

function spawn_legendary_npc()
rnb = math.random(1, 14)
if rnb == 1 then 
spawn_legendary_npc1()	-- Дядька Яр
end
if rnb == 2 then 
spawn_legendary_npc2()	-- Вано
end
if rnb == 3 then 
spawn_legendary_npc3()	-- Кардан
end
if rnb == 4 then 
spawn_legendary_npc4()	-- Зулус
end
if rnb == 5 then 
spawn_legendary_npc5()	-- Меченый
end
if rnb == 6 then 
spawn_legendary_npc6()	-- Азот
end
if rnb == 7 then 
spawn_legendary_npc7()	-- Ной
end
if rnb == 8 then 
spawn_legendary_npc8()	-- Шарм
end
if rnb == 9 then 
spawn_legendary_npc9()	-- Бродяга
end
if rnb == 10 then 
spawn_legendary_npc10()	-- Новиков
end
if rnb == 11 then 
spawn_legendary_npc11()	-- Соколов
end
if rnb == 12 then 
spawn_legendary_npc12()	-- Отец Валерьян
end
if rnb == 13 then 
spawn_legendary_npc13()	-- Йога
end
if rnb == 14 then 
spawn_legendary_npc14()	-- Дегтярёв
end
end


