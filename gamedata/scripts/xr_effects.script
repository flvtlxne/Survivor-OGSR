function personal_dog_gohome()	-- специально для квеста;
local dog = get_story_object("personal_dog")
local karlik = get_story_object("karlik_friend")
if dog ~= nil and dog:alive() and dog:position():distance_to(db.actor:position()) < 25 then
	db.actor:give_info_portion ("personal_dog_gohome")
	--local position = patrol("travel_point_lonl_house")
	local position = patrol("travel_point_lonl_house"):point(0)
	reset_animation(dog)
	dog:set_npc_position(position)
end
if karlik and karlik ~= nil and karlik:alive() then
	delete_karlik_friend()
end
end

function personal_dog_gohome2()
local dog = get_story_object("personal_dog")
local karlik = get_story_object("karlik_friend")
if dog and dog ~= nil and dog:alive() then
	--local position = patrol("travel_point_lonl_house")
	local position = patrol("travel_point_lonl_house"):point(0)
	reset_animation(dog)
	dog:set_npc_position(position)
end
if karlik and karlik ~= nil and karlik:alive() then
	delete_karlik_friend()
end
end


