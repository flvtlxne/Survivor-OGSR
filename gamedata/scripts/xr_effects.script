function strike_to_actor(actor, npc)
 local hit = hit()
 hit.type = hit.strike
 hit.power = 0
 hit.impulse = 20
 hit.draftsman = npc
 hit.direction = db.actor:position():sub(npc:position())	--	к актору
 npc:hit(hit)
end


