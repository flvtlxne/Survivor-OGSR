function spawn_random_medicine_in_box(items_table, count, inv_box_story_id)
	local inv_box = alife():object(get_story_object_id(inv_box_story_id))
	for i = 1,count do
		alife():create(medicine_table[math.random(#medicine_table)],
			inv_box.position,
			inv_box.m_level_vertex_id,
			inv_box.m_game_vertex_id,
			inv_box.id)
	end
end

function spawn_random_food_in_box(items_table, count, inv_box_story_id)
	local inv_box = alife():object(get_story_object_id(inv_box_story_id))
	for i = 1,count do
		alife():create(food_table[math.random(#food_table)],
			inv_box.position,
			inv_box.m_level_vertex_id,
			inv_box.m_game_vertex_id,
			inv_box.id)
	end
end

