function turn_on_workshop_lamps()	
	local lamps_table = {
							["workshop_lamp1"] = true,
							["workshop_lamp2"] = true,
							["workshop_lamp3"] = true,
							["workshop_lamp4"] = true,
						}
	local obj
	for k,v in pairs(lamps_table) do
		obj = get_story_object(k)

		if obj then
			obj:get_hanging_lamp():turn_on()
		else
		end
	end
end

function turn_off_workshop_lamps()	
	local lamps_table = {
							["workshop_lamp1"] = true,
							["workshop_lamp2"] = true,
							["workshop_lamp3"] = true,
							["workshop_lamp4"] = true,
						}
	local obj
	for k,v in pairs(lamps_table) do
		obj = get_story_object(k)

		if obj then
			obj:get_hanging_lamp():turn_off()
		else
		end
	end
end



