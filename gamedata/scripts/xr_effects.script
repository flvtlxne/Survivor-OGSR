function clear_weapons_around_actor1000()
local sim = alife()
for i=1,65534 do
local sobj = sim:object(i)
	if sobj and isWeapon(sobj) and sobj.position:distance_to(db.actor:position()) < 1000	then
		alife():release(sobj, true)
	end
end
end

function clear_outfit_around_actor1000a()
local sim = alife()
for i=1,65534 do
local sobj = sim:object(i)
	if sobj and isOutfit(sobj) and sobj.position:distance_to(db.actor:position()) < 1000	then
		alife():release(sobj, true)
	end
end
end

function clear_outfit_around_actor1000b()
local sim = alife()
for i=1,65534 do
local sobj = sim:object(i)
	if sobj and isOutfit(sobj) and not sobj:name():find("^scientific_outfit") and sobj.position:distance_to(db.actor:position()) < 1000	then
		alife():release(sobj, true)
	end
end
end

function clear_dead_npc_around_actor1000()
local sim = alife()
for i=1,65534 do
local sobj = sim:object(i)
	if sobj and IsStalker(sobj) and not sobj:alive() and not sobj:name():find("^mg_art_robber_npc") and not sobj:name():find("^mg_agent_courier") and sobj.position:distance_to(db.actor:position()) < 1000	then
		alife():release(sobj, true)
	end
end
end

function clear_ammo_around_actor1000()
local sim = alife()
for i=1,65534 do
local sobj = sim:object(i)
	if sobj and isAmmo(sobj) and sobj.position:distance_to(db.actor:position()) < 1000	then
		alife():release(sobj, true)
	end
end
end

function clear_addons_around_actor1000()
local sim = alife()
for i=1,65534 do
local sobj = sim:object(i)
	if sobj and isAddon(sobj) and sobj.position:distance_to(db.actor:position()) < 1000 then
		alife():release(sobj, true)
	end
end
end

function clear_food_medicine_around_actor1000()
local sim = alife()
for i=1,65534 do
local sobj = sim:object(i)
	if sobj and isEatable(sobj) and ( sobj.position:distance_to(db.actor:position()) < 1000 and sobj.position:distance_to(db.actor:position()) > 25 ) then
		alife():release(sobj, true)
	end
end
end

function clear_explosive_around_actor1000()
local sim = alife()
for i=1,65534 do
local sobj = sim:object(i)
	if sobj and isExplosive(sobj) and sobj.position:distance_to(db.actor:position()) < 1000 then
		alife():release(sobj, true)
	end
end
end


