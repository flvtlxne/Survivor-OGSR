function mark_helicrash_maroders_box1()
   local obj = get_story_object("helicrash_box")
   local obj_id = obj:id()
   if obj_id then
   text = "Схрон мародёров"
	level.map_add_object_spot_ser(obj_id,"treasure",text)
   end
end
	
function unmark_helicrash_maroders_box1()
   local obj = get_story_object("helicrash_box")
   local obj_id = obj:id()
   if obj_id then
   text = "Схрон мародёров"
	level.map_remove_object_spot(obj_id,"treasure",text)
   end
end



