function mg_npc_scav_indicator()
	local st = get_hud():GetCustomStatic("mg_npc_scav_indicator") or get_hud():AddCustomStatic("mg_npc_scav_indicator",true)
	st.m_endTime = time_global()/1000 + 1
end

function mg_npc_scav_indicator_off()
	get_hud():RemoveCustomStatic("mg_npc_scav_indicator",true)
end


function actor_back_to_mg_start_zone()
db.actor:set_actor_position(patrol("mg_actor_start_point"):point(0))
run_gui(mod_devices.mg_start_interface())
end

function start_mg_choise_gui()
run_gui(mod_devices.mg_start_interface())
end

