-- Легарь в лесу:
function spawn_forest_camp_mutants()
rnd = math.random(1, 3)
if rnd == 1 then 
spawn_forest_camp_mutants1()
end
if rnd == 2 then 
spawn_forest_camp_mutants2()
end
if rnd == 3 then 
spawn_forest_camp_mutants3()
end
end


