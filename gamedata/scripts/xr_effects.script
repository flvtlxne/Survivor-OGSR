function ambush_marodr_guard_weapons_remowe()
local npc = get_story_object("ambush_scenar_maroder_guard1")
local item1 = npc:object("wpn_pm")
local item2 = npc:object("wpn_bm16")
local item3 = npc:object("wpn_lr300")
local item4 = npc:object("wpn_ak74")
local item5 = npc:object("wpn_ak74u")
local item6 = npc:object("wpn_toz34")
	if item1 then
		alife():release(alife():object(item1:id()), true)
	end
	if item2 then
		alife():release(alife():object(item2:id()), true)
	end
	if item3 then
		alife():release(alife():object(item3:id()), true)
	end
	if item4 then
		alife():release(alife():object(item4:id()), true)
	end
	if item5 then
		alife():release(alife():object(item5:id()), true)
	end
	if item6 then
		alife():release(alife():object(item6:id()), true)
	end
end


