function actor_go_to_lonl_house()
db.actor:set_actor_position(patrol("lonl_house_bed_point1"):point(0))
xr_effects.inc_faction_goodwill_to_actor(db.actor, nil, {"bandit", -100})
	db.actor.health = 1.0
	db.actor.power = 1.0
	db.actor.radiation = -1.0
	db.actor.bleeding = 1.0
change_actor_community(nil,nil,{"army"})
	local counter_name = "alco"
	local cnt_value = xr_logic.pstor_retrieve(db.actor, counter_name, 0)
	if cnt_value < 5 then
		xr_effects.inc_counter(db.actor, nil, {"alco",1})
	end
end	
	
	
