function mg_heli_evacuation_result()
local obj = get_story_object("mg_start_heli")
if distance_between(obj, db.actor) <= 11 then
	db.actor:give_info_portion ("mg_heli_evac_sucess")
elseif distance_between(obj, db.actor) > 11 then
	db.actor:give_info_portion ("mg_heli_evac_fail")
end
end



function actor_after_evac_rest()
start_real_timer(3, "xr_effects.actor_after_evac_rest_travel")
db.actor:give_info_portion ("invulnerability")
end

function actor_after_evac_rest_travel()
db.actor:set_actor_position(patrol("kpp_bunker_rest_pnt1"):point(0))
--db.actor:set_actor_direction(patrol("kpp_bunker_rest_pnt2"):point(0))
db.actor:set_actor_direction(patrol("mg_kpp_guard2_walk1"):point(0))
disable_info("invulnerability")
db.actor.health = 1.0
db.actor.power = 1.0
db.actor.radiation = -1.0
db.actor.bleeding = 1.0
enable_ui()
release_scenario_objects()
delete_all_cars()
delete_all_cars()
delete_all_cars()
start_real_timer(2, "xr_effects.delete_all_cars")

clear_weapons_around_actor1000()
if db.actor:dont_has_info("mg_wolf_map_info") then
	clear_outfit_around_actor1000a()
elseif has_alife_info("mg_companion1_saved") then
	clear_outfit_around_actor1000b()
end
clear_dead_npc_around_actor1000()
clear_ammo_around_actor1000()
clear_addons_around_actor1000()
clear_food_medicine_around_actor1000()
clear_explosive_around_actor1000()

delete_mg_companion1()
disable_info("mg_heli_evac_sucess")
spawn_kpp_bunker_food1()
spawn_kpp_bunker_food2()
spawn_kpp_bunker_food3()


-- Типа сюжетные поползновения: -----------------------------------------

if has_alife_info("mg_companion1_saved") and db.actor:dont_has_info("mg_companion1_help_actor") then
	mod_functions.script_spawn("mg_friend_zapiska1", "derevnya", vector():set(-562.87811279297, 15.98973941803, 111.31999969482) )
	mg_autosave2()
	news_manager.send_tip(db.actor, "mg_companion1_note_tip", nil, "stalker", 14000, nil)
	db.actor:give_info_portion ("mg_companion1_help_actor")
end

end


