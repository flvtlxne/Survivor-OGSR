--function mg_heli_spawn_airdrop()
--local npc = get_story_object("mg_start_heli")
--	local pos = npc:position()
--	alife():create("mg_airdrop", vector():set(pos.x, pos.y-1, pos.z), npc:level_vertex_id(), npc:game_vertex_id())
--	spawn_mg_scav()
--end


function mg_heli_spawn_airdrop()
local sim = alife()
for a=1,65534 do
local obj = sim:object( a )
  if obj then
  local obj_id = obj.id
   if obj:section_name():find("^mg_start_heli") then
		local pos = obj:position()
		alife():create("mg_airdrop", vector():set(pos.x, pos.y-1, pos.z), npc:level_vertex_id(), npc:game_vertex_id())
		spawn_mg_scav()
		start_real_timer(1, "xr_effects.mg_airdrop_mark")
   end
  end
 end
end

function mg_airdrop_mark()
local sim = alife()
for a=1,65534 do
local obj = sim:object( a )
  if obj then
  local obj_id = obj.id
   if obj:section_name():find("^mg_airdrop") then
		text = "Груз с вертолёта"
		level.map_add_object_spot_ser(obj_id,"mg_airdrop_mark",text)
   end
  end
 end
end



