class "mechanical_others" (CUIScriptWnd)
function mechanical_others:__init(owner) super()
	self.dlg = self
	self.owner = owner
	self:InitControls()
	self:InitCallBacks()
end

function mechanical_others:__finalize() end

function mechanical_others:InitControls()
	-- здесь определяем координаты левого верхнего угла и ширину-высоту
	self:SetWndRect(Frect():set(0,0,1024,768))

	-- файл-описатель наших элементов
	local xml = CScriptXmlInit()
	xml:ParseFile("ui_mechanical_others.xml")

	xml:InitStatic("table", self)
	xml:InitStatic("name", self)
	xml:InitStatic("text1", self)
	xml:InitStatic("text2", self)
	xml:InitStatic("text3", self)
	
	-- значки "материалы есть": создаём сразу, а показываем в refresh_buttons()
	self.ind_1 = xml:InitStatic("indicator1", self)
	self.ind_2 = xml:InitStatic("indicator2", self)
	self.ind_3 = xml:InitStatic("indicator3", self)

	-- кнопки
	self.btn_1 = xml:Init3tButton("btn_1", self)
	self:Register(self.btn_1, "btn_1")
	self.btn_1:Enable(false)
	self.btn_2 = xml:Init3tButton("btn_2", self)
	self:Register(self.btn_2, "btn_2")
	self.btn_2:Enable(false)
	self.btn_3 = xml:Init3tButton("btn_3", self)
	self:Register(self.btn_3, "btn_3")
	self.btn_3:Enable(false)
	--self.btn_4 = xml:Init3tButton("btn_4", self)
	--self:Register(self.btn_4, "btn_4")
	--self.btn_4:Enable(false)
	--self.btn_5 = xml:Init3tButton("btn_5", self)
	--self:Register(self.btn_5, "btn_5")
	--self.btn_5:Enable(false)

	-- кнопка офф
	self:Register(xml:Init3tButton("btn_exit", self),"btn_exit")
	-- кнопка назад
	self:Register(xml:Init3tButton("btn_back", self),"btn_back")

	self:refresh_buttons()
end

-- Survivor: доступность кнопок и значки материалов пересчитываем каждый кадр.
function mechanical_others:refresh_buttons()
	local remkit = actor_has_all("car_item_bearing", "car_item_avtol", "car_item_litol", "car_item_wrenches",
		"car_item_wiring", "car_item_domkrat", "car_item_wd40", "car_item_akumulator", "car_item_tyre")
	local bomb = actor_has_all("gas_balon", "car_item_wiring", "car_item_akumulator")
	local courier = actor_has_all("maroder_courier_item")
	self.btn_1:Enable(remkit)
	self.btn_2:Enable(bomb)
	self.btn_3:Enable(courier)
	self.ind_1:Show(remkit)
	self.ind_2:Show(bomb)
	self.ind_3:Show(courier)
end

function mechanical_others:Update()
	CUIScriptWnd.Update(self)
	self:refresh_buttons()
end

function mechanical_others:InitCallBacks()
	-- тут интерактивные элементы, при определенном действии выполняется заданная ф-ия
	self:AddCallback("btn_1", ui_events.BUTTON_CLICKED,  self.btn1, self)
	self:AddCallback("btn_2", ui_events.BUTTON_CLICKED,  self.btn2, self)
	self:AddCallback("btn_3", ui_events.BUTTON_CLICKED,  self.btn3, self)
	--self:AddCallback("btn_4", ui_events.BUTTON_CLICKED,  self.btn4, self)
	--self:AddCallback("btn_5", ui_events.BUTTON_CLICKED,  self.btn5, self)
	--self:AddCallback("btn_6", ui_events.BUTTON_CLICKED,  self.btn6, self)
	--self:AddCallback("btn_7", ui_events.BUTTON_CLICKED,  self.btn7, self)
	self:AddCallback("btn_exit", ui_events.BUTTON_CLICKED, self.on_quit, self)
	self:AddCallback("btn_back", ui_events.BUTTON_CLICKED, self.on_back, self)
end

function mechanical_others:btn1()

	if db.actor:object("car_item_bearing") ~= nil and db.actor:object("car_item_avtol") ~= nil and db.actor:object("car_item_litol") ~= nil and db.actor:object("car_item_wrenches") ~= nil and db.actor:object("car_item_wiring") ~= nil and db.actor:object("car_item_domkrat") ~= nil and db.actor:object("car_item_wd40") ~= nil and db.actor:object("car_item_akumulator") ~= nil and db.actor:object("car_item_tyre") ~= nil then
		start_real_timer(3, "mod_timer_functions.mechanical_construction_timer_action")
		soundtrack.repair_sounds()
		mod_functions.remove_items("car_item_bearing", 1)
		mod_functions.remove_items("car_item_avtol", 1)
		mod_functions.remove_items("car_item_litol", 1)
		mod_functions.remove_items("car_item_wrenches", 1)
		mod_functions.remove_items("car_item_wiring", 1)
		mod_functions.remove_items("car_item_domkrat", 1)
		mod_functions.remove_items("car_item_wd40", 1)
		mod_functions.remove_items("car_item_akumulator", 1)
		mod_functions.remove_items("car_item_tyre", 1)
		alife():create('car_remkit', db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
		xr_effects.dec_counter(db.actor, nil, {"generator",1})
	end
end

function mechanical_others:btn2()

	if db.actor:object("gas_balon") ~= nil and db.actor:object("car_item_wiring") ~= nil and db.actor:object("car_item_akumulator") ~= nil then
		start_real_timer(3, "mod_timer_functions.mechanical_construction_timer_action")
		soundtrack.repair_sounds()
		mod_functions.remove_items("gas_balon", 1)
		mod_functions.remove_items("car_item_wiring", 1)
		mod_functions.remove_items("car_item_akumulator", 1)
		alife():create('item_bomb', db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
		alife():create('detonator', db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
		xr_effects.dec_counter(db.actor, nil, {"generator",1})
	end
end

function mechanical_others:btn3()
	self:HideDialog()
	if db.actor:object("maroder_courier_item") ~= nil then
		soundtrack.repair_sounds()
		start_real_timer(3, "mod_timer_functions.mechanical_construction_timer_action")
		mod_functions.remove_items("maroder_courier_item", 1)
		xr_effects.dec_counter(db.actor, nil, {"generator",1})
		mod_functions.maroder_item_reward()
		xr_effects.delete_maroder_courier()
		disable_info("courier_task")
		disable_info("courier_task_fail")
	end
end

function mechanical_others:btn4()

end

function mechanical_others:btn5()

end


function mechanical_others:on_back()
	self:HideDialog()
	run_gui(mod_devices.mechanical_interface())
end


function mechanical_others:OnKeyboard(dik,keyboard_action)
   CUIScriptWnd.OnKeyboard(self,dik,keyboard_action)
   if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
      if dik == DIK_keys.DIK_ESCAPE then
      self:on_quit()
      end	  
   end
   return true
end

function mechanical_others:on_quit()
	self:HideDialog()
end


