	self:refresh_buttons()
end

-- Survivor: доступность кнопок пересчитываем каждый кадр, а не только при
-- открытии окна: израсходованные материалы пропадают из инвентаря с задержкой.
function laboratory_interface:refresh_buttons()
	self.btn_1:Enable(actor_has_all("chem_item_antiseptic", "bandage"))
	self.btn_2:Enable(actor_has_all("chem_item_antiseptic", "bandage", "chem_item_harness"))
	self.btn_3:Enable(actor_has_all("chem_item_antiseptic", "chem_item_rags"))
	self.btn_4:Enable(actor_has_all("chem_item_injector", "chem_item_liquor", "chem_item_yod"))
	self.btn_5:Enable(actor_has_all("chem_item_injector", "chem_item_liquor", "chem_item_antiseptic"))
	self.btn_6:Enable(actor_has_all("chem_item_meldoniy", "chem_item_cofeine", "chem_item_gematogen"))
	self.btn_7:Enable(actor_has_all("chem_item_injector", "chem_item_liquor", "chem_item_coal"))
	self.btn_8:Enable(actor_has_all("chem_item_yeast", "chem_item_sugar"))
end

function laboratory_interface:Update()
	CUIScriptWnd.Update(self)
	self:refresh_buttons()
end

function laboratory_interface:InitCallBacks()
	-- тут интерактивные элементы, при определенном действии выполняется заданная ф-ия
	self:AddCallback("btn_1", ui_events.BUTTON_CLICKED,  self.btn1, self)
	self:AddCallback("btn_2", ui_events.BUTTON_CLICKED,  self.btn2, self)
	self:AddCallback("btn_3", ui_events.BUTTON_CLICKED,  self.btn3, self)
	self:AddCallback("btn_4", ui_events.BUTTON_CLICKED,  self.btn4, self)
	self:AddCallback("btn_5", ui_events.BUTTON_CLICKED,  self.btn5, self)
	self:AddCallback("btn_6", ui_events.BUTTON_CLICKED,  self.btn6, self)
	self:AddCallback("btn_7", ui_events.BUTTON_CLICKED,  self.btn7, self)
	self:AddCallback("btn_8", ui_events.BUTTON_CLICKED,  self.btn8, self)
	self:AddCallback("btn_exit", ui_events.BUTTON_CLICKED, self.on_quit, self)
end

function laboratory_interface:btn1()
	
	if db.actor:object("chem_item_antiseptic") ~= nil and db.actor:object("bandage") ~= nil then
		mod_functions.remove_items("chem_item_antiseptic", 1)
		mod_functions.remove_items("bandage", 1)
		alife():create('medkit_amateur1', db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
		soundtrack.lab_item_creating()
		xr_effects.dec_counter(db.actor, nil, {"balon",1})
	end
end

