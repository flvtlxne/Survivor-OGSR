function mg_start_interface:btn12()
	--self:HideDialog()
	rnd = math.random(1, 11)
		if rnd == 1 then 
			self:btn1()
		end
		if rnd == 2 then 
			self:btn2()
		end
		if rnd == 3 then 
			self:btn3()
		end
		if rnd == 4 then 
			self:btn4()
		end
		if rnd == 5 then 
			self:btn5()
		end
		if rnd == 6 then 
			self:btn6()
		end
		if rnd == 7 then 
			self:btn7()
		end
		if rnd == 8 then 
			self:btn8()
		end
		if rnd == 9 then 
			self:btn9()
		end
		if rnd == 10 then 
			self:btn10()
		end
		if rnd == 11 then 
			self:btn11()
		end
	
end

