function after_death_master_interface:btn1()
	self:HideDialog()
	xr_effects.load_master_game_start_save()
	xr_effects.game_disconnect()
end

function after_death_master_interface:btn2()
	self:HideDialog()
	xr_effects.game_disconnect()
end

function after_death_master_interface:OnKeyboard(dik, keyboard_action)
	CUIScriptWnd.OnKeyboard(self,dik,keyboard_action)
	if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
		if dik == DIK_keys.DIK_SPACE then
			self:HideDialog()
			xr_effects.load_master_game_start_save()
		end
	end
	return true
end



