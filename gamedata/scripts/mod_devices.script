class "mechanical_interface" (CUIScriptWnd)
function mechanical_interface:__init(owner) super()
	self.dlg = self
	self.owner = owner
	self:InitControls()
	self:InitCallBacks()
end

function mechanical_interface:__finalize() end

function mechanical_interface:InitControls()
	-- здесь определяем координаты левого верхнего угла и ширину-высоту
	self:SetWndRect(Frect():set(0,0,1024,768))

	-- файл-описатель наших элементов
	local xml = CScriptXmlInit()
	xml:ParseFile("ui_mechanical_interface.xml")

	xml:InitStatic("table", self)
	xml:InitStatic("name", self)
	xml:InitStatic("text1", self)

	-- кнопки
	self.btn_1 = xml:Init3tButton("btn_1", self)
	self:Register(self.btn_1, "btn_1")
	self.btn_1:Enable(false)
	self.btn_2 = xml:Init3tButton("btn_2", self)
	self:Register(self.btn_2, "btn_2")
	self.btn_2:Enable(false)
	self.btn_3 = xml:Init3tButton("btn_3", self)
	self:Register(self.btn_3, "btn_3")
	self.btn_3:Enable(false)
	self.btn_4 = xml:Init3tButton("btn_4", self)
	self:Register(self.btn_4, "btn_4")
	self.btn_4:Enable(false)

	-- кнопка офф
	self:Register(xml:Init3tButton("btn_exit", self),"btn_exit")

	-- определяем доступность кнопок
	self.btn_1:Enable(true)
	self.btn_2:Enable(true)
	self.btn_3:Enable(true)
	self.btn_4:Enable(true)
end

function mechanical_interface:InitCallBacks()
	-- тут интерактивные элементы, при определенном действии выполняется заданная ф-ия
	self:AddCallback("btn_1", ui_events.BUTTON_CLICKED,  self.btn1, self)
	self:AddCallback("btn_2", ui_events.BUTTON_CLICKED,  self.btn2, self)
	self:AddCallback("btn_3", ui_events.BUTTON_CLICKED,  self.btn3, self)
	self:AddCallback("btn_4", ui_events.BUTTON_CLICKED,  self.btn4, self)
	self:AddCallback("btn_exit", ui_events.BUTTON_CLICKED, self.on_quit, self)
end

function mechanical_interface:btn1()	-- разобрать оружие;
	self:HideDialog()
	run_gui(mod_devices.mechanical_take_apart())
end

function mechanical_interface:btn2()	-- собрать оружие;
	self:HideDialog()
	run_gui(mod_devices.mechanical_construct())
end

function mechanical_interface:btn3()	-- апгрейд\ремонт;
	self:HideDialog()
	xr_effects.spawn_mechanical_npc1()
	start_real_timer(1, "mod_timer_functions.mechanical_npc1use_action")
end

function mechanical_interface:btn4()	-- прочее;
	self:HideDialog()
	run_gui(mod_devices.mechanical_others())
end

function mechanical_interface:OnKeyboard(dik,keyboard_action)
   CUIScriptWnd.OnKeyboard(self,dik,keyboard_action)
   if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
      if dik == DIK_keys.DIK_ESCAPE then
      self:on_quit()
      end	  
   end
   return true
end

function mechanical_interface:on_quit()
	self:HideDialog()
end

-- Survivor: кнопка "Разобрать всё". Сколько наборов деталей даёт каждый
-- ствол - так же, как у кнопок для отдельного оружия.
local take_apart_parts = {
	wpn_pm = 1, pm_wrecked = 1, wpn_pb = 1, wpn_bm16 = 1, wpn_usp = 1,
	wpn_hpsa = 1, wpn_toz34 = 2, wpn_ak74u = 2, aksu_wrecked = 2,
	wpn_ak74 = 2, wpn_lr300 = 2, wpn_vintorez = 2, wpn_bizon = 1,
	wpn_sayga = 2, wpn_m1891 = 1,
}

-- Всё оружие в рюкзаке, которое можно разобрать. Оружие в слотах пропускаем.
local function take_apart_all_list()
	local skip = {}
	for _, slot in ipairs({2, 3}) do
		local item = db.actor:item_in_slot(slot)
		if item then
			skip[item:id()] = true
		end
	end
	local list = {}
	for i = 0, db.actor:object_count() - 1 do
		local item = db.actor:object(i)
		if item and take_apart_parts[item:section()] and not skip[item:id()] then
			table.insert(list, item)
		end
	end
	return list
end

-- Survivor: есть ли у ГГ хотя бы по одному предмету каждой из секций.
local function actor_has_all(...)
	for _, sect in ipairs({...}) do
		if db.actor:object(sect) == nil then
			return false
		end
	end
	return true
end

-- разборка оружия: --------------------------
class "mechanical_take_apart" (CUIScriptWnd)
function mechanical_take_apart:__init(owner) super()
	self.dlg = self
	self.owner = owner
	self:InitControls()
	self:InitCallBacks()
end

function mechanical_take_apart:__finalize() end

function mechanical_take_apart:InitControls()
	-- здесь определяем координаты левого верхнего угла и ширину-высоту
	self:SetWndRect(Frect():set(0,0,1024,768))

	-- файл-описатель наших элементов
	local xml = CScriptXmlInit()
	xml:ParseFile("ui_mechanical_take_apart.xml")

	xml:InitStatic("table", self)
	xml:InitStatic("name", self)
	xml:InitStatic("text1", self)

	-- кнопки
	self.btn_1 = xml:Init3tButton("btn_1", self)
	self:Register(self.btn_1, "btn_1")
	self.btn_1:Enable(false)
	self.btn_2 = xml:Init3tButton("btn_2", self)
	self:Register(self.btn_2, "btn_2")
	self.btn_2:Enable(false)
	self.btn_3 = xml:Init3tButton("btn_3", self)
	self:Register(self.btn_3, "btn_3")
	self.btn_3:Enable(false)
	self.btn_4 = xml:Init3tButton("btn_4", self)
	self:Register(self.btn_4, "btn_4")
	self.btn_4:Enable(false)
	self.btn_5 = xml:Init3tButton("btn_5", self)
	self:Register(self.btn_5, "btn_5")
	self.btn_5:Enable(false)
	self.btn_6 = xml:Init3tButton("btn_6", self)
	self:Register(self.btn_6, "btn_6")
	self.btn_6:Enable(false)
	self.btn_7 = xml:Init3tButton("btn_7", self)
	self:Register(self.btn_7, "btn_7")
	self.btn_7:Enable(false)
	self.btn_8 = xml:Init3tButton("btn_8", self)
	self:Register(self.btn_8, "btn_8")
	self.btn_8:Enable(false)
	self.btn_9 = xml:Init3tButton("btn_9", self)
	self:Register(self.btn_9, "btn_9")
	self.btn_9:Enable(false)
	self.btn_10 = xml:Init3tButton("btn_10", self)
	self:Register(self.btn_10, "btn_10")
	self.btn_10:Enable(false)
	self.btn_11 = xml:Init3tButton("btn_11", self)
	self:Register(self.btn_11, "btn_11")
	self.btn_11:Enable(false)
	self.btn_12 = xml:Init3tButton("btn_12", self)
	self:Register(self.btn_12, "btn_12")
	self.btn_12:Enable(false)
	self.btn_13 = xml:Init3tButton("btn_13", self)
	self:Register(self.btn_13, "btn_13")
	self.btn_13:Enable(false)

	-- кнопка офф
	self:Register(xml:Init3tButton("btn_exit", self),"btn_exit")
	-- кнопка назад
	self:Register(xml:Init3tButton("btn_back", self),"btn_back")
	-- кнопка "Разобрать всё"
	self.btn_all = xml:Init3tButton("btn_all", self)
	self:Register(self.btn_all, "btn_all")

	self:refresh_buttons()
end

-- Survivor: доступность кнопок пересчитываем каждый кадр, а не только при
-- открытии окна: разобранное оружие пропадает из инвентаря с задержкой.
function mechanical_take_apart:refresh_buttons()
	self.btn_1:Enable(actor_has_all("wpn_pm") or actor_has_all("pm_wrecked"))
	self.btn_2:Enable(actor_has_all("wpn_pb"))
	self.btn_3:Enable(actor_has_all("wpn_bm16"))
	self.btn_4:Enable(actor_has_all("wpn_usp"))
	self.btn_5:Enable(actor_has_all("wpn_hpsa"))
	self.btn_6:Enable(actor_has_all("wpn_toz34"))
	self.btn_7:Enable(actor_has_all("wpn_ak74u") or actor_has_all("aksu_wrecked"))
	self.btn_8:Enable(actor_has_all("wpn_ak74"))
	self.btn_9:Enable(actor_has_all("wpn_lr300"))
	self.btn_10:Enable(actor_has_all("wpn_vintorez"))
	self.btn_11:Enable(actor_has_all("wpn_bizon"))
	self.btn_12:Enable(actor_has_all("wpn_sayga"))
	self.btn_13:Enable(actor_has_all("wpn_m1891"))
	self.btn_all:Enable(#take_apart_all_list() > 0)
end

function mechanical_take_apart:Update()
	CUIScriptWnd.Update(self)
	self:refresh_buttons()
end

function mechanical_take_apart:InitCallBacks()
	-- тут интерактивные элементы, при определенном действии выполняется заданная ф-ия
	self:AddCallback("btn_1", ui_events.BUTTON_CLICKED,  self.btn1, self)
	self:AddCallback("btn_2", ui_events.BUTTON_CLICKED,  self.btn2, self)
	self:AddCallback("btn_3", ui_events.BUTTON_CLICKED,  self.btn3, self)
	self:AddCallback("btn_4", ui_events.BUTTON_CLICKED,  self.btn4, self)
	self:AddCallback("btn_5", ui_events.BUTTON_CLICKED,  self.btn5, self)
	self:AddCallback("btn_6", ui_events.BUTTON_CLICKED,  self.btn6, self)
	self:AddCallback("btn_7", ui_events.BUTTON_CLICKED,  self.btn7, self)
	self:AddCallback("btn_8", ui_events.BUTTON_CLICKED,  self.btn8, self)
	self:AddCallback("btn_9", ui_events.BUTTON_CLICKED,  self.btn9, self)
	self:AddCallback("btn_10", ui_events.BUTTON_CLICKED,  self.btn10, self)
	self:AddCallback("btn_11", ui_events.BUTTON_CLICKED,  self.btn11, self)
	self:AddCallback("btn_12", ui_events.BUTTON_CLICKED,  self.btn12, self)
	self:AddCallback("btn_13", ui_events.BUTTON_CLICKED,  self.btn13, self)
	self:AddCallback("btn_all", ui_events.BUTTON_CLICKED, self.btn_take_all, self)
	self:AddCallback("btn_exit", ui_events.BUTTON_CLICKED, self.on_quit, self)
	self:AddCallback("btn_back", ui_events.BUTTON_CLICKED, self.on_back, self)
end

function mechanical_take_apart:btn1()
	
	if db.actor:object("wpn_pm") ~= nil then
		if xr_conditions.actor_in_slot_pm() == false then
			mod_functions.remove_items("wpn_pm", 1)
			alife():create('weapon_parts', db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
			soundtrack.repair_sounds()
			xr_effects.dec_counter(db.actor, nil, {"generator",1})
		elseif xr_conditions.actor_in_slot_pm() == true then
			news_manager.send_tip(db.actor, "wpn_cant_be_destroyed_tip", nil, "default", nil, nil)
			soundtrack.no_replics()
		end
	end
	
	if db.actor:object("pm_wrecked") ~= nil then
		mod_functions.remove_items("pm_wrecked", 1)
		alife():create('weapon_parts', db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
		soundtrack.repair_sounds()
		xr_effects.dec_counter(db.actor, nil, {"generator",1})
	end
end

