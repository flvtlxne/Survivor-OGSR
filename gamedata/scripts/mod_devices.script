	self.btn_2:Enable(false)

	-- кнопка офф
	self:Register(xml:Init3tButton("btn_exit", self),"btn_exit")

	-- определяем доступность кнопок
	--if db.actor:dont_has_info("random_event_blokpost") and
	--	db.actor:dont_has_info("random_event_graveyard") and
	--	db.actor:dont_has_info("random_event_rad_hill") and
	--	db.actor:dont_has_info("random_event_willage") and
	--	db.actor:dont_has_info("random_event_razlom") and
	--	db.actor:dont_has_info("random_event_island") and
	--	db.actor:dont_has_info("random_event_forest") and 
	--	db.actor:dont_has_info("random_event_forest_camp") and 
	--	db.actor:dont_has_info("random_event_workshop") then
			self.btn_1:Enable(true)
	--end
	self.btn_2:Enable(true)
end

function comp_interface:InitCallBacks()
	-- тут интерактивные элементы, при определенном действии выполняется заданная ф-ия
	self:AddCallback("btn_1", ui_events.BUTTON_CLICKED,  self.btn1, self)
	self:AddCallback("btn_2", ui_events.BUTTON_CLICKED,  self.btn2, self)
	self:AddCallback("btn_exit", ui_events.BUTTON_CLICKED, self.on_quit, self)
end

function comp_interface:btn1()
	self:HideDialog()
	soundtrack.comp_interface_snd()
	
	xr_effects.disable_ui_only()
	mod_update.rnd_tasks_items_delete()
	db.actor:give_info_portion ("critical_health")
	--db.actor:give_info_portion ("random_events_off")
	start_real_timer(5, "mod_timer_functions.comp_recharge1")
	level.add_pp_effector("fade_in_out.ppe", 1954, false)
	
	xr_effects.delete_maroder_courier()
end

function comp_interface:btn2()
	self:HideDialog()
	soundtrack.comp_interface_snd()
end


