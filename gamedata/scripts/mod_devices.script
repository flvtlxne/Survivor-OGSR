			xr_effects.dec_counter(db.actor, nil, {"generator",1})
		elseif xr_conditions.actor_in_slot_mosin() == true then
			news_manager.send_tip(db.actor, "wpn_cant_be_destroyed_tip", nil, "default", nil, nil)
			soundtrack.no_replics()
		end
	end
end

function mechanical_take_apart:btn_take_all()
	local list = take_apart_all_list()
	if #list == 0 then
		soundtrack.no_replics()
		return
	end

	local sim = alife()
	local count, parts = 0, 0
	for _, item in ipairs(list) do
		local se = sim:object(item:id())
		if se then
			count = count + 1
			parts = parts + take_apart_parts[item:section()]
			sim:release(se, true)
			xr_effects.dec_counter(db.actor, nil, {"generator", 1})
		end
	end
	for i = 1, parts do
		sim:create("weapon_parts", db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
	end
	soundtrack.repair_sounds()

	db.actor:give_game_news(game.translate_string("st_take_apart_all_caption"),
		string.format(game.translate_string("st_take_apart_all_text"), count, parts),
		"ui_iconsTotal_found_thing", 0, 7000, 0)
end

function mechanical_take_apart:on_back()
	self:HideDialog()
	run_gui(mod_devices.mechanical_interface())
end


function mechanical_take_apart:OnKeyboard(dik,keyboard_action)
   CUIScriptWnd.OnKeyboard(self,dik,keyboard_action)
   if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
      if dik == DIK_keys.DIK_ESCAPE then
      self:on_quit()
      end	  
   end
   return true
end

function mechanical_take_apart:on_quit()
	self:HideDialog()
end


-- сборка оружия: --------------------------
class "mechanical_construct" (CUIScriptWnd)
function mechanical_construct:__init(owner) super()
	self.dlg = self
	self.owner = owner
	self:InitControls()
	self:InitCallBacks()
end

function mechanical_construct:__finalize() end

function mechanical_construct:InitControls()
	-- здесь определяем координаты левого верхнего угла и ширину-высоту
	self:SetWndRect(Frect():set(0,0,1024,768))

	-- файл-описатель наших элементов
	local xml = CScriptXmlInit()
	xml:ParseFile("ui_mechanical_construct.xml")

	xml:InitStatic("table", self)
	xml:InitStatic("name", self)
	xml:InitStatic("text1", self)
	
	-- значки "детали есть": создаём сразу, а показываем в refresh_buttons()
	for i = 1, 9 do
		self["ind_" .. i] = xml:InitStatic("indicator" .. i, self)
	end

	-- кнопки
	self.btn_1 = xml:Init3tButton("btn_1", self)
	self:Register(self.btn_1, "btn_1")
	self.btn_1:Enable(false)
	self.btn_2 = xml:Init3tButton("btn_2", self)
	self:Register(self.btn_2, "btn_2")
	self.btn_2:Enable(false)
	self.btn_3 = xml:Init3tButton("btn_3", self)
	self:Register(self.btn_3, "btn_3")
	self.btn_3:Enable(false)
	self.btn_4 = xml:Init3tButton("btn_4", self)
	self:Register(self.btn_4, "btn_4")
	self.btn_4:Enable(false)
	self.btn_5 = xml:Init3tButton("btn_5", self)
	self:Register(self.btn_5, "btn_5")
	self.btn_5:Enable(false)
	self.btn_6 = xml:Init3tButton("btn_6", self)
	self:Register(self.btn_6, "btn_6")
	self.btn_6:Enable(false)
	self.btn_7 = xml:Init3tButton("btn_7", self)
	self:Register(self.btn_7, "btn_7")
	self.btn_7:Enable(false)
	self.btn_8 = xml:Init3tButton("btn_8", self)
	self:Register(self.btn_8, "btn_8")
	self.btn_8:Enable(false)
	self.btn_9 = xml:Init3tButton("btn_9", self)
	self:Register(self.btn_9, "btn_9")
	self.btn_9:Enable(false)

	-- кнопка офф
	self:Register(xml:Init3tButton("btn_exit", self),"btn_exit")
	-- кнопка назад
	self:Register(xml:Init3tButton("btn_back", self),"btn_back")

	self:refresh_buttons()
end

-- Survivor: детали для сборки каждого ствола, по порядку кнопок.
-- У ТОЗ-34 в оригинале проверялись части 1, 3, 3 - теперь 1, 2, 3.
local construct_recipes = {
	{"usp_part1", "usp_part2", "usp_part3", "usp_part4"},
	{"hpsa_part1", "hpsa_part2", "hpsa_part3", "hpsa_part4"},
	{"toz_part1", "toz_part2", "toz_part3"},
	{"aksu_part1", "aksu_part2", "aksu_part3", "aksu_part4", "aksu_part5"},
	{"ak_part1", "ak_part2", "ak_part3", "ak_part4", "aksu_part4"},
	{"trs_part1", "trs_part2", "trs_part3", "trs_part4", "trs_part5"},
	{"vintorez_part1", "vintorez_part2", "vintorez_part3", "vintorez_part4"},
	{"bizon_part_1", "bizon_part_2", "bizon_part_3", "bizon_part_4", "aksu_part4"},
	{"sayga_part_1", "sayga_part_2", "sayga_part_3", "sayga_part_4"},
}

-- Survivor: доступность кнопок и значки деталей пересчитываем каждый кадр.
function mechanical_construct:refresh_buttons()
	for i, parts in ipairs(construct_recipes) do
		local ok = actor_has_all(unpack(parts))
		self["btn_" .. i]:Enable(ok)
		self["ind_" .. i]:Show(ok)
	end
end

function mechanical_construct:Update()
	CUIScriptWnd.Update(self)
	self:refresh_buttons()
end

function mechanical_construct:InitCallBacks()
	-- тут интерактивные элементы, при определенном действии выполняется заданная ф-ия
	self:AddCallback("btn_1", ui_events.BUTTON_CLICKED,  self.btn1, self)
	self:AddCallback("btn_2", ui_events.BUTTON_CLICKED,  self.btn2, self)
	self:AddCallback("btn_3", ui_events.BUTTON_CLICKED,  self.btn3, self)
	self:AddCallback("btn_4", ui_events.BUTTON_CLICKED,  self.btn4, self)
	self:AddCallback("btn_5", ui_events.BUTTON_CLICKED,  self.btn5, self)
	self:AddCallback("btn_6", ui_events.BUTTON_CLICKED,  self.btn6, self)
	self:AddCallback("btn_7", ui_events.BUTTON_CLICKED,  self.btn7, self)
	self:AddCallback("btn_8", ui_events.BUTTON_CLICKED,  self.btn8, self)
	self:AddCallback("btn_9", ui_events.BUTTON_CLICKED,  self.btn9, self)
	self:AddCallback("btn_exit", ui_events.BUTTON_CLICKED, self.on_quit, self)
	self:AddCallback("btn_back", ui_events.BUTTON_CLICKED, self.on_back, self)
end

function mechanical_construct:btn1()
	start_real_timer(2, "mod_timer_functions.mechanical_construction_timer_action")
	soundtrack.repair_sounds()
	mod_functions.remove_items("usp_part1", 1)
	mod_functions.remove_items("usp_part2", 1)
	mod_functions.remove_items("usp_part3", 1)
	mod_functions.remove_items("usp_part4", 1)
	alife():create('wpn_usp', db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
	db.actor:give_info_portion("actor_has_usp")
	xr_effects.dec_counter(db.actor, nil, {"generator",1})
end

