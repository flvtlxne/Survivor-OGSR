function mg_start_interface:btn1()
	self:HideDialog()
	db.actor:set_actor_position(patrol("helicrash_body1_walk"):point(0))
	xr_effects.mg_boxes_random_loot()
	xr_effects.mg_npc_start_spawn()
	xr_effects.mg_cars_start_spawn()
	xr_effects.give_rnd_airdrop_info()
	xr_effects.disable_actor_torch(nil,nil)
	db.actor:give_info_portion("actor_start_move")
	if db.actor:object("af_cristall_mg") ~= nil then
		start_real_timer(2, "xr_effects.spawn_mg_companion_mob")
	end
	if has_alife_info("mg_companion1_help_actor") then
		if db.actor:object("af_soul_mg") == nil then
