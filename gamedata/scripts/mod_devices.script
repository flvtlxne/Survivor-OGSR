class "arthunter_note1" (CUIScriptWnd)
function arthunter_note1:__init(owner) super()
	self.dlg = self
	self.owner = owner
	self:InitControls()
	self:InitCallBacks()
end

function arthunter_note1:__finalize() end

function arthunter_note1:InitControls()
	-- здесь определяем координаты левого верхнего угла и ширину-высоту
	self:SetWndRect(Frect():set(0,0,1024,768))

	-- файл-описатель наших элементов
	local xml = CScriptXmlInit()
	xml:ParseFile("actors_note\\arthunter_note1.xml")

	xml:InitStatic("table", self)
	xml:InitStatic("name", self)
	xml:InitStatic("text1", self)

	-- кнопки
	self.btn_1 = xml:Init3tButton("btn_1", self)
	self:Register(self.btn_1, "btn_1")
	self.btn_1:Enable(false)
	self.btn_2 = xml:Init3tButton("btn_2", self)
	self:Register(self.btn_2, "btn_2")
	self.btn_2:Enable(false)

	-- кнопка офф
	self:Register(xml:Init3tButton("btn_exit", self),"btn_exit")

	-- определяем доступность кнопок
	self.btn_1:Enable(true)
	if has_alife_info("arthunter_note2_info") then
		self.btn_2:Enable(true)
	end

end

function arthunter_note1:InitCallBacks()
	-- тут интерактивные элементы, при определенном действии выполняется заданная ф-ия
	self:AddCallback("btn_1", ui_events.BUTTON_CLICKED,  self.btn1, self)
	self:AddCallback("btn_2", ui_events.BUTTON_CLICKED,  self.btn2, self)
	self:AddCallback("btn_exit", ui_events.BUTTON_CLICKED, self.on_quit, self)
end

function arthunter_note1:btn1()
	self:HideDialog()
	soundtrack.papers_use()
	run_gui(mod_devices.actors_note_start())
end

function arthunter_note1:btn2()
	self:HideDialog()
	soundtrack.papers_use()
	run_gui(mod_devices.arthunter_note2())
end


function arthunter_note1:on_quit()
	self:HideDialog()
end

